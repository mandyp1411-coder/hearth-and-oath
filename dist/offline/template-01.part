  if(kind==='battle')return id==='retreat'?['retreat','prudence']:id==='feral'||id==='skill'&&specialization==='berserker'?['reckless']:id==='inspect'?['prudence','learn']:['capture','hold_back'].includes(id)?['mercy']:[];
