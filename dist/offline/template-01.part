 const current=shown.find(c=>c.current),position=traveller||current,pawn=position?`<g class="paper-player" data-chart-player="${escape(current?.key||state.cartography.position)}" ${destinationMode?'data-op="journey-current"':`data-op="hex-select" data-id="${escape(current.key)}"`} transform="translate(${n(position.x)} ${n(position.y+10)})"><circle r="6" stroke-width=".9"/><path d="M0-4v8m-2.6-5h5.2" fill="none" stroke-width="1.1"/></g>`:'';
