function defaultNamingIdentityV31(seed, id) {
  const ancestries = ['human', 'human', 'human', 'human', 'human', 'elf', 'elf', 'dwarf', 'dwarf', 'halfling', 'halfling', 'orc', 'orc', 'goblin', 'tiefling', 'beastfolk'];
