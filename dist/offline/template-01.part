    if (map.landmarks.length > 100 || !map.landmarks.every(l => l && typeof l.id === 'string' && ['tree', 'peak'].includes(l.type) && [l.x,l.y,l.scale].every(Number.isFinite) && l.scale > 0 && l.scale < 3)) return false;
