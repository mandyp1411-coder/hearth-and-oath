  Object.freeze({ id: 'royal', label: 'Royal blood', weight: 4, means: 'noble', gift: 60, portion: 1500, dues: 0, income: 900, literacy: 100, diet: 3, roof: 3, support: 75, physician: 'household', debt: [0, 0] }),
]);
