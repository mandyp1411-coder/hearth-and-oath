 if(simple)ink=paperRegionBorders(s).map(b=>`<path data-region-border="${escape(b.a+'|'+b.b)}" d="${chartPath(b.points)}"/>`).join('');
 else for(const c of atlas.cells.filter(c=>c.terrain!=='water'))for(const [dq,dr]of [[1,0],[0,1],[-1,1]]){const a=atlas.byKey[`${c.q+dq},${c.r+dr}`];if(!a||a.terrain==='water'||a.regionId===c.regionId)continue;const x=(c.x+a.x)/2,y=(c.y+a.y)/2,dx=(a.y-c.y)/3.46,dy=(a.x-c.x)/3.46;ink+=`<path d="M${n(x-dx)} ${n(y+dy)}L${n(x+dx)} ${n(y-dy)}"/>`;}
 const placed=[...placeLabels],labels=ts.map(t=>{let [x,y]=g.project([t.x,t.y]);const font=simple?atlas.width/1000*19:layout.id==='country'?17:12,name=REGION_TEMPLATES.find(r=>r.id===t.id).name.toUpperCase();y-=38;
  if(simple){const width=textWidth(name,font,true),p=[[0,-45],[0,-100],[0,100],[-110,-50],[110,-50],[0,-170],[0,170]].map(([dx,dy])=>({x:x+dx-width/2,y:y+dy-font,w:width,h:font+8})).find(b=>b.x>24&&b.x+b.w<layout.width-24&&b.y>24&&b.y+b.h<layout.height-72&&placed.every(l=>b.x>=l.x+l.w+8||b.x+b.w<=l.x-8||b.y>=l.y+l.h+10||b.y+b.h<=l.y-10));if(!p)return '';placed.push(p);x=p.x+p.w/2;y=p.y+font;}
  return `<text class="paper-region-title" x="${n(x)}" y="${n(y)}" text-anchor="middle" fill="#676047" stroke="#c6bfa6" stroke-width="2" paint-order="stroke" font-family="Georgia,serif" font-size="${font}" letter-spacing="2">${escape(name)}${simple?'':`<tspan x="${n(x)}" dy="16" font-size="10" letter-spacing="1">${escape(REGIONAL_CULTURES.find(r=>r.id===t.id).government)}</tspan>`}</text>`;
 }).join('');return `<g data-political-borders="" ${simple?`mask="url(#${prefix}-land)"`:''}><g fill="none" stroke="#74694d" stroke-width="1" stroke-dasharray="2 3" opacity=".65">${ink}</g></g>${labels}`;
