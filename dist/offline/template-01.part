 const journeyInk=travelPath?.length>1?`<path data-journey-route="" d="${chartPath(travelPath)}" fill="none" stroke="#655126" stroke-width="2.6" stroke-linecap="round" stroke-dasharray="7 4"/>`:destinationMode?'':plannedInk(state,atlas);
 return `<svg class="paper-map-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="${n(layout.x)} ${n(layout.y)} ${n(layout.width)} ${n(layout.height)}" role="img" aria-label="${escape((revealAll?'Reference: ':'')+layout.name+' — '+state.world.name)}" data-map-art="illustrated-atlas" data-chart-sheet="${escape(layout.id)}"><style>${styles}${destinationMode?`.paper-place-label{font-size:${n(labelScale*10)}px}.paper-place-label.major{font-size:${n(labelScale*11)}px}`:''}</style>${definitions(prefix,state.seed,layout)}<defs><mask id="${prefix}-land" maskUnits="userSpaceOnUse" x="0" y="0" width="${atlas.width}" height="${atlas.height}"><rect width="${atlas.width}" height="${atlas.height}" fill="black"/>${geography.land.map(points=>`<path d="${chartPath(points,true,.1)}" fill="white"/>`).join('')}<path d="${geography.lakePath}" fill="black"/></mask></defs><rect x="${n(layout.x)}" y="${n(layout.y)}" width="${n(layout.width)}" height="${n(layout.height)}" fill="#b5af96"/><g clip-path="url(#${prefix}-field)"><rect class="paper-water" x="0" y="0" width="${atlas.width}" height="${atlas.height}"/><rect width="${atlas.width}" height="${atlas.height}" fill="url(#${prefix}-sea-lines)"/><path class="paper-coast-halo" d="${land} ${geography.lakePath}"/><path class="paper-coast-etch" d="${land} ${geography.lakePath}"/><path class="paper-land" data-chart-coast="" d="${land}" mask="url(#${prefix}-land)"/><path d="${geography.lakePath}" fill="none" stroke="#666956" stroke-width=".9"/><g mask="url(#${prefix}-land)"><path class="paper-woodland" d="${geography.forestPath}"/><path class="paper-highland" d="${geography.mountainPath}"/><path class="paper-wetland" d="${geography.marshPath}"/>${relief}${rivers}${terrainMarks(state,atlas,prefix,known,geography)}</g>${politicalInk(state,atlas,geography,layout,destinationMode,placeLabels,prefix)}${roads(state,atlas,cells,geography)}${journeyInk}${gridLayer}${sites}${next}${selection}${geographicLabels(state,geography,layout,placeLabels,prefix)}${title}${pawn}</g>${parchmentPath?`<image href="${escape(parchmentPath)}" x="${n(layout.x)}" y="${n(layout.y)}" width="${n(layout.width)}" height="${n(layout.height)}" preserveAspectRatio="xMidYMid slice" opacity=".12" style="filter:grayscale(1)" pointer-events="none"/>`:''}<rect x="${n(layout.x)}" y="${n(layout.y)}" width="${n(layout.width)}" height="${n(layout.height)}" fill="url(#${prefix}-grain)" pointer-events="none"/><rect x="${n(layout.x)}" y="${n(layout.y)}" width="${n(layout.width)}" height="${n(layout.height)}" fill="url(#${prefix}-fold)" pointer-events="none"/><rect x="${n(layout.x)}" y="${n(layout.y)}" width="${n(layout.width)}" height="${n(layout.height)}" fill="url(#${prefix}-edge)" pointer-events="none"/>${ornaments(state,layout,atlas,prefix,compact,destinationMode)}<rect x="${n(layout.x+9)}" y="${n(layout.y+9)}" width="${n(layout.width-18)}" height="${n(layout.height-18)}" fill="none" stroke="#665f47" stroke-width=".75"/><rect x="${n(layout.x+12)}" y="${n(layout.y+12)}" width="${n(layout.width-24)}" height="${n(layout.height-24)}" fill="none" stroke="#665f47" stroke-width=".3"/></svg>`;
}

function plannedInk(s,atlas){const r=s.cartography?.route;if(!r)return '';const p=r.keys.slice(r.index).map(k=>[atlas.byKey[k].x,atlas.byKey[k].y]);return `<path data-planned-route="" d="${chartPath(p)}" fill="none" stroke="#77602e" stroke-width="2.2" stroke-dasharray="6 4"/>`;}
/** Exact borders of the saved nearest-anchor territories, independent of the
 * old movement lattice. The shared land mask clips coastlines and lakes. */
function paperRegionBorders(s){
 const ts=s.world.map?.atlas?.territories||[],result=[];
 for(let a=0;a<ts.length;a++)for(let b=a+1;b<ts.length;b++){
  const A=ts[a],B=ts[b],length=Math.hypot(B.x-A.x,B.y-A.y);if(!length)continue;
  const x=(A.x+B.x)/2,y=(A.y+B.y)/2,vx=-(B.y-A.y)/length,vy=(B.x-A.x)/length;let low=-2000,high=2000;
  const clip=(slope,limit)=>{if(Math.abs(slope)<1e-10){if(limit<0)high=low-1;}else if(slope>0)high=Math.min(high,limit/slope);else low=Math.max(low,limit/slope);};
  clip(-vx,x);clip(vx,1000-x);clip(-vy,y);clip(vy,700-y);
  for(const c of ts.filter(c=>c!==A&&c!==B)){const dx=c.x-A.x,dy=c.y-A.y;clip(dx*vx+dy*vy,(c.x*c.x+c.y*c.y-A.x*A.x-A.y*A.y)/2-dx*x-dy*y);}
  if(high-low<1e-6)continue;
  const source=Array.from({length:17},(_,i)=>{const t=low+(high-low)*i/16;return [x+vx*t,y+vy*t];});
  result.push({a:A.id,b:B.id,source,points:source.map(p=>chartProject(s.world,p))});
 }
