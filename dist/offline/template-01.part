    record(s,ctx,'A court’s limited judgment',safe?'The actual record or escape stayed this warrant. The local order retains its observations.':'The region ordered supervision rather than execution. Eight real days passed; hunger and the moon continued.');return true;
  }
  return false;
}
function curseView(s){const c=s.hero.condition;if(!c)return null;const h=c.hunts?.find(h=>h.locationId===s.locationId),line=c.type==='vampire'?bloodLineage(c):null;return {title:line?.name||'The moon inside the body',lore:line?.description||'A fever older than the roads turns the body into a ferocious animal. Shelter protects others; it cannot promise an easy life.',gift:line?.gift||'The uncontrollable beast',weakness:line?.weakness||'Full moons, silver and fear',stage:c.stage||'changed',form:c.form||'human',humanity:c.humanity??null,hunger:c.hunger??null,control:c.control??null,rage:c.rage??null,mastery:c.mastery??0,source:c.source||'An earlier change',law:(curseLawAt(s)?.text||'No regional curse policy is recorded.')+(h?` Local pursuit ${h.heat}/100.`:' No local hunter report.'),mechanics:c.stage==='incubating'?'Bloodline attributes and battle powers wait until the infection changes you. Your actual magic reserve is kept as recorded.':`${Object.entries(curseModifiers(c)).map(([k,v])=>k+' '+(v>=0?'+':'')+v).join(' · ')} before combat training conversion. ${c.type==='vampire'?'Hunger rises '+bloodHungerRate(c)+' per lived day; a full animal meal supplies '+bloodMealRelief(c,'animal',45)+' relief. Outdoor daylight costs 2 combat HP per day; prolonged starvation harms the body and humanity. ':''}Lineage lore adds no separate elemental or silver damage multiplier.`,history:(c.history||[]).slice(-8),actions:curseActions(s)};}
function curseModifiers(c){if(!c||c.stage==='incubating')return {};if(c.type==='vampire'){const feral=(c.humanity??85)<35||c.hunger>=85;return {strength:feral?3:1,presence:feral?-3:c.hunger<50?3:0,agility:2,willpower:c.hunger>=85?-2:1};}return c.form!=='human'?{strength:5,agility:3,intellect:-2,presence:-3}:{strength:1};}
