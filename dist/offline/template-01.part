/** A stable, independent roll. The upper bound is exclusive. */
/** "a"/"an" by the word's first sound; `withArticle('alchemist')` → "an alchemist". */
function withArticle(word){const w=String(word??'').trim();return w?`${/^(?:[aeiou]|hour|heir|honest|honou?r)/i.test(w)?'an':'a'} ${w}`:'';}
function seededRoll(seed, salt, range) {
  const limit = Math.floor(Number(range));
  if (!Number.isFinite(limit) || limit <= 0) return 0;
  const input = `${String(seed ?? 'hearth')}\u001f${String(salt ?? '')}`;
  let hash = 2166136261;
