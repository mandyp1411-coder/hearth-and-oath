  const requestedAncestry = options.ancestry || options.appearance?.ancestry || defaults.ancestry;
  const ancestry = NAME_CULTURES_V31[requestedAncestry] ? requestedAncestry : 'human';
  const base = NAME_CULTURES_V31[ancestry];
