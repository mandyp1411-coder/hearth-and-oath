}
function politicalActionRoom(s,id){if(id==='polity_festival'||id==='polity_custom'||id.startsWith('polity_war_accept_')||id.startsWith('polity_war_witness_')||id.startsWith('polity_war_relief_'))return ['watch','court'];if(/^polity_war_(terms|settle)_/.test(id))return ['court'];if(id.startsWith('polity_hold_witness_'))return ['archive'];if(id.startsWith('polity_hold_fight_'))return ['stronghold'];return ['watch'];}
