      } else if (cared) {
        supported += 1;
        const canRecover = ageOfCondition >= (condition.type === 'depression' ? 35 : 21) && (state.life?.happiness ?? 0) >= 40 && (state.life?.stress ?? 100) <= 65;
        if (canRecover) condition.severity -= 1;
