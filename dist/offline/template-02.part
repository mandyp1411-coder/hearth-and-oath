  budget_repay: ['Pay down what you owe', 'Hand the lender what you can. Interest stops on what is paid.'],
  budget_lifestyle_frugal: ['Live frugally', 'Thin soup, patched clothes, a roof.'],
  budget_lifestyle_comfortable: ['Live comfortably', 'Meat some days, a second shirt, a fire in the evening.'],
  budget_lifestyle_generous: ['Live generously', 'Guests, wine, and a name for both.'],
  budget_focus_livelihood: ['Put the work first', 'The year goes to earning.'],
  budget_focus_family: ['Put the family first', 'The year goes to the people at home.'],
  budget_focus_education: ['Put learning first', 'The year goes to books, and costs more for it.'],
  budget_focus_adventure: ['Put the road first', 'The year goes to going.'],
  budget_focus_balanced: ['Keep a balance', 'A little of everything, and not much of anything.'],
  nature_reckoning: ['An uneasy word', 'An old grievance wants an answer.'],
  work: ['Work for the day', 'Three days of whatever pays.'],
  rest: ['Rest at a hearth', 'Two days, and a few coins for the fire.'],
  study: ['Study with a teacher', 'Five days and twelve gold. Letters do not come free.'],
  train: ['Train', 'Three days of bruises.'],
  choose_profession: ['Find an apprenticeship', 'Two days of asking who needs hands.'],
};
const PATTERNS = [
  [/^atlas_room_(.+)$/, (s, a, m) => [after(a.label, 'Enter ') || a.label, 'Walk there. It costs no days.']],
  [/^talk_(.+)$/, (s, a) => [a.label, 'A few words. What you say will be remembered.']],
  [/^grow_family$/, (s, a) => [a.label.replace(/^Make time for /, 'Time with '), 'The people who are raising you, such as they are.']],
  [/^family_time_(.+)$/, (s, a) => [a.label.replace(/^(Spend time with|Make room for care with|Visit) /, 'Time with ').replace(/ at their home$/, ''), 'Whatever they have time for.']],
  [/^social_join_/, (s, a) => [a.label, 'There is an empty place beside them.']],
  [/^social_reconcile_/, (s, a) => [a.label.replace(/^Talk with /, 'Hear out '), 'Two people who are not speaking, and you between them.']],
  [/^social_introduce_/, (s, a) => [a.label.replace(/^Spend time with /, 'Bring together '), 'An ordinary afternoon that might start something.']],
  [/^misdeed_prank_/, (s, a) => [a.label.replace(/^Pull a Prank — /, 'A prank on '), 'A joke at their expense. They may not laugh.']],
  [/^career_choose_(?!unemployed)/, (s, a) => [a.label.replace(/^(Become|Train as|Apprentice as) /, 'Apprentice as '), 'Years of someone else’s orders, and a trade at the end of them.']],
  [/^school_enroll_/, (s, a) => [a.label.replace(/^Enroll at /, 'Enrol at ').replace(/^Transfer to /, 'Move to '), 'If they will take you.']],
  [/^school_project_/, (s, a) => [a.label, 'Supervised work with the school’s tools, and a result that is kept.']],
  [/^school_elective_/, (s, a) => [a.label, a.description.split(' Four lessons')[0]]],
  [/^school_sit_/, (s, a) => [a.label.replace(/^Sit the entrance examination of /, 'Sit the entrance of '), 'Once a year, before three examiners. The fee for the sitting is not returned.']],
  [/^school_place_/, (s, a) => [a.label.replace(/^Sit for the one free place at /, 'Sit for the free place at '), 'One place a year for someone who cannot pay. Everyone who cannot pay sits for it.']],
  [/^school_read_/, (s, a) => [a.label.replace(/^Be read into /, 'Be read into '), a.description.split('. ').slice(-1)[0]]],
  [/^lineage_continue_/, (s, a) => [a.label, 'The next volume.']],
];

/** The voiced action: a short situation to read, the engine's figures kept as detail. */
function voiceAction(s, a) {
  if (!a || !edition(s)) return a;
  const exact = EXACT[a.id];
  let line = exact ? exact : null;
  if (!line) for (const [re, fn] of PATTERNS) { const m = a.id.match(re); if (m) { line = fn(s, a, m); break; } }
  if (!line) return a;
  const [label, description] = line;
  return { ...a, label: label || a.label, description, detail: a.description };
}
function voiceActions(s, actions) { return edition(s) ? actions.map(a => voiceAction(s, a)) : actions; }

// Events: the same treatment for the moments every life meets. The choice ids
// and effects are the engine's; only the words change.
const CONDITION = { fever: 'A fever', infection: 'A wound gone bad', injury: 'An injury', chronic: 'The old complaint', distress: 'A black mood', anxiety: 'A dread that will not settle', depression: 'A weight that does not lift' };
function voiceHealth(s, ev) {
  const pending = s.health?.pending, condition = pending && [...(s.health.physical || []), ...(s.health.mental || [])].find(c => c.id === pending.conditionId);
  if (!condition) return ev;
  const name = CONDITION[condition.type] || 'A sickness', bad = condition.severity >= 3 ? ' It is as bad as it gets.' : condition.severity === 2 ? ' It is getting worse.' : '';
  const where = condition.circumstance === 'winter' ? ' It came with the winter, in a house with little to fight it with.' : condition.circumstance === 'outdoors' ? ' You caught it on the road.' : condition.circumstance === 'stress' ? ' The strain brought it on.' : '';
  const body = s.age < 3 ? `${name.toLowerCase()} in the cradle. The adults sit up with you.` : `${name}.${bad}${where}${condition.careUntil > s.day ? ' You are being seen to.' : ' Nobody has seen to it yet.'}`;
  const words = {
    rest: ['Take to bed', 'Three days. The body does most of the work.'],
    care: ['Send for the healer', s.age < 18 ? 'Two days. The house pays, if it can.' : `Two days, and the healer’s fee.`],
    support: ['Find someone to sit with you', 'Two days with someone who will listen.'],
    routine: ['Mind yourself', 'Three days of meals, sleep, and walking.'],
    continue: ['Carry on', 'Name it and keep working. It will not thank you.'],
  };
  return { ...ev, title: s.age < 3 ? 'A sickness in the cradle' : pending.kind === 'mental' ? 'The mind' : 'The body', category: pending.kind === 'mental' ? 'The mind' : 'The body', body, choices: ev.choices.map(c => words[c.id] ? { ...c, label: words[c.id][0], description: words[c.id][1], detail: c.description } : c) };
}
function voiceDeadline(s, ev) {
  const o = s.obligations.find(o => !o.resolved && ev.body.includes(o.title));
  const days = o ? Math.max(0, o.dueDay - s.day) : null;
  return { ...ev, title: 'A promise coming due', category: 'A promise', body: `${o ? `“${o.title}” is due${days === 0 ? ' today' : days === 1 ? ' tomorrow' : ` in ${days} days`}. ${o.description || ''}` : ev.body} The year stops here until you say otherwise.`,
    choices: ev.choices.map(c => c.id === 'pause' ? { ...c, label: 'Keep the promise', description: 'Stop the year and see to it.', detail: c.description } : c.id === 'continue' ? { ...c, label: 'Let it go', description: 'Keep the year moving and take what comes of a promise broken.', detail: c.description } : c) };
}
const FAMILY = {
  'A little space beside the hearth': ['Beside the hearth', 'The house settles for the evening. There is room beside the fire for a small person.', { help: ['The story', 'The one you know by heart.'], ask: ['A lap', 'Warm, and not going anywhere.'], boundary: ['A quiet corner', 'Yours, for a little while.'] }],
  'The work that keeps a roof above you': ['The work that keeps the roof on', null, { help: ['Take a share of it', 'Chores a child can do, and a house that notices.'], ask: ['Ask for time for lessons', 'The work is there either way. So is the learning, if you ask.'], boundary: ['Ask a neighbour to share the load', 'Someone owes the house a favour.'] }],
  'A familiar voice, with help nearby': ['A familiar voice', null, { help: ['Stay close', 'The care that is there, taken.'], ask: ['Bring a story into it', 'Learning that does not need a school.'], boundary: ['Let the neighbours in', 'Other hands, other voices.'] }],
  'A sibling’s own plan': ['A sibling’s plan', null, { help: ['Speak for them', 'They want to be heard, not decided for.'], ask: ['Ask what they hope for', 'And listen to the answer.'], boundary: ['Back them, without promising', 'You cannot fix it. You can stand beside it.'] }],
  'The person who once carried you': ['The one who carried you', null, { help: ['Arrange help, with their say-so', 'Practical, and theirs to refuse.'], ask: ['Ask what they want changed', 'Not what you think they need.'], boundary: ['Share it with the others', 'You are not the only one who owes them.'] }],
};
function voiceFamily(s, ev) {
  const row = FAMILY[ev.title]; if (!row) return ev;
  const [title, body, choices] = row, carer = s.life?.people.find(p => p.id === 'kin' && p.alive !== false)?.name;
  return { ...ev, title, category: 'At home', body: body || ev.body.replace(/\s*(This does not invent|No wages or materials|accepting help need not)[^.]*\./g, ''), choices: ev.choices.map(c => choices[c.id] ? { ...c, label: choices[c.id][0], description: choices[c.id][1], detail: c.description } : c) };
}
const SCHOOL = {
  'The answer left on the teacher’s table': ['The answers on the table', 'Tomorrow’s answers, left where a frightened classmate found them. The teacher would help anyone who asked. Asking means admitting you need it.', { help: ['Ask for help', 'And let the teacher see you do not know.'], ask: ['Teach what you know', 'To the one who is frightened. It is not everything.'], boundary: ['Leave the answers where they are', 'And say nothing about who found them.'] }],
  'Two names on the lesson project': ['Two names, one label', null, { help: ['Both names', 'It was both of you.'], ask: ['Say who did what', 'Exactly, and let the patron make of it what he will.'], boundary: ['Refuse the praise', 'Until the label is right.'] }],
  'Whose memory belongs in the lesson?': ['A lesson with the dead', null, { help: ['Ask the dead first', 'Nothing is done without their leave.'], ask: ['Read the law', 'What is written, against what is wanted.'], boundary: ['Keep it on the page', 'No rite. Not today.'] }],
  'The lesson outside the classroom': ['The hum under the garden', null, { help: ['Mark the roots', 'And keep the spades off them.'], ask: ['Find the old account', 'Someone wrote about this once.'], boundary: ['Watch and write', 'Touch nothing you do not understand.'] }],
  'A seat for someone without tuition': ['A seat without a fee', null, { help: ['Share the books', 'Without taking over.'], ask: ['Ask for a fair timetable', 'So nobody’s lessons are the price.'], boundary: ['Offer what you can keep up', 'And no more than that.'] }],
};
function voiceSchool(s, ev) {
  const row = SCHOOL[ev.title]; if (!row) return ev;
  const [title, body, choices] = row;
  return { ...ev, title, category: 'At school', body: body || ev.body, choices: ev.choices.map(c => choices[c.id] ? { ...c, label: choices[c.id][0], description: choices[c.id][1], detail: c.description } : c) };
}
function voiceEvent(s, ev) {
  if (!ev || !edition(s)) return ev;
  if (ev.id === 'birth_year_16') return farmerOpeningEvent(s, ev);
  if (ev.id === 'health_concern') return voiceHealth(s, ev);
  if (ev.id === 'annual_deadline_review') return voiceDeadline(s, ev);
  if (ev.id === 'family_dilemma') return voiceFamily(s, ev);
  if (ev.id === 'school_dilemma') return voiceSchool(s, ev);
  return ev;
}

// The book. Each age band is a chapter; the journal reads under its heading.
const CHAPTERS = Object.freeze([
  [0, 'The cradle'], [6, 'The yard'], [13, 'The threshold'], [18, 'The road'], [30, 'The work'], [45, 'The weight'], [60, 'The long evening'],
]);
function chapterOf(age) { let found = CHAPTERS[0]; for (const row of CHAPTERS) if (age >= row[0]) found = row; return { number: CHAPTERS.indexOf(found) + 1, title: found[1], from: found[0] }; }
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
function chapterHeading(age) { const c = chapterOf(age); return `Chapter ${ROMAN[c.number - 1]} · ${c.title}`; }

/** The epitaph judges the life against what it set out to do, in a line.
 * "Ishkaren Javulessa, smith of Iron Hold. He never saw the sea." */
function epitaph(s, reason = '') {
  const h = s.hero, name = h.name, pronoun = h.pronouns === 'she/her' ? 'She' : h.pronouns === 'he/him' ? 'He' : 'They', were = pronoun === 'They' ? 'were' : 'was';
  const home = s.world?.locations.find(p => p.id === (s.life?.home?.locationId || h.birthplaceId))?.name || s.world?.locations.find(p => p.id === h.birthplaceId)?.name || 'nowhere in particular';
  const trade = h.profession && h.profession !== 'Unemployed' ? h.profession.toLowerCase() : null;
  const who = `${name}, ${trade ? `${trade} of ${home}` : s.age < 18 ? `child of ${home}` : `of ${home}`}.`;
  const children = (s.life?.children || []), buried = children.filter(c => c.alive === false).length, raised = children.length - buried;
  const far = Object.values(s.cartography?.sites || {}).filter(r => r?.kind === 'Visited').length;
  const debt = s.householdBudget?.debt || 0, lender = h.station?.ties?.find(t => t.kind === 'owes')?.name;
  const cause = s.health?.deathCause || reason || '';
  const lines = [];
  if (s.age < 6) lines.push(`${pronoun} did not see the thaw.`);
  else if (s.age < 18) lines.push(`${pronoun} ${were} ${s.age}. The book is short.`);
  if (/winter fever/i.test(cause) && s.age >= 6) lines.push(`The winter took ${pronoun.toLowerCase() === 'they' ? 'them' : pronoun === 'He' ? 'him' : 'her'}.`);
  if (/left untreated/i.test(cause)) lines.push(`${pronoun} would not be seen to, and it ran its course.`);
  if (debt > 0) lines.push(`${pronoun} died owing ${lender ? lender : 'the lender'}.`);
  if (s.householdBudget?.fledDebt) lines.push(`${pronoun} left a debt and a name behind in another town.`);
  if (raised || buried) lines.push(`${pronoun} raised ${raised || 'no'} child${raised === 1 ? '' : 'ren'}${buried ? ` and buried ${buried}` : ''}.`);
  if (s.age >= 18 && far <= 1) lines.push(`${pronoun} never went further than ${home}.`);
  else if (far >= 8) lines.push(`${pronoun} saw more of the world than most.`);
  if (h.marks?.some(m => m.id === 'drinker')) lines.push(`Drink had the last years.`);
  if (h.marks?.some(m => m.id === 'devout')) lines.push(`${pronoun} kept the faith to the end.`);
  if (s.age >= 80) lines.push(`${pronoun} ${were} old, which is rarer than it sounds.`);
  if (!lines.length) lines.push(reason === 'retirement' ? `${pronoun} put the work down while ${pronoun === 'They' ? 'they' : pronoun.toLowerCase()} still could.` : `${pronoun} ${were} ${s.age}. It was a life.`);
  return `${who} ${lines.slice(0, 2).join(' ')}`;
}
function validateEpitaph(v) { return v === undefined || (typeof v === 'string' && v.length > 0 && v.length <= 400); }

// Right now: the three to five things that matter today, written as
// situations, chosen from what the engine already offers. The full menu
// stays beneath; this is the page you read first.
function whatMatters(s, actions) {
  if (!edition(s) || !Array.isArray(actions) || s.event || s.battle) return [];
  const open = id => actions.find(a => (typeof id === 'string' ? a.id === id : id.test(a.id)) && !a.disabledReason);
  let services = null; const roomFor = kind => { services ||= (() => { try { return settlementServices(s); } catch { return []; } })(); const row = services.find(r => r.kind === kind); return row ? open('atlas_room_' + row.roomId) : null; };
  const rows = [], take = (a, why) => { if (a && !rows.some(r => r.id === a.id) && rows.length < 5) rows.push({ ...a, why }); };
  const b = s.householdBudget || {}, life = s.life || {}, health = s.health || {};
  const sick = (health.physical || []).find(c => c.careUntil <= s.day), low = (health.mental || []).find(c => c.careUntil <= s.day);
  if (sick) take(open('health_rest'), `${sick.severity >= 2 ? 'You are getting worse' : 'You are not well'}, and nobody has seen to it.`);
  if (low) take(open('health_support'), 'The mind is not right, and it will not mend alone.');
  if ((b.debt || 0) > 0 && s.hero.gold >= 20) take(open('budget_repay'), `You owe ${b.debt} gold and the interest is running.`);
  if ((b.bondedUntil || 0) > s.day) take(open('career_work'), 'Your days belong to the creditor until the bond is worked off.');
  if (s.age >= 18 && s.hero.profession !== 'Unemployed') take(open('career_work') || roomFor('work'), s.hero.gold < 40 ? `${s.hero.gold} gold in your purse. The work is there.` : 'The work is there.');
  if (s.age >= 16 && s.hero.profession === 'Unemployed') take(open(/^career_choose_(?!unemployed)/) || open('choose_profession') || roomFor('work'), 'You have no trade. Someone needs hands.');
  const k = schooling(s);
  if (k && s.age >= 12 && s.age < 18 && s.education?.enrolled && electiveOffer(s)) take(open(/^school_elective_/), 'The master wants to know what you will study this year.');
  if (k && s.age >= 12 && s.age <= 15 && k.scholarship === null) take(open('school_scholarship'), 'Three places at the grammar school, and one sitting in a life.');
  if (k && s.age >= 12 && s.age < 18 && k.literate && k.entrance.academy !== 'passed' && k.entrance.academyYear !== s.age) take(open('school_entrance'), 'The grammar school examines at its door, once a year.');
  if (s.age >= 6 && s.age < 18 && s.education?.enrolled) { const fee = k ? tuitionDue(s, s.education.route) : 0; take(open('school_attend') || roomFor('school'), fee ? `The schoolmaster wants his ${fee} gold before the first lesson of the year.` : 'There is a lesson, and you are not at it.'); }
  if (k && s.age >= 6 && s.age < 18 && !s.education?.enrolled && k.shrinePlace === false && s.hero.gold < tuitionDue(s, 'community') && s.hero.station?.freedom !== 'owned') take(open('school_enroll_apprenticeship') || open('grow_read') || open('grow_survival') || open('grow_play'), 'The keeper has his pupil and the schoolmaster wants his fee. No school this year.');
  if (s.age >= 6 && s.age < 18 && !s.education?.enrolled && (s.hero.station?.id !== 'bound' || s.family?.literate) && s.hero.station?.freedom !== 'owned') take(open('school_enroll_shrine') || open('school_enroll_community') || open('school_enroll_apprenticeship') || roomFor('school'), 'No school yet. Some doors are still open.');
  if (k && s.age >= 18 && !isLiterate(s) && s.hero.gold >= 3) take(open('school_letters') || roomFor('school'), 'You cannot read. The archivist teaches grown people, for a little.');
  if (k?.institution && !k.institution.degree) { const fee = institutionYearDue(s); take(open('school_degree') || open('school_lecture'), open('school_degree') ? 'The examiners sit this year. Three years of your life on the table.' : fee ? `The bursar wants ${fee} gold before the year’s first lecture.` : 'There are lectures you have not heard.'); }
  if (k?.bond && !k.bond.broken && !k.bond.done) take(open('school_attend'), `${k.bond.master}’s bench, and ${Math.max(1, Math.ceil((k.bond.until - s.day) / 365))} more year${Math.ceil((k.bond.until - s.day) / 365) === 1 ? '' : 's'} of the bond.`);
  const gm = guildMember(s);
  if (gm?.dues.arrears >= 2) take(open('guild_dues'), `${gm.dues.arrears} seasons of dues owed to the hall. At four the name comes off the rolls.`);
  if (gm?.assignment && !gm.assignment.done) take(open('guild_assignment'), 'The hall has given you its work for the year, and the warden keeps a book.');
  if (gm?.rank === 'journeyman' && gm.wander.done) take(open('guild_masterpiece'), 'The road years are served. The wardens will look at a masterpiece.');
  if (!gm && s.guild && s.age >= 16) take(open('guild_join'), 'The hall has a place for your name, if you take up the trade.');
  if (!gm && s.guild && s.age >= 18 && s.hero.gold >= BUY_IN * 2) take(open('guild_buy_in'), `The hall sells places at ${BUY_IN} gold, to those whose work it has seen.`);
  for (const i of activeInjuries(s).filter(i => !i.treated && !i.permanent && i.id !== 'bruised')) take(open('battlecraft_treat_' + i.id) || open('health_rest'), `${INJURIES[i.id].name}, untended. A healer would set it; left alone it goes bad.`);
  for (const c of (s.companions || []).filter(c => c.recruited && c.alive !== false && loyaltyOf(c) < 30)) take(open(/^talk_/), `${c.name} has had about enough of this.`);
  if (s.battlecraft && s.hero.specialization && s.age >= 18) take(open(/^battlecraft_learn_/), 'There is more to your calling than you know yet.');
  for (const row of faithRightNow(s)) take(open(row.id), row.text);
  if (!cloth(s) && s.faith && s.realm?.faithId && s.age >= 16 && (s.hero.skills?.devotion || 0) >= 3) take(open('faith_novice'), 'The house would take you, if you asked at the shrine.');
  if (k && s.age >= 16 && s.age <= 30 && !k.institution) take(open(/^school_read_/) || open(/^school_sit_/), open(/^school_read_/) ? 'An institution will have you, if the fee is found.' : 'The capitals examine at their doors. You hold the certificate they ask for.');
  if (s.age >= 6 && s.age < 18 && !s.education?.enrolled && (s.hero.station?.freedom === 'owned' || s.hero.station?.id === 'bound' && !s.family?.literate)) take(open('grow_survival') || open('grow_play') || open(/^upbringing_(practice|discovery)$/), 'No school for the likes of you. The woods and the field, then.');
  if ((life.stress || 0) >= 60 || (life.health ?? 80) < 50) take(open('life_rest') || open('health_routine'), (life.stress || 0) >= 60 ? 'Your hands shake. A week of nothing would help.' : 'You are worn thin.');
  if (s.family && s.family.support < 40 && s.age < 18) take(open('family_support') || open(/^family_time_/), 'The house is cold toward you. Say what you need.');
  if ((life.happiness ?? 60) < 35) take(open('social_gather') || open('pastime_interest') || open(/^leisure_/), 'There has been no joy in a long while.');
  if (rows.length < 3) take(open(/^talk_/), 'Someone you know is within earshot.');
  if (rows.length < 3) take(open('social_gather') || open('pastime_interest') || open(/^leisure_/) || open('grow_play'), 'An afternoon with nothing owed on it.');
  if (rows.length < 3 && s.age >= 18) take(open(/^life_home_/), 'A roof of your own is for sale.');
  return rows.slice(0, 5);
}

return {CHAPTERS,chapterHeading,chapterOf,epitaph,validateEpitaph,voiceAction,voiceActions,voiceEvent,whatMatters};
})();
const __journal_history = (() => {
const { undertakingStatusLabel } = __undertaking_contract;
/** Captured history is displayed, never replayed or regenerated from today's state. */
function renderStoryDecisions(arc,ui){
  const {e,date}=ui;
  if(!arc.choices?.length)return '';
  return `<details class="story-decisions" data-story-record="${e(arc.id)}"><summary>Decisions &amp; consequences · ${arc.choices.length}</summary><ol class="decision-trail">${arc.choices.map((c,i)=>`<li data-story-decision="${i+1}"><h4>Chapter ${i+1}: ${e(c.label||'Earlier decision')}</h4><p>${e(c.outcome||'The detailed outcome was not recorded.')}</p><small>${Number.isSafeInteger(c.day)?e(date(c.day)):'Date unrecorded'}${Number.isSafeInteger(c.days)?' · '+c.days+' attended days':''}${Number.isSafeInteger(c.cost)?' · '+c.cost+' Gold fee':''}${Number.isSafeInteger(c.reward)?' · '+c.reward+' Gold proceeds':''}</small></li>`).join('')}</ol></details>`;
}
function renderClosingAccounts(s,ui){
  const r=s.questLog?.closingReview;if(!r)return '';
  const {e,date}=ui;
  return `<section class="panel" data-closing-quest-record><h2>${e(r.heroName)}’s closing account</h2><p>${e(date(r.day))} · ${r.decision==='leave_at_retirement'?'Chosen at retirement':'This life ended'}</p><p>${r.counts.completed} completed · ${r.counts.abandoned} abandoned · ${r.counts.failed||0} failed · ${r.counts.paused} paused · ${r.counts.neverAccepted} offers not accepted.</p>${r.unfinished.length?`<h3>Left unfinished</h3>${r.unfinished.map(q=>`<article class="remembered-entry"><h4>${e(q.title)}</h4><span class="badge">${undertakingStatusLabel(q.status)}</span><p>${e(q.detail)}</p></article>`).join('')}`:'<p>No accepted undertaking was left unfinished.</p>'}</section>`;
}

/** Saved contract terms and proof survive board refresh; rendering grants nothing. */
function renderContractReceipt(record,ui){
  const {e}=ui;
  return `<details class="panel" data-contract-record="${e(record.id)}"><summary>${e(record.title)} · ${e(undertakingStatusLabel(record.result))} · ${e(record.client)}</summary><p>${e(record.objective)}</p><p>${e(record.boardName)} → ${e(record.destinationName)}</p><p class="small-copy">${record.closedDay===null?'Closing date was not recorded in this older save':'Closed on world day '+record.closedDay} · ${record.reward} Gold paid</p>${record.proof?`<p>Earned ${record.proof.method?'field-work':'combat'} proof on world day ${record.proof.day}${record.proof.captured?' · living captive presented':''}.</p>`:'<p>No completion proof or reward was claimed.</p>'}${record.attempts.map(a=>`<p class="small-copy">World day ${a.day}: ${a.outcome==='defeat'?'Failed combat attempt':a.outcome==='retreat'?'Withdrew from the encounter':'Encounter won'}.</p>`).join('')}</details>`;
}

return {renderClosingAccounts,renderContractReceipt,renderStoryDecisions};
})();
const __journal_pagination = (() => {
// Navigation is transient UI state, never a property of the saved game.
function journalPage(rows, requested = 0, size = 30) {
  const pages = Math.max(1, Math.ceil(rows.length / size));
  const page = Math.min(pages - 1, Math.max(0, Number.isSafeInteger(requested) ? requested : 0));
  const start = page * size;
  return { rows: rows.slice(start, start + size), page, pages, total: rows.length, start: rows.length ? start + 1 : 0, end: Math.min(start + size, rows.length) };
}
function renderJournalPager(view, kind, label, ui, { total = view.total, query = '' } = {}) {
  const { e, button } = ui;
  return `<div class="journal-paging" data-journal-paging="${e(kind)}"><p id="journal-${e(kind)}-results" tabindex="-1" data-view-results>${e(label)}: ${view.total ? `${view.start}–${view.end} of ${view.total}` : '0'}${query ? ` matching / ${total} saved` : ' saved'}${view.pages > 1 ? ` · Page ${view.page + 1} of ${view.pages}` : ''}.</p>${view.pages > 1 ? `<nav class="quick-actions" aria-label="${e(label)} pages">${button('First', 'journal-page', kind + ':0', 'ghost small', view.page === 0)}${button('Previous', 'journal-page', kind + ':' + (view.page - 1), 'secondary small', view.page === 0)}${button('Next', 'journal-page', kind + ':' + (view.page + 1), 'secondary small', view.page === view.pages - 1)}${button('Last', 'journal-page', kind + ':' + (view.pages - 1), 'ghost small', view.page === view.pages - 1)}</nav>` : ''}</div>`;
}

return {journalPage,renderJournalPager};
})();
const __personal_notes_ui = (() => {
const { personalNoteRows, PERSONAL_NOTE_LIMIT } = __personal_notes;
const { journalPage, renderJournalPager } = __journal_pagination;
function renderPersonalNotes(s, ui, { query = '', page = 0, archived = false, scope = archived ? 'archived' : 'current', draft = { text: '', saving: false, error: '' } } = {}) {
  const { e, button, paragraphs, date } = ui, all = personalNoteRows(s), own = all.filter(n => n.own), activeCount = own.filter(n => !n.archived).length, archivedCount = own.length - activeCount, familyCount = all.length - own.length;
  const scoped = all.filter(n => scope === 'family' ? !n.own : n.own && n.archived === (scope === 'archived')), matched = scoped.filter(n => !query || [n.text, n.ownerName, n.generation ? 'Generation ' + n.generation : ''].join(' ').toLowerCase().includes(query.toLowerCase())), view = journalPage(matched.slice().reverse(), page, 20);
  return `<section class="personal-notes" aria-labelledby="personal-notes-heading"><h2 id="personal-notes-heading" tabindex="-1">Personal Notes</h2><p>Only your own reminders can be changed. Earned events and discoveries stay as recorded. Archived notes can be restored; nothing is deleted.</p><div class="quick-actions">${button(`Current personal notes (${activeCount})`, 'personal-notes-scope', 'current', 'secondary small', false, scope === 'current')}${button(`Archived personal notes (${archivedCount})`, 'personal-notes-scope', 'archived', 'secondary small', false, scope === 'archived')}${button(`Family records (${familyCount})`, 'personal-notes-scope', 'family', 'secondary small', false, scope === 'family')}</div>${renderJournalPager(view, 'personal', scope === 'family' ? 'Family personal-note records' : scope === 'archived' ? 'Archived personal notes' : 'Current personal notes', ui, { total: scoped.length, query })}${view.rows.map(n => `<article class="remembered-entry personal-note" data-personal-note="${e(n.key)}"><small>${e(date(n.day))} · ${e(n.ownerName)}${n.generation ? ` · Generation ${n.generation}` : ' · Ownership not recorded'}</small><h3>${n.own ? 'Your Note' : 'Family Note'}${n.archived ? ' · Archived' : ''}</h3><div class="personal-note-text" data-verbatim><p>${e(n.text)}</p></div>${n.own ? `<div class="quick-actions">${!n.archived ? button('Edit note', 'personal-note-edit', n.key, 'secondary small') : ''}${button(n.archived ? 'Restore note' : 'Archive note', 'personal-note-archive', n.key, 'ghost small')}</div>` : '<p class="small-copy">Read-only family record. An heir cannot change an earlier life’s note. Unattributed legacy notes stay read-only when their generation is uncertain.</p>'}</article>`).join('') || `<p>${query ? 'No personal notes match this search in this view.' : scope === 'family' ? 'No earlier family notes have been recorded.' : scope === 'archived' ? 'No personal notes are archived.' : 'No current personal notes have been kept.'}</p>`}<p class="small-copy">${own.length} / ${PERSONAL_NOTE_LIMIT} notes kept by this life, including its archive. Earlier lives and unattributed legacy notes are kept separately under Family records.</p>${scope === 'current' ? `<form id="player-note" aria-busy="${Boolean(draft.saving)}"><label for="note-text">Write a Note</label><p id="note-draft-help" class="small-copy">Your draft stays with this life while this page is open. Keep Note to save it before reloading or closing the page.</p><textarea id="note-text" name="note" maxlength="2000" rows="4" required aria-describedby="note-draft-help note-draft-status" placeholder="A name, a destination, something to remember…"${(own.length >= PERSONAL_NOTE_LIMIT && !draft.receipt) || draft.saving ? ' disabled' : ''}>${e(draft.text)}</textarea><p id="note-draft-status" class="small-copy" role="status">${e(draft.error || (draft.saving ? 'Saving your note…' : draft.text ? 'Unsubmitted draft. Navigation does not save it.' : ''))}</p><div class="personal-note-actions"><button type="submit" class="button secondary" ${(own.length >= PERSONAL_NOTE_LIMIT && !draft.receipt) || draft.saving ? 'disabled' : ''}>${draft.saving ? 'Saving Note…' : draft.receipt ? 'Retry Saving Note' : 'Keep Note'}</button>${button('Discard Draft', 'personal-note-discard', '', 'ghost', draft.saving || !draft.text)}${button('Return to Discoveries', 'personal-note-back', '', 'ghost')}</div></form>` : ''}</section>`;
}
function renderPersonalNoteReview(pending, ui) {
  if (!pending) return '';
  const { e, button, paragraphs, date } = ui, n = pending.note, editing = pending.mode === 'edit';
  const body = editing ? `<h2 id="personal-note-review-title">Edit your note</h2><p>${e(date(n.day))}. The original date stays unchanged. Only this personal note will change.</p><form id="personal-note-edit-form"><label for="personal-note-text">Your note</label><textarea id="personal-note-text" name="note" maxlength="2000" rows="7" required>${e(n.text)}</textarea><div class="modal-buttons"><button type="submit" class="button primary">Save note</button>${button('Cancel', 'close-modal', '', 'ghost')}</div></form>` : `<h2 id="personal-note-review-title">${n.archived ? 'Restore' : 'Archive'} your note?</h2><p>${n.archived ? 'This puts the note back with your current personal notes.' : 'This moves the note to Archived personal notes. You can restore it there at any time; its text and date are kept.'}</p><div class="personal-note-text" data-verbatim><small>${e(date(n.day))}</small><p>${e(n.text)}</p></div><div class="modal-buttons">${button(n.archived ? 'Restore note' : 'Archive note', 'personal-note-confirm', '', 'primary')}${button('Cancel', 'close-modal', '', 'ghost')}</div>`;
  return `<div class="modal-overlay"><section class="modal personal-note-dialog" role="dialog" aria-modal="true" aria-labelledby="personal-note-review-title"><button class="modal-close button ghost" type="button" data-op="close-modal" aria-label="Cancel note changes">×</button>${body}</section></div>`;
}

return {renderPersonalNoteReview,renderPersonalNotes};
})();
const __research_ui = (() => {
const { researchDefinition, researchSource, researchInterpretation } = __research_definitions;
const { researchOwnerId } = __research_portfolio;
function sourceCards(s, run, ui) {
  const { e } = ui;
  return researchDefinition(run.definitionId).sources.filter(source => run.evidence.some(entry => entry.id === `source-${source.id}`)).map(source => {
    const copy = run.copies.find(copy => copy.sourceId === source.id), proof = run.evidence.find(entry => entry.id === `source-${source.id}`);
    const custodian = copy && (copy.sourceRevision === 0 ? run.cast.archivist : run.custody[copy.sourceRevision - 1].to);
    const provenance = copy ? `Requested day ${copy.requestedDay}; new local copy prepared day ${copy.preparedDay}, received day ${copy.receivedDay}. Original collection: ${s.world.locations.find(place => place.id === copy.originLocationId)?.name || copy.originLocationId}. Actual reading and custody: ${s.world.locations.find(place => place.id === copy.custodyLocationId)?.name || copy.custodyLocationId}. Local copy assistance: ${custodian.name}.`
      : `Private account heard from ${run.cast.craftsperson.name} on day ${proof.day}. Quotation is ${run.permissions.some(permission => permission.scope === 'quote' && permission.decision === 'willing') ? 'permitted for this folio only' : 'not permitted'}.`;
    return `<details class="remembered-entry" data-research-source="${e(source.id)}"><summary>${e(source.title)} · ${source.scope === 'public' ? 'Public source' : 'Private personal account'}</summary><p>${e(source.text)}</p><p class="small-copy">${e(source.limit)}</p><p class="small-copy">${e(provenance)}</p><p class="small-copy">Credit: ${e(copy ? source.attribution : run.cast.craftsperson.name)}</p></details>`;
  }).join('');
}
function runCard(s, run, ui) {
  const { e } = ui, definition = researchDefinition(run.definitionId), reading = researchInterpretation(run.definitionId, run.interpretationId);
  return `<article class="research-folio" data-research-run="${e(run.id)}"><h3>${e(definition.title)}</h3><p>${e(definition.question)}</p><p class="small-copy">${run.status === 'completed' ? `Completed day ${run.endedDay} · ${run.finalization.audience === 'self' ? 'Self-only' : run.finalization.audience === 'private' ? 'One named private reader' : 'Local public deposit'}` : run.status === 'withdrawn' ? 'Closed without a verdict' : run.status === 'interrupted' ? 'Earlier life ended with the question unfinished' : 'Accepted question'} · ${run.comparison ? 'Comparison and once-only practice recorded' : 'Comparison not yet performed'} · 0 Gold earned.</p>${reading?.supported ? `<p>${e(reading.conclusion)}</p>` : reading ? `<p>${e(reading.explanation)}</p>` : ''}${run.claims.length ? `<ul>${run.claims.map(claim => `<li>${e(claim.text)} <small>(${e(claim.status)}; ${e(claim.sourceIds.map(id => researchSource(run.definitionId, id).title).join('; '))})</small></li>`).join('')}</ul>` : ''}${run.openQuestions.length ? `<p class="small-copy">Open questions: ${e(run.openQuestions.join(' '))}</p>` : ''}${sourceCards(s, run, ui)}</article>`;
}

function renderResearchShelf(s, actions, ui) {
  const portfolio = s.researchPortfolio;
  if (portfolio && portfolio.ownerId !== researchOwnerId(s)) return '';
  const offered = actions.filter(action => action.id.startsWith('research_'));
  const active = portfolio?.runs.find(run => run.status === 'active');
  if (!offered.length && !active) return '';
  return `<details class="home-disclosure research-shelf" data-disclosure="home-research" ${active ? 'open' : ''}><summary>${active ? 'Your research table' : 'Research shelf · two finite questions'}</summary><p class="small-copy">Public teaching copies can reach this actual household table. Reading and comparison take real days; no combat, calling or property purchase is required. Paid Scholar work remains separate.</p>${active ? runCard(s, active, ui) : ''}${ui.actionCards(offered)}</details>`;
}

function renderResearchArchive(s, ui, { query = '' } = {}) {
  if (s.researchPortfolio?.ownerId !== researchOwnerId(s)) return '';
  const runs = s.researchPortfolio.runs.filter(run => run.status !== 'active' && (!query || [researchDefinition(run.definitionId).title, ...run.claims.map(claim => claim.text), ...run.openQuestions].join(' ').toLowerCase().includes(query.toLowerCase())));
  return runs.length ? `<section class="panel research-archive" data-research-archive><h2>Research folios</h2>${runs.map(run => runCard(s, run, ui)).join('')}</section>` : '';
}

return {renderResearchArchive,renderResearchShelf};
})();
const __family_origin_ui = (() => {
const { originView } = __family_origins;
const command=(actions,ui,id,label)=>{const a=actions.find(a=>a.id===id);return a?ui.button(ui.e(label||a.label),'activity',id,'secondary small',Boolean(a.disabledReason))+(a.disabledReason?`<p class="disabled-reason">${ui.e(a.disabledReason)}</p>`:''):'';};
function renderOriginInvitation(s,actions,ui,{query=''}={}){
 const v=originView(s);if(!v.offered||query&&![v.title,v.premise].join(' ').toLowerCase().includes(query.toLowerCase()))return '';
 return `<details class="panel" data-family-origin-invitation data-disclosure="family-origin-invitation"><summary>${ui.e(v.title)} · ${v.declined?'Declined · never accepted':'Optional family invitation'}</summary><p>${ui.e(v.premise)}</p><p class="small-copy">Reading this invitation accepts nothing. No deadline, fee or promised reunion.</p><div class="quick-actions">${v.declined?command(actions,ui,'origin_reconsider'):command(actions,ui,'origin_accept','Begin this search')+command(actions,ui,'origin_decline','Decline invitation')}</div></details>`;
}
function renderOriginArchive(s,ui,{query=''}={}){
 const v=originView(s),r=v.run;if(!r||!['completed','stopped','left_unfinished'].includes(r.status)||query&&![v.title,...r.history.map(h=>h.text)].join(' ').toLowerCase().includes(query.toLowerCase()))return '';
 const status=r.status==='stopped'?'Closed by choice':r.status==='left_unfinished'?'Left unfinished':r.ending==='uncertain_account'?'An honest uncertain account':'A surviving account heard';
 return `<details class="panel" data-family-origin-archive><summary>${ui.e(v.title)} · ${ui.e(status)}</summary><p class="small-copy">Began at age ${r.acceptedAge} · day ${r.acceptedDay}. The family’s recorded availability was not changed by this search.</p>${r.history.map(h=>`<article class="remembered-entry"><small>Day ${h.day}</small><h3>${ui.e(h.title)}</h3><p>${ui.e(h.text).replaceAll('\n','<br>')}</p></article>`).join('')}<p class="small-copy">Evidence acquired: ${r.evidence.length}. Acquisition of a statement does not make its uncertain claims true.</p></details>`;
}
function renderOriginActive(s,actions,ui){const v=originView(s),r=v.run;if(!r||!['active','paused'].includes(r.status))return '';return `<article class="panel" data-family-origin-active><h3>${ui.e(v.title)}</h3><p>${ui.e(v.anchor.body)}</p><p class="small-copy">${r.status==='paused'?'Paused. Your earlier people and evidence remain.':'The next search step is your choice. No deadline or promised reunion.'}</p><div class="quick-actions">${actions.filter(a=>a.id.startsWith('origin_')||a.id==='journal_track_family-origin').map(a=>command(actions,ui,a.id)).join('')}</div></article>`;}

return {renderOriginActive,renderOriginArchive,renderOriginInvitation};
})();
const __companion_field_assists_ui = (() => {
const labels = Object.freeze({ scout: 'Guide the disarming', protector: 'Brace the crossing', scholar: 'Share the close reading', healer: 'Dress a small wound' });
const mazeFieldAssistLabel = kind => labels[kind] || 'Companion help';
function mazeFieldAssistReceiptText(row) {
  const target = row.targetPerson?.name || row.actorName;
  const effect = row.kind === 'scholar' ? `${target} Focus ${row.target.mp} → ${row.targetFocusAfter}`
    : `${target} Health ${row.target.hp} → ${row.targetHpAfter}`;
  return `${row.helperPerson.name} · generation ${row.actorGeneration}: ${mazeFieldAssistLabel(row.kind)}. Personal Focus ${row.helper.mp} → ${row.helperFocusAfter} (${row.focusCost} spent)${row.herbCost ? `; herbs ${row.herbsBefore} → ${row.herbsAfter} (${row.herbCost} spent)` : ''}. ${effect}${['scout','protector'].includes(row.kind) ? `; alone ${row.aloneDamage} injury, assisted ${row.damage}` : ''}.`;
}

/** One exact description used by native current-room controls and the accepted
 * Journal entry. These field adaptations are not new effects of combat spells. */
function describeMazeFieldAssist(q) {
  if (q.disabledReason) return 'No resources spent. ' + q.disabledReason;
  const cost = `${q.helperName} spends ${q.focusCost} personal Focus (${q.helperFocus} → ${q.helperFocusAfter})${q.herbCost ? ` and ${q.herbCost} herb bundle (${q.herbs} → ${q.herbs - q.herbCost})` : ''}.`;
  let result;
  if (q.kind === 'scout' || q.kind === 'protector') result = `Alone: lose ${q.aloneDamage} Health. With help: lose ${q.damage} Health (${q.targetHp} → ${q.targetHpAfter}).`;
  else if (q.kind === 'scholar') result = `Your Focus ${q.targetFocus} → ${q.targetFocusAfter} (+${q.focusGain}); read this same inscription once into Journal Archive, with no Scholarship or experience gain. ${q.notebookCopyNotice || 'An editable personal copy is kept only if this life’s notebook has room; no existing note is replaced.'}`;
  else result = `${q.targetName}: Health ${q.targetHp} → ${q.targetHpAfter} (+${q.hpGain}). No revival or cleansing; potions remain separate.`;
  return `${cost} ${result}${q.mastery ? ` Their own chapter ${q.mastery.chapter} qualifies this experienced field adaptation; it does not change the combat technique.` : ''} No calendar time. Uses this room’s one companion-help slot.`;
}

/** No helper is selected implicitly: each native button names both source and
 * (for care) target. Reusing an old local role ID never renames the recorded
 * original person in the used-slot disclosure. */
function renderMazeFieldAssists(s, actions, { e, button }) {
  const used = s.maze?.fieldAssists?.entries.find(row => row.cellId === s.maze.position);
  const offers = actions.filter(a => a.id.startsWith('maze_assist_'));
  if (!offers.length && !used) return '';
  const history = used ? `<p class="small-copy" data-maze-assist-used>Companion help already used here: ${e(used.helperPerson.name)} · generation ${used.actorGeneration} · ${e(mazeFieldAssistLabel(used.kind))}. This records that person’s own help, not a later companion with the same role.</p>` : '';
  return `<section class="maze-field-assists" aria-labelledby="maze-field-assists-title"><h3 id="maze-field-assists-title" tabindex="-1">Companion help</h3><p class="small-copy">Choose who helps. One paid assistance per physical room, across visits and lives; no passive party bonuses.</p>${history}${offers.map(a => `<div class="field-assist" data-maze-assist="${e(a.id)}"><p class="small-copy">${e(a.description)}</p>${button(e(a.label), 'activity', a.id, 'secondary small', Boolean(a.disabledReason))}${a.disabledReason ? `<p class="disabled-reason">${e(a.disabledReason)}</p>` : ''}</div>`).join('')}</section>`;
}

return {describeMazeFieldAssist,mazeFieldAssistLabel,mazeFieldAssistReceiptText,renderMazeFieldAssists};
})();
const __maze_receipt_ui = (() => {
const { sameExpeditionRun, expeditionVisitTotals } = __maze_receipts;
const { getGearItem, GEAR_CATALOG } = __gear;
const { resolveFoundItem } = __gear_loot;
const { mazeFieldAssistReceiptText } = __companion_field_assists_ui;
const methodNames={copy:'Careful private copy',public:'Public account',stewardship:'Practical stewardship',care:'Shared service',trade:'Limited paid service',scheme:'Controlled service'};
const status = row => row.reason==='life_end'?'Life ended below':row.reason==='defeat'?'Defeat and recovery':row.objective.complete?'Returned complete':'Returned unfinished';
const amounts = values => Object.entries(values).filter(([,n])=>n>0).map(([key,n])=>n+' '+key).join(', ')||'none';

/** Inspection only. This never equips, replaces a missing item or reads a map. */
function expeditionGearSelection(s,id){
 const item=(s.equipment?.owned||[]).includes(id)&&getGearItem(s,id);if(!item)return null;
 return {tab:'inventory',selectedId:'gear:'+id,category:'equipment',filter:'all',query:''};
}
function expeditionReceiptView(s,row){
 const run=[s.maze,...(s.mazeBook?.records||[])].find(m=>m&&sameExpeditionRun(row.identity,m));
 const totals=expeditionVisitTotals(row),gear=totals.gains.gear.map(record=>({id:record.id,
  name:getGearItem(s,record.id)?.name||resolveFoundItem(record,GEAR_CATALOG)?.name||record.baseId,
  carried:Boolean(expeditionGearSelection(s,record.id))}));
 return {row,title:run?.title||'Expedition from '+(s.world.locations.find(p=>p.id===row.identity.locationId)?.name||row.identity.locationId),
  status:status(row),actorName:row.actorName||'Name not recorded',totals,gear,
  method:row.objective.method?methodNames[row.objective.method]||row.objective.method:null};
}
function renderReceipt(v,ui){
 const {row:r,totals:t}=v,{e,button,date}=ui,when=date?date(r.end.day):'Day '+r.end.day;
 const found=[...t.gains.relics.map(item=>`<li>${e(item.name)} · ${item.value} Gold assessed value, not payment</li>`),
  ...v.gear.map(item=>`<li>${e(item.name)} · ${item.carried?button(e('Compare '+item.name),'receipt-gear',item.id,'ghost small'):'No longer carried'}</li>`),
  ...t.gains.properties.map(item=>`<li>${e(item.label)} · recorded property</li>`)];
 const assists=r.assists?.length?`<section data-expedition-field-assists><h4>Companion field help</h4><p class="small-copy">${t.companionFocusUsed} personal companion Focus spent. Herb costs are included once in the recorded costs below.</p><ul>${r.assists.map(row=>`<li>${e(mazeFieldAssistReceiptText(row))}</li>`).join('')}</ul></section>`:'';
 return `<article class="remembered-entry expedition-receipt" data-expedition-receipt="${e(r.id)}"><h3>${e(v.title)}</h3><p class="small-copy">${e(when)} · ${e(v.actorName)} · generation ${r.actorGeneration}</p><p><strong>${e(v.status)}</strong> · Objective ${r.objective.complete?'complete':'unfinished'}${v.method?' · '+e(v.method):''}.</p>${r.coverage==='observed'?'<p class="notice">Partial history: recording began during this saved visit. Earlier entry costs, days and gains are unavailable.</p>':''}${!t.settlementsComplete?'<p class="notice warning">Partial accounting: some settlement details could not be recorded. The listed gains and costs are a partial account, not complete totals.</p>':''}<p>${r.end.explored} rooms explored (+${r.end.explored-r.start.explored} this visit) · ${r.end.cleared} cleared (+${r.end.cleared-r.start.cleared}) · ${r.end.steps-r.start.steps} walks.</p><p>${t.days} attended days recorded: ${r.days.entry} entry, ${r.days.inside} below, ${r.days.recovery} recovery. ${t.retreats} combat retreat${t.retreats===1?'':'s'}; retreats continued the same visit.</p><p class="small-copy">Health ${r.start.health} → ${r.end.health} · Focus ${r.start.focus} → ${r.end.focus}. Walking used ${t.walkingFocusUsed} Focus.</p><p class="small-copy">Potions carried ${r.start.potions} → ${r.end.potions}; used ${t.costs.potions}. Rations ${r.start.rations} → ${r.end.rations}; used ${t.costs.rations}. Kit nights ${r.start.kitNights} → ${r.end.kitNights}; used ${t.kitNightsUsed}.</p><details data-disclosure="receipt-spoils:${e(r.id)}"><summary>Recorded gains, costs &amp; proof</summary><p>Direct proceeds: ${t.gains.gold} Gold and ${t.gains.experience} experience. Materials found: ${e(amounts(t.gains.materials))}; herbs found: ${t.gains.herbs}.</p><p>Recorded costs: ${t.costs.gold} Gold (${r.fees.work} work fees, ${r.fees.passage} passage fees, ${r.fees.recovery} defeat recovery), ${e(amounts(t.costs.materials))}; herbs committed: ${t.costs.herbs}.</p><p class="small-copy">Ordinary living costs and unrelated income are not counted as expedition loot. Client payment remains a separate action.</p>${r.objective.battleId?`<p class="small-copy">Actual battle proof: ${e(r.objective.battleId)}${r.objective.captured?' · captive recorded':''}.</p>`:''}${r.objective.completionDay!==null?`<p class="small-copy">Objective method recorded on world day ${r.objective.completionDay}; its existing proof remains separate from this receipt.</p>`:''}${assists}${found.length?`<ul>${found.join('')}</ul>`:'<p>No finite finds recorded in the covered interval.</p>'}</details></article>`;
}
function renderLatestExpeditionReceipt(s,ui){
 const row=s.mazeBook?.expeditionReceipts?.at(-1);
