          },
          "result": "The ship provides one discreet passage contract.",
          "consequence": "Earn smuggling opportunities and local pursuit if a witness identifies the cargo.",
          "requires": [
            "boss_illicit_route",
            "cargo_provenance",
            "observed_offence"
          ]
        }
