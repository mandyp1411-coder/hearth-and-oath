const SCENES={
  table:{test:(s,a,b)=>s.age>=5&&s.age<=12&&peers(s,a,b),title:'The place beside the window',body:(s,a,b)=>`${a.name} pulls a bench toward the window. ${b.name} puts a slate in the gap before anyone can sit down. Yesterday the two of them shared their lunch; today neither looks at the other. The rest of the table waits to see where you sit.`,options:[opt('a','Sit beside {a}','The window is open and the lesson is about to begin.'),opt('b','Make a place beside {b}','There is room at the other end.'),opt('ask','Ask what happened yesterday','Neither has told you the whole story.'),opt('elsewhere','Take an empty bench','You brought your own slate.')],effects:{a:[-7,6,-4],b:[-7,-4,6],ask:[9,2,2],elsewhere:[0,0,0]}},
  dare:{test:(s,a,b)=>s.age>=7&&s.age<=15&&peers(s,a,b),title:'Three knocks beneath the bridge',body:(s,a,b)=>`${a.name} says the thing beneath the bridge answers only after the third knock. ${b.name} has already tied a red thread around the rail. “We were going together,” ${b.name} says. Neither of them has asked the ferryman why the lower steps are chained.`,options:[opt('join','Go with them, as far as the chained steps','You can still hear the ferryman from there.'),opt('warn','Ask the ferryman about the chain','Your friends wait by the rail.'),opt('tease','Tell {a} to do the knocking','The red thread flutters against the water.'),opt('leave','Leave before the third knock','You know another way home.')],effects:{join:[6,4,4],warn:[-2,-1,3],tease:[-8,-5,2],leave:[0,-2,-2]}},
  notes:{test:(s,a,b)=>s.age>=9&&s.age<=17&&peers(s,a,b)&&s.education?.enrolled,title:'A second hand in the margins',body:(s,a,b)=>`${a.name} lends you a lesson book. The careful diagrams are in ${b.name}'s hand, but ${a.name} has written their own name on the cover. “We worked together,” ${a.name} says, closing the book before you reach the last page. ${b.name} is waiting outside the classroom.`,options:[opt('return','Return the book without copying it','The examination is still several days away.'),opt('copy','Copy the diagrams and say nothing','You have an unused page in your own notebook.'),opt('credit','Ask both of them whose work you may copy','The book stays on the table between you.'),opt('b','Bring the book to {b}','You leave your own notes unfinished.')],effects:{return:[0,1,0],copy:[-3,3,-2],credit:[8,1,5],b:[-9,-5,6]}},
  rehearsal:{test:(s,a,b)=>s.age>=8&&s.age<=17&&peers(s,a,b),title:'An empty place in the rehearsal',body:(s,a,b)=>`${a.name} has rehearsed the first verse all week. ${b.name} tells the others that ${a.name} will not be coming, then starts practicing the solo. Through the doorway you can see ${a.name} carrying a basket home. The lantern procession leaves at dusk.`,options:[opt('fetch','Find out whether {a} can come','The rehearsal will continue while you are gone.'),opt('stay','Stay and rehearse with {b}','Someone needs to learn the next verse.'),opt('share','Suggest splitting the solo','You have not yet asked either singer.'),opt('watch','Listen from the doorway','You are not in the procession tonight.')],effects:{fetch:[-2,6,-2],stay:[-5,-2,5],share:[7,2,2],watch:[0,0,0]}},
  secret:{test:(s,a,b)=>s.age>=10&&Math.abs(age(s,a)-age(s,b))<=10&&!parent(a)&&!parent(b),title:'Wax on the sealed letter',body:(s,a,b)=>`${a.name} leaves a sealed letter in your keeping until morning. Later ${b.name} notices the familiar handwriting. “Was that meant for me?” The seal has a crack, but you cannot tell whether it was made before the letter reached you.`,options:[opt('keep','Keep the letter sealed','You agreed to hold it until morning.'),opt('ask','Ask {a} whether you may explain','{b} will have to wait.'),opt('give','Hand it to {b}','You have not seen the address beneath the fold.'),opt('open','Look inside before answering','The cracked seal comes away easily.')],effects:{keep:[1,5,-2],ask:[5,3,1],give:[-10,-7,5],open:[-6,-6,-3]}},
  festival:{test:(s,a,b)=>s.age>=6&&!parent(a)&&!parent(b)&&Math.abs(age(s,a)-age(s,b))<=12,title:'Two ribbons for the same evening',body:(s,a,b)=>`${a.name} has saved you a place at the lantern stalls. ${b.name} arrives with a ribbon for the procession and says you promised to watch. You remember saying you would try. Both are waiting while the first bell rings.`,options:[opt('a','Go to the stalls with {a}','You can hear the procession from the square.'),opt('b','Watch the procession with {b}','The lantern stalls close after the last bell.'),opt('together','Ask whether both would like to come','One ribbon lies between the three of you.'),opt('alone','Say you need an evening to yourself','The streets are already filling.')],effects:{a:[-3,6,-4],b:[-3,-4,6],together:[8,2,2],alone:[0,-2,-2]}},
  invitation:{test:(s,a,b)=>s.age>=13&&!parent(a)&&!parent(b)&&Math.abs(age(s,a)-age(s,b))<=8,title:'The names on the invitation',body:(s,a,b)=>`${a.name} invites you to a small supper behind the old bell tower. ${b.name}'s name is missing from the folded list. “It is not a quarrel,” ${a.name} says. “I just want one evening without an argument.” ${b.name} has asked what you are doing tonight.`,options:[opt('accept','Accept the invitation as it stands','There is a chair with your name on it.'),opt('ask','Ask {a} to invite {b}','The host has already laid the table.'),opt('decline','Spend the evening with {b} instead','You will need to send a reply.'),opt('honest','Tell {b} where you are going','You do not speak for the host.')],effects:{accept:[-4,5,-3],ask:[6,-2,3],decline:[-5,-3,5],honest:[1,1,2]}},
  household:{test:(s,a,b)=>s.age>=4&&parent(a)&&parent(b),title:'A conversation after the lamps go out',body:(s,a,b)=>`You wake to ${a.name} and ${b.name} speaking in the next room. There is a traveling offer on the table and a cup gone cold beside it. “I never said forever,” ${a.name} says. ${b.name} lowers their voice when the floorboard creaks under your feet.`,options:[opt('a','Ask {a} about the traveling offer','You sit beside the cold cup.'),opt('b','Ask {b} whether they are worried','The folded offer stays on the table.'),opt('both','Ask whether you can listen to both','They make a little space by the lamp.'),opt('bed','Go back to bed','The door remains slightly open.')],effects:{a:[-2,4,-1],b:[-2,-1,4],both:[7,2,2],bed:[0,0,0]}},
  sibling:{test:(s,a,b)=>s.age>=4&&a.role==='sibling'&&age(s,b)<18&&!parent(b),title:'The game behind the locked gate',body:(s,a,b)=>`${a.name} has made a small fort from packing crates. ${b.name} tells the younger children it is full, although there is a whole bench inside. Your sibling taps twice on the gate and waits. You know the game they are playing; you also know who owns the crates.`,options:[opt('open','Unfasten the gate for {a}','The next round has not begun.'),opt('ask','Ask {b} why the fort is full','You stay outside the gate with your sibling.'),opt('new','Build a different game with {a}','There is a clear patch beside the well.'),opt('join','Take the place {b} offers you','You can see the gate from inside.')],effects:{open:[-2,5,-3],ask:[5,2,1],new:[1,6,0],join:[-7,-5,5]}},
  credit:{test:(s,a,b)=>s.age>=16&&bothAdults(s,a,b)&&(professional(a)||professional(b)),title:'One name on the hanging sign',body:(s,a,b)=>`${a.name} and ${b.name} have spent three evenings preparing a display for the market. When the cloth comes down, only ${a.name}'s mark is visible. ${b.name} wipes a thumb across the empty corner. “The paint was wet when I left,” they say.`,options:[opt('ask','Ask them to tell you how the sign was agreed','The market keeper is still arranging the stalls.'),opt('a','Help {a} finish setting up','The first customers are entering the square.'),opt('b','Stand beside {b} and leave the display','The empty corner catches the morning light.'),opt('amend','Offer to paint both names, if they agree','Neither has picked up the brush yet.')],effects:{ask:[8,2,2],a:[-5,5,-4],b:[-8,-5,6],amend:[10,1,4]}},
  boundary:{test:(s,a,b)=>s.age>=18&&bothAdults(s,a,b),title:'The stones at the garden edge',body:(s,a,b)=>`${a.name} has moved a row of boundary stones beside the shared path. ${b.name} puts them back every morning. Today they have both arrived with a bucket, and neither can reach the well without passing the other. A page from an old lease flaps beneath the nearest stone.`,options:[opt('read','Read the old lease with both of them','Some of the ink has washed away.'),opt('a','Carry water for {a}','The stones stay where they are.'),opt('b','Carry water for {b}','The stones stay where they are.'),opt('path','Ask them to mark a temporary shared path','The boundary can wait until someone finds the second page.'),opt('pass','Take another route','You need not fetch water here today.')],effects:{read:[6,2,2],a:[-5,5,-3],b:[-5,-3,5],path:[10,1,1],pass:[0,0,0]}},
  care:{test:(s,a,b)=>s.age>=18&&bothAdults(s,a,b),title:'The kettle nobody refilled',body:(s,a,b)=>`${a.name} has been carrying broth to a sick neighbor. ${b.name} was meant to bring the wood yesterday. There is ash in the hearth and no fresh kindling. When ${a.name} says nothing, ${b.name} begins explaining a shift that ran late.`,options:[opt('listen','Listen before deciding who let the other down','The broth can wait by the embers.'),opt('a','Stay with {a} this evening','You have not promised another evening yet.'),opt('b','Help {b} find a different time to bring wood','There may be another way to share the errands.'),opt('rota','Ask them to agree on days they can actually keep','One corner of the slate is still clean.')],effects:{listen:[5,2,2],a:[-3,5,-2],b:[3,-1,4],rota:[9,2,2]}},
  achievement:{test:(s,a,b)=>s.age>=14&&!parent(a)&&!parent(b)&&Math.abs(age(s,a)-age(s,b))<=10,title:'The certificate folded small',body:(s,a,b)=>`${a.name} receives a certificate before the assembled hall. ${b.name}, who practiced with them for weeks, slips outside before the applause ends. Later ${a.name} asks why ${b.name} will not come to the supper. The certificate is folded small enough to fit a coat pocket.`,options:[opt('celebrate','Go to the supper with {a}','The invitation has room for your name.'),opt('find','Find {b} outside','You can still hear the applause through the wall.'),opt('invite','Ask {b} what kind of invitation they would accept','You do not promise their answer for them.'),opt('quiet','Congratulate {a} privately and leave','You have no appetite for a crowded table tonight.')],effects:{celebrate:[-3,5,-2],find:[-3,-2,5],invite:[8,2,3],quiet:[1,3,0]}},
  departure:{test:(s,a,b)=>s.age>=18&&bothAdults(s,a,b),title:'A trunk beside the doorway',body:(s,a,b)=>`${a.name} has accepted work beyond the old road. ${b.name} says they had planned a venture together when the rains ended. The trunk is packed, but a second key still hangs on the wall. ${a.name} asks you to witness a letter before the cart arrives.`,options:[opt('witness','Witness the letter after reading it with both','The cart driver is watering the horse.'),opt('help','Help {a} carry the trunk','You keep the letter folded.'),opt('stay','Ask {a} to stay for another season','The work offer has an answer date.'),opt('letters','Offer to carry letters while they decide what remains','The spare key stays on its hook.')],effects:{witness:[4,3,1],help:[-4,5,-3],stay:[-6,-4,4],letters:[8,2,2]}},
  purse:{test:(s,a,b)=>s.age>=18&&bothAdults(s,a,b),title:'A short count at the shared table',body:(s,a,b)=>`${a.name} and ${b.name} keep a purse for their shared errands. At the end of the month the count is short. ${a.name} remembers paying a healer; ${b.name} remembers that payment coming from a different purse. Three receipts lie in the spilled salt.`,options:[opt('receipts','Sort the receipts with them','Some dates have smeared beneath the salt.'),opt('a','Take {a} at their word','You did not see the payment.'),opt('b','Take {b} at their word','You did not see the payment.'),opt('pause','Ask them to keep separate accounts for now','The shared errands still need doing.')],effects:{receipts:[8,2,2],a:[-9,6,-5],b:[-9,-5,6],pause:[2,1,1]}},
  truce:{test:(s,a,b,e)=>s.age>=8&&e.affinity<45&&Math.abs(age(s,a)-age(s,b))<=15,title:'The chair left in the aisle',body:(s,a,b)=>`${a.name} arrives carrying a chair that ${b.name} lent months ago. Neither remembers who first stopped visiting. The chair is set in the aisle between their doors. “It was never about the chair,” ${b.name} says, but does not take it inside.`,options:[opt('listen','Stay while each tells their version','Neither has to start first.'),opt('return','Help {a} return the chair and leave','You keep to the errand you were asked to do.'),opt('meal','Invite both to an ordinary meal','They may decline separately.'),opt('apart','Tell them they need not become friends again','The chair can still be returned.')],effects:{listen:[11,3,3],return:[0,3,0],meal:[9,2,2],apart:[2,1,1]}},
};
const ECHO_OPTIONS=[opt('hear','Let them finish the story'),opt('ask','Ask what they want to do next'),opt('leave','Say you cannot stay today')];
function substitute(text,a,b) {return text.replaceAll('{a}',a.name).replaceAll('{b}',b.name);}
function earlierAfternoon(s,a,b,scene) {
  const participants=[a,b];
  const p=participants.find(p=>actual(s,p)?.record?.memories?.some(m=>m.includes('school club')));
  if(p && ['table','invitation','sibling'].includes(scene))return ` You remember the folded membership paper from an earlier afternoon with ${p.name}.`;
  const prank=participants.find(p=>actual(s,p)?.record?.memories?.some(m=>m.includes('school prank')));
  if(prank && ['dare','secret'].includes(scene))return ` You remember ${prank.name}'s face when the tutor rang the bell after the prank.`;
  const affection=participants.find(p=>s.pastimes?.facts?.includes(`first-affection:${p.sourceId}:shared`));
  if(affection && ['festival','invitation','departure'].includes(scene))return ` The ordinary question leaves a pause between you and ${affection.name}; neither of you has forgotten the slower walk home.`;
  return '';
}
function offer(s,e,scene,kind='witness',extra={}) {
  const a=node(s,e.aId),b=node(s,e.bId),def=SCENES[scene];if(!a || !b || !def)return null;
  return {eventId:`social_${scene}`,scene,edgeId:e.id,aId:a.id,bId:b.id,day:s.day,locationId:s.locationId,kind,title:def.title,body:def.body(s,a,b)+earlierAfternoon(s,a,b,scene),choices:def.options.map(c=>({...c,label:substitute(c.label,a,b),description:substitute(c.description,a,b)})),...extra};
}
function enqueue(s,q) {
  if(!q || s.social.queued.length>=MAX_QUEUE || s.social.pending?.edgeId===q.edgeId || s.social.queued.some(other=>other.edgeId===q.edgeId))return false;
  s.social.queued.push(q);return true;
}
function visibleEdge(s,e) {const a=node(s,e.aId),b=node(s,e.bId);return a?.alive&&b?.alive&&a.locationId===s.locationId&&b.locationId===s.locationId;}
function appropriateScenes(s,e) {
  const a=node(s,e.aId),b=node(s,e.bId);if(!a || !b)return [];
  return Object.keys(SCENES).filter(id=>SCENES[id].test(s,a,b,e));
}
function selectScene(s,e,key,forced=null) {
  let ids=appropriateScenes(s,e);if(forced && ids.includes(forced))return forced;
  if(ids.length>1)ids=ids.filter(id=>id!==e.lastScene);
  const fresh=ids.filter(id=>!(s.social.recentScenes || []).includes(id));if(fresh.length)ids=fresh;
  const preferred={recognition:['achievement','rehearsal','credit'],company:['festival','invitation','table','truce'],privacy:['secret','household'],fairness:['notes','credit','purse','boundary'],independence:['departure','sibling','dare']}[e.agenda] || [];
  ids=[...ids,...ids.filter(id=>preferred.includes(id))];
  return ids.length?ids[seededRoll(s.seed,key,ids.length)]:null;
}
function markKnown(s,e) {e.known=true;e.knownDay=s.day;e.observedKind=e.kind;for(const id of [e.aId,e.bId]){const p=node(s,id);if(p)p.lastSeenDay=s.day;}}
function adjust(e,amount,s) {
  e.affinity=clamp(e.affinity+amount);e.lastDay=s.day;
  if(e.kind!=='family')e.kind=e.affinity<40?'rivalry':e.affinity>=60?'friendship':'acquaintance';
}
function echo(s,c) {
  const e=edge(s,c.edgeId),a=node(s,c.aId),b=node(s,c.bId);if(!e || !a || !b || !a.alive || !b.alive)return null;
  const friendly=e.affinity>=60;
  const bodies={
    table:`The lesson benches have been moved again. ${a.name} has left a spare slate beside ${friendly?b.name:'their own books'}. ${b.name} notices you at the door and ${friendly?'makes room without being asked':'takes a seat at the other end'}.`,
    dare:`The ferryman has taken down the red thread. ${a.name} says the chained steps lead to a broken landing, not a monster. ${b.name} ${friendly?'laughs and starts telling the story differently':'says that was not the part they were frightened of'}.`,
    notes:`A new lesson book lies open between ${a.name} and ${b.name}. ${friendly?'Both hands are visible in its margins.':'One has brought a separate notebook.'} ${b.name} asks whether you remember the first diagrams.`,
    secret:`${a.name} catches you by the bell tower. ${c.outcome==='open'?'“The seal was not like that when I gave it to you.” They hold the empty envelope between two fingers.':c.outcome==='give'?`“${b.name} received the letter.” They wait before saying anything more.`:`“I delivered it myself.” ${b.name} has stopped asking you about the handwriting.`}`,
    household:`The traveling offer is no longer on the table. ${a.name} has ${friendly?'written a reply beside '+b.name:'put it away in a drawer'}. At supper ${b.name} asks if you would like to hear what they decided.`,
    credit:`At the next market ${friendly?`two names hang over the display. ${a.name} asks ${b.name} where to set the finished pieces`:`${a.name} and ${b.name} have taken separate stalls`}. You recognize the cloth that covered the first sign.`,
    boundary:`There is a narrow passage between the garden stones now. ${friendly?`${a.name} holds the gate while ${b.name} carries water through`:`${a.name} and ${b.name} use it at different hours`}. The second page of the lease has still not been found.`,
    departure:`A letter arrives for ${b.name}, creased from the old road. ${friendly?`${b.name} reads part of ${a.name}'s account aloud`:`${b.name} puts ${a.name}'s letter beneath the spare key`}. The cart has long since gone.`,
    truce:`The chair is ${friendly?'back at the supper table':'no longer in the aisle'}. ${a.name} and ${b.name} ${friendly?'have begun visiting again, although neither calls it an apology':'greet each other briefly by the well'}. You recognize the mark on its lowest rung.`,
  };
  return {eventId:'social_echo',scene:'echo',edgeId:e.id,aId:a.id,bId:b.id,day:s.day,locationId:s.locationId,kind:'callback',title:'Something familiar, seen again',body:bodies[c.scene] || `${a.name} and ${b.name} cross the square ${friendly?'together':'at different ends of the evening'}. ${friendly?'One waits while the other finishes speaking.':'Neither mentions the last time you stood between them.'} You recognize a detail from ${SCENES[c.scene]?.title.toLowerCase() || 'an earlier evening'}.`,choices:ECHO_OPTIONS.map(o=>({...o}))};
}
function onSocialTime(s,{oldDay,newDay},ctx={}) {
  const v=s.social;if(!v || newDay<=oldDay)return;
  v.lastDay=newDay;sync(s);
  // Unaccepted afternoons pass. A childhood invitation cannot wait untouched
  // until the recipient's thirtieth birthday; accepted pending scenes do wait.
  v.queued=v.queued.filter(q=>q.kind==='invitation' || newDay-q.day<=(q.kind==='callback'?365:180));
  if(v.useAge!==s.age){v.useAge=s.age;v.uses={};}
  if(s.age<3 || s.hero.alive===false || s.phase==='retired')return;
  const cycle=Math.floor((newDay-v.startedDay)/180);
  // Calendar jumps process at most two developments, rather than inventing a
  // backlog of dialogue at every day crossed by an annual plan.
  for(let c=Math.max(v.lastCycle+1,cycle-1);c<=cycle;c++) {
    let possible=v.edges.filter(e=>{
      const a=node(s,e.aId),b=node(s,e.bId);
      return a?.alive&&b?.alive&&a.locationId===b.locationId&&appropriateScenes(s,e).length;
    });
    const freshPairs=possible.filter(e=>appropriateScenes(s,e).some(id=>!(v.recentScenes || []).includes(id)));
    if(freshPairs.length)possible=freshPairs;
    if(!possible.length)continue;
    const e=possible[seededRoll(s.seed,`social-turn:${v.ownerId}:${c}`,possible.length)],a=node(s,e.aId),b=node(s,e.bId);
    // Select the situation before its independent change: a reconciliation may
    // itself carry the tie over the rivalry threshold that made it eligible.
    const scene=selectScene(s,e,`social-scene:${e.id}:${c}`);if(!scene)continue;
    const delta=seededRoll(s.seed,`social-turn-direction:${e.id}:${c}`,3)===0?-5:4;
    adjust(e,delta,s);e.developments++;e.lastScene=scene;
    // A player's secret is never inferred from this ambient social graph.
    if(visibleEdge(s,e)) {
      const q=offer(s,e,scene);if(!q)continue;markKnown(s,e);
      v.recentScenes=[...(v.recentScenes || []),scene].slice(-8);
      record(s,ctx,q.title,q.body,[a.id,b.id]);enqueue(s,q);
    }
    else record(s,{},'An unwitnessed evening',`${a.name} and ${b.name} spent an evening on a concern of their own.`,[a.id,b.id],false);
  }
  v.lastCycle=cycle;
  for(const c of [...v.callbacks])if(c.dueDay<=newDay) {
    const e=edge(s,c.edgeId);
    if(!e || !node(s,c.aId)?.alive || !node(s,c.bId)?.alive){v.callbacks=v.callbacks.filter(a=>a!==c);continue;}
    if(visibleEdge(s,e)) {
      const q=echo(s,c);
      if(enqueue(s,q)){markKnown(s,e);record(s,ctx,q.title,q.body,[c.aId,c.bId]);v.callbacks=v.callbacks.filter(a=>a!==c);}
    }
  }
}
function socialActions(s) {
  if(!active(s))return [];
  const v=s.social,known=v.edges.filter(e=>e.known&&visibleEdge(s,e)),local=v.nodes.filter(p=>p.alive&&p.locationId===s.locationId&&actual(s,p));
  const rows=[];
  const add=(id,label,description,reason)=>rows.push({id,label,description,days:0,cost:0,durationDays:1,group:'Friends & social life',...(reason?{disabledReason:reason}:{})});
  for(const q of v.queued.filter(q=>q.locationId===s.locationId&&visibleEdge(s,edge(s,q.edgeId))).slice(0,3)) {
    const a=node(s,q.aId),b=node(s,q.bId);
    add(`social_join_${q.edgeId}`,q.kind==='callback'?`Hear the rest from ${a.name} and ${b.name}`:`Join ${a.name} and ${b.name}`,`${q.title}. 1 day.`);
  }
  if(local.length>=2&&v.edges.some(e=>visibleEdge(s,e)&&appropriateScenes(s,e).length))add('social_gather',s.age<12?'Spend an afternoon with your circle':'Make plans with your circle','An afternoon together. 1 day.',(v.uses.gather || 0)>=2?'You have already arranged two gatherings this year.':undefined);
  for(const e of known.filter(e=>e.affinity<55).slice(0,3)) {
    const a=node(s,e.aId),b=node(s,e.bId);add(`social_reconcile_${e.id}`,`Talk with ${a.name} and ${b.name}`,'Find a quiet time to hear them both. 1 day.',v.uses[e.id]?'You have already brought this pair together this year.':undefined);
  }
  const unknown=v.edges.filter(e=>!e.known&&visibleEdge(s,e)&&appropriateScenes(s,e).length).slice(0,2);
  for(const e of unknown) {
    const a=node(s,e.aId),b=node(s,e.bId);add(`social_introduce_${e.id}`,`Spend time with ${a.name} and ${b.name}`,'Join two people you know for an ordinary afternoon. 1 day.',v.uses[e.id]?'You have already made this invitation this year.':undefined);
  }
  return rows;
}
function applySocialAction(s,id,ctx={}) {
  const row=socialActions(s).find(a=>a.id===id);if(!row || row.disabledReason)return false;
  let e,existing=null;
  if(id==='social_gather') {
    let available=s.social.edges.filter(e=>visibleEdge(s,e)&&appropriateScenes(s,e).length);
    if(!available.length)return false;
    const unused=available.filter(e=>!e.known);if(unused.length)available=unused;
    e=available[seededRoll(s.seed,`social-gather:${s.social.ownerId}:${s.age}:${s.social.uses.gather || 0}`,available.length)];
  } else if(id.startsWith('social_join_')) {
    existing=s.social.queued.find(q=>q.edgeId===id.slice('social_join_'.length));e=edge(s,existing?.edgeId);
  } else e=edge(s,id.slice(id.startsWith('social_reconcile_')?'social_reconcile_'.length:'social_introduce_'.length));
  if(!e || !visibleEdge(s,e))return false;
  existing ||= s.social.queued.find(q=>q.edgeId===e.id);
  const scene=existing?.scene || selectScene(s,e,`social-invitation:${e.id}:${s.age}:${s.social.sequence}`,id.startsWith('social_reconcile_')?'truce':null);
  if(!scene)return false;
  const q=existing || offer(s,e,scene,'invitation');
  const actualDays=Math.max(0,ctx.spendDays?.(1) || 0);
  if(actualDays<1)return true; // A birthday/urgent need can stop the afternoon.
  if(s.hero.alive===false || s.phase==='retired')return true;
  if(!visibleEdge(s,e)) {
    const a=node(s,e.aId),b=node(s,e.bId);
    record(s,ctx,'An afternoon that did not come together',`You had set aside an afternoon with ${a.name} and ${b.name}. By the time you arrived, one of them had already left.`,[a.id,b.id]);return true;
  }
  if(!existing)s.social.uses[id==='social_gather'?'gather':e.id]=(s.social.uses[id==='social_gather'?'gather':e.id] || 0)+1;
  if(scene!=='echo')s.social.recentScenes=[...(s.social.recentScenes || []),scene].slice(-8);
  q.day=s.day;q.kind='invitation';if(scene!=='echo')e.lastScene=scene;
  if(!existing)enqueue(s,q);
  flushSocialEvent(s,ctx);
  return true;
}
function flushSocialEvent(s,ctx={}) {
  if(!active(s) || s.social.pending)return false;
  s.social.queued=s.social.queued.filter(q=>node(s,q.aId)?.alive&&node(s,q.bId)?.alive);
  const index=s.social.queued.findIndex(q=>q.kind==='invitation'&&q.locationId===s.locationId);
  if(index<0)return false;
  const [q]=s.social.queued.splice(index,1);
  if(!q)return false;
  // A queued local scene waits when travel moved the player away.
  s.social.pending=q;
  const e=edge(s,q.edgeId);if(e)markKnown(s,e);
  ctx.setEvent?.(q.eventId,q.title,q.scene==='echo'?'A familiar thread':'Among people you know',q.body,q.choices.map(c=>({...c})));
  // Names here are actual saved actors. A legacy context may still replace the
  // old companion placeholders "Kest"/"Mira"/"Orrin" inside an unrelated peer's
  // name; keep this fully authored snapshot exact rather than changing who spoke.
  if(s.event?.id===q.eventId){s.event.title=q.title;s.event.body=q.body;s.event.choices=q.choices.map(c=>({...c}));}
  return true;
}
function applySocialChoice(s,eventId,id,ctx={}) {
  const q=s.social?.pending;if(!q || q.eventId!==eventId || !q.choices.some(c=>c.id===id))return false;
  const e=edge(s,q.edgeId),a=node(s,q.aId),b=node(s,q.bId);if(!e || !a || !b)return false;
  const choice=q.choices.find(c=>c.id===id);
  if(q.scene==='echo') {
    if(id==='ask'){remember(s,a,`You asked what I wanted after ${b.name} and I faced an old concern.`,2);remember(s,b,`You listened without speaking for ${a.name} or me.`,2);}
    record(s,ctx,q.title,`${q.body} ${id==='leave'?'You said you could not stay.':id==='ask'?'You asked what they wanted to do next.':'You stayed until the story was finished.'}`,[a.id,b.id]);
  } else {
    const [tie,abond,bbond]=SCENES[q.scene].effects[id];adjust(e,tie,s);markKnown(s,e);
    remember(s,a,`${s.hero.name}: ${choice.label}. ${b.name} was there.`,abond);
    remember(s,b,`${s.hero.name}: ${choice.label}. ${a.name} was there.`,bbond);
    e.memories.push({day:s.day,scene:q.scene,choice:id});e.memories=e.memories.slice(-30);
    record(s,ctx,q.title,`${choice.label}. ${a.name} ${abond<0?'looked away before answering':abond>3?'stayed beside you a little longer':'heard you out'}. ${b.name} ${bbond<0?'had something else to attend to':bbond>3?'made room for you':'put the matter down for now'}.`,[a.id,b.id]);
    if(s.social.callbacks.length<12)s.social.callbacks.push({edgeId:e.id,aId:a.id,bId:b.id,scene:q.scene,outcome:id,dueDay:s.day+24+seededRoll(s.seed,`social-echo:${e.id}:${s.day}:${id}`,55)});
    if(s.life){s.life.happiness=clamp(s.life.happiness+(tie>5?2:tie< -5?-1:0));s.life.stress=clamp(s.life.stress+(tie< -5?2:tie>5?-1:0));}
    if(q.scene==='notes'&&id==='copy'&&s.education)s.education.performance=clamp(s.education.performance+2);
  }
  s.social.pending=null;s.notice=choice.label;return true;
}
function socialEventIds() {
  return Object.fromEntries([...Object.entries(SCENES).map(([id,s])=>[`social_${id}`,s.options.map(o=>o.id)]),['social_echo',ECHO_OPTIONS.map(o=>o.id)]]);
}
function socialView(s) {
  const v=s.social;if(!v)return {enabled:false,summary:'',ties:[],notices:[],circles:[],actions:[]};
  const ties=v.edges.filter(e=>e.known).map(e=>{
    const a=node(s,e.aId),b=node(s,e.bId),kind=e.observedKind;return {id:e.id,personId:a.sourceId,otherPersonId:b.sourceId,name:a.name,otherName:b.name,kind,label:kind==='family'?'Shared household':kind==='friendship'?'Spend time together':kind==='rivalry'?'An uneasy history':'A growing acquaintance',description:e.memories.length?`You were there for ${SCENES[e.memories.at(-1).scene]?.title.toLowerCase() || 'an earlier conversation'}.`:'You have seen them together.',knownDay:e.knownDay};
  });
  const knownIds=new Set(v.edges.filter(e=>e.known).flatMap(e=>[e.aId,e.bId]));
  const people=v.nodes.filter(p=>knownIds.has(p.id)&&p.alive).map(p=>({id:p.sourceId,name:p.name}));
  return {enabled:true,summary:'Some evenings belong to the people around you.',ties,notices:v.history.filter(h=>h.visible).slice(-12).map(h=>({...h,actorIds:h.actorIds.map(id=>node(s,id)?.sourceId).filter(Boolean)})),circles:people.length?[{id:'familiar-circle',title:s.age<18?'Your familiar faces':'People whose paths cross',people}]:[],actions:socialActions(s)};
}
function validateSocial(v,s) {
  const plain=o=>!!o&&typeof o==='object'&&!Array.isArray(o);
  const int=(n,max=Number.MAX_SAFE_INTEGER)=>Number.isSafeInteger(n)&&n>=0&&n<=max;
  const txt=(t,max=2200)=>typeof t==='string'&&t.length>0&&t.length<=max;
  const when=n=>int(n)&&(!s||n<=s.day);
  const loc=id=>txt(id,80)&&(!s||s.world.locations.some(p=>p.id===id));
  const unique=a=>new Set(a.map(p=>p.id)).size===a.length;
  if(!plain(v)||v.version!==1||!/^birth--?\d+$/.test(v.ownerId)||!when(v.startedDay)||!when(v.lastDay)||v.lastDay<v.startedDay||!int(v.lastCycle)||!int(v.sequence)||!int(v.useAge,5000)||!plain(v.uses)||Object.keys(v.uses).length>MAX_EDGES+1||!Object.values(v.uses).every(n=>int(n,3))||v.recentScenes!==undefined&&(!Array.isArray(v.recentScenes)||v.recentScenes.length>8||!v.recentScenes.every(id=>Object.hasOwn(SCENES,id))))return false;
  if(!Array.isArray(v.nodes)||v.nodes.length>MAX_NODES||!unique(v.nodes)||!Array.isArray(v.edges)||v.edges.length>MAX_EDGES||!unique(v.edges)||!Array.isArray(v.queued)||v.queued.length>MAX_QUEUE||!Array.isArray(v.callbacks)||v.callbacks.length>12||!Array.isArray(v.history)||v.history.length>160)return false;
  for(const p of v.nodes)if(!plain(p)||!/^social-person-\d+(?:-\d+)?$/.test(p.id)||!txt(p.key,320)||!['life','companion','society','teacher','child'].includes(p.source)||!txt(p.sourceId,80)||!(p.lineageId===undefined||p.lineageId===null||txt(p.lineageId,180))||!txt(p.name,100)||!Number.isSafeInteger(p.bornDay)||p.bornDay< -150000||!txt(p.role,100)||!loc(p.locationId)||typeof p.alive!=='boolean'||!when(p.joinedDay)||!(p.lastSeenDay===null||when(p.lastSeenDay)))return false;
  const nodeExists=id=>v.nodes.some(p=>p.id===id),edgeExists=id=>v.edges.some(e=>e.id===id);
  for(const e of v.edges)if(!plain(e)||!txt(e.id,180)||!nodeExists(e.aId)||!nodeExists(e.bId)||e.aId===e.bId||!['family','friendship','rivalry','acquaintance'].includes(e.kind)||!(e.observedKind===null||['family','friendship','rivalry','acquaintance'].includes(e.observedKind))||!int(e.affinity,100)||typeof e.known!=='boolean'||!(e.knownDay===null||when(e.knownDay))||e.known!==(e.knownDay!==null)||e.known!==(e.observedKind!==null)||!when(e.startedDay)||!when(e.lastDay)||!['recognition','company','privacy','fairness','independence'].includes(e.agenda)||!int(e.developments)||!(e.lastScene===null||Object.hasOwn(SCENES,e.lastScene))||!Array.isArray(e.memories)||e.memories.length>30||!e.memories.every(m=>plain(m)&&when(m.day)&&SCENES[m.scene]?.options.some(o=>o.id===m.choice)))return false;
  const eventIds=socialEventIds();
  const queued=q=>plain(q)&&Object.hasOwn(eventIds,q.eventId)&&q.eventId===`social_${q.scene}`&&edgeExists(q.edgeId)&&nodeExists(q.aId)&&nodeExists(q.bId)&&when(q.day)&&loc(q.locationId)&&['witness','invitation','callback'].includes(q.kind)&&txt(q.title,180)&&txt(q.body,2200)&&Array.isArray(q.choices)&&q.choices.length>=2&&q.choices.length<=5&&new Set(q.choices.map(c=>c.id)).size===q.choices.length&&q.choices.every(c=>plain(c)&&eventIds[q.eventId].includes(c.id)&&txt(c.label,220)&&typeof c.description==='string'&&c.description.length<=500);
  if(v.pending!==null&&!queued(v.pending)||!v.queued.every(queued))return false;
  if(!v.callbacks.every(c=>plain(c)&&edgeExists(c.edgeId)&&nodeExists(c.aId)&&nodeExists(c.bId)&&Object.hasOwn(SCENES,c.scene)&&SCENES[c.scene].options.some(o=>o.id===c.outcome)&&int(c.dueDay)))return false;
  if(!v.history.every(h=>plain(h)&&txt(h.id,100)&&when(h.day)&&txt(h.title,180)&&txt(h.text,4000)&&typeof h.visible==='boolean'&&Array.isArray(h.actorIds)&&h.actorIds.length===2&&h.actorIds.every(nodeExists)))return false;
  if(s&&((v.pending!==null)!==Object.hasOwn(eventIds,s.event?.id)))return false;
  if(s&&v.pending&&JSON.stringify(v.pending.choices)!==JSON.stringify(s.event.choices))return false;
  return true;
}

return {applySocialAction,applySocialChoice,flushSocialEvent,inheritSocial,initializeSocial,onSocialTime,socialActions,socialEventIds,socialView,validateSocial};
})();
const __pastimes = (() => {
const { seededRoll, isSettlement } = __world;
// Small ordinary lives have a calendar too. No scene grants its reward until
// its actual days finish; a birthday, illness, hunger or death can interrupt it.
const INTERESTS = Object.freeze({
 manuscripts:{name:'Reading old manuscripts',description:'Marginal notes, borrowed books and questions the lesson never answered.',skill:'scholarship'},
 sketching:{name:'Sketching',description:'Faces, crooked houses and the shapes of things almost remembered.',skill:'scholarship'},
 music:{name:'Making music',description:'A reed pipe, a remembered melody, and eventually an audience.',skill:'persuasion'},
 gardening:{name:'Keeping a small garden',description:'Seeds in a borrowed patch; patient work with something alive.',skill:'survival'},
 storytelling:{name:'Telling stories',description:'Invented monsters and family tales change with each telling.',skill:'persuasion'},
 strategy:{name:'Playing crownstones',description:'A board game played with scraps of bone and a disputed old rulebook.',skill:'defense'},
});
const PETS = Object.freeze({cat:{name:'Cat',names:['Soot','Thimble','Mallow','Nettle','Crumb','Flint'],years:10,range:6},hound:{name:'Hound',names:['Bramble','Rook','Porridge','Moss','Button','Gorse'],years:8,range:5},raven:{name:'Raven',names:['Ink','Tallow','Wick','Pip','Cinder','Knell'],years:12,range:7}});
const choice=(id,label,description='')=>({id,label,description});
const scene=(title,body,choices,days=2)=>({title,body,choices,days});
const SCENES = Object.freeze({
 manuscripts_0:scene('The missing last page',n=>`The borrowed tale ends halfway through a sentence. ${n} insists the hero died; someone has carefully torn the last page out.`,[choice('invent','Write the ending you wanted'),choice('trace','Follow the tiny notes in the margin'),choice('return','Give the book back as it is')],3),
 manuscripts_1:scene('A name scratched out',()=> 'An old prayerbook has one name scratched out on every page. Beneath the ink, the letters are still faintly visible.',[choice('trace','Copy the hidden letters into your own notebook'),choice('invent','Turn the missing name into a character'),choice('return','Leave a pressed leaf where the name was')],3),
 sketching_0:scene('An unflattering likeness',n=>`${n} sat for a drawing. They laugh at the enormous ears, then ask whether you will show it to everyone.`,[choice('share','Show it with their permission'),choice('keep','Keep this one between you'),choice('redo','Start again while they are still sitting')],3),
 sketching_1:scene('The house that moved',()=> 'You return to finish a sketch and find the little house demolished. A blue shutter lies in the weeds exactly where its doorway used to be.',[choice('keep','Finish it from memory'),choice('redo','Draw what stands there now'),choice('share','Leave a copy with its former neighbors')],3),
 music_0:scene('One stubborn note',n=>`Every time you reach the end of the tune, the reed squeals. ${n} knows a different ending and keeps playing it over yours.`,[choice('solo','Learn the difficult ending alone'),choice('together','Make a version with both endings'),choice('quiet','Put the instrument away for tonight')],3),
 music_1:scene('A song behind the wall',()=> 'Someone next door sings the same four notes each evening. Tonight, the fourth note never comes.',[choice('together','Play the fourth note softly through the wall'),choice('solo','Build a new tune around the three notes'),choice('quiet','Listen without answering')],3),
 gardening_0:scene('Something else in the seed packet',()=> 'Between the ordinary seedlings, a pale spiral plant has appeared. Its leaves close when you breathe near them.',[choice('watch','Keep it in a separate pot and watch'),choice('share','Ask the garden keeper what it is'),choice('pull','Pull it before it takes the whole bed')],3),
 gardening_1:scene('The neighbor’s hungry goat',n=>`${n} finds the borrowed garden stripped to stalks. Their goat still has a marigold between its teeth.`,[choice('share','Ask them to help replant it'),choice('watch','Build a better little fence'),choice('pull','Turn the patch over to hardier herbs')],3),
 storytelling_0:scene('Whose monster is it?',n=>`${n} recognizes their own embarrassing mistake in the villain of your new story. They stop laughing before anyone else does.`,[choice('rewrite','Change the detail that gave them away'),choice('own','Admit where the story came from'),choice('private','Keep this story out of public telling')],3),
 storytelling_1:scene('The listener who knows the ending',()=> 'An older listener interrupts your ghost story: “That was my brother’s name.” The room is suddenly too quiet for the ending you had planned.',[choice('own','Ask which part they remember differently'),choice('rewrite','Let the living person change the ending'),choice('private','Finish a different story tonight')],3),
 strategy_0:scene('The rule under the board',n=>`${n} turns over the crownstones board. An old owner has carved a rule there which reverses your winning move.`,[choice('old-rule','Play another round using the carved rule'),choice('new-rule','Agree on the rules before finishing'),choice('concede','Give them this game and keep the mystery')],3),
 strategy_1:scene('A pawn with somebody’s name',()=> 'Your favorite pawn has a name carved into its base. At the gaming table, an elderly player recognizes it as their mother’s piece.',[choice('concede','Return the pawn and find another'),choice('old-rule','Ask them to teach you her favorite opening'),choice('new-rule','Offer to make a replacement together')],3),
 fair_0:scene('The false-bottom puppet',()=> 'Behind the puppet booth, the drowned king lies face down beside a bowl of buttons. The puppeteer has lost the king’s final speech.',[choice('perform','Invent a speech from behind the curtain'),choice('repair','Help mend the king’s jaw'),choice('watch','Watch the show from the crowd')]),
 fair_1:scene('A ribbon, not a prize',n=>`${n} has entered a lantern in the fair. Its paint runs in the rain. The judges are coming down the row.`,[choice('repair','Help rescue the lantern'),choice('perform','Distract the judges with a performance'),choice('watch','Stay beside them when the judges arrive')]),
 fair_2:scene('The thing in the lucky cup',()=> 'The fairground diviner tips your cup onto the table. A black pebble falls out. “That was not in my jar,” they say, suddenly serious.',[choice('keep','Keep the pebble in your pocket'),choice('return','Leave it on the diviner’s table'),choice('ask','Ask who last used the cup')]),
 club_0:scene('Only three names on the list',n=>`${n} has made a secret society behind the school wall. There is room for three names on its first scrap of parchment. A fourth pupil waits beside you.`,[choice('four','Write a fourth name below the line'),choice('inside','Take the offered place'),choice('outside','Make a second club with the waiting pupil')]),
 club_1:scene('The empty seat at practice',n=>`The school players have rehearsed for days. ${n} has not returned. Their costume still hangs over the empty chair.`,[choice('cover','Learn their lines as well as yours'),choice('wait','Go looking with the teacher'),choice('cancel','Ask the players to postpone the show')]),
 prank_0:scene('The bell without a clapper',n=>`${n} has hidden the school bell’s clapper in a flour sack. They offer you the sack just as footsteps sound beyond the door.`,[choice('join','Take the sack and run'),choice('name','Tell the teacher what happened'),choice('return','Put the clapper back without naming anyone')],1),
 prank_1:scene('A drawing on the lesson slate',n=>`${n} has drawn the tutor as a six-legged spider. Someone else is about to be blamed for it.`,[choice('join','Add your own absurd drawing beside it'),choice('name','Say whose drawing it was'),choice('return','Wipe the slate before the tutor returns')],1),
 skip_0:scene('Beyond the school gate',n=>`${n} has heard of a glass-eyed fish in the millpond. They tug at your sleeve as the lesson bell begins.`,[choice('wander','Go to the pond'),choice('return','Go into the lesson'),choice('cover','Go, then claim you were sent on an errand')]),
 skip_1:scene('A lesson nobody will notice missing',n=>`${n} says the tutor is absent and nobody will keep the register. Through the open window, you can hear a visiting teacher introducing themselves.`,[choice('wander','Spend the day among the market stalls'),choice('return','Go and meet the visiting teacher'),choice('cover','Ask a pupil to answer to your name')]),
 revision_0:scene('A borrowed answer sheet',n=>`${n} slips a folded sheet beneath your book. The handwriting belongs to somebody who already took the examination.`,[choice('practice','Use the questions to find what you do not know'),choice('copy','Memorize the answers exactly'),choice('alone','Give it back and revise from your notes')],3),
 revision_1:scene('The question that never appears',()=> 'The revision group argues over a question that nobody expects on the exam. You are the only one who still wants to know the answer.',[choice('practice','Work out why the answer matters'),choice('copy','Study only what the examiner usually asks'),choice('alone','Keep your own notes and leave the argument')],3),
 games_0:scene('A wager beneath the table',n=>`${n} sets a bent copper beside the crownstones board. “Just one round.” The other players pretend not to listen.`,[choice('coins','Play for two gold'),choice('story','Play for an embarrassing story instead'),choice('leave','Keep your money and watch')],1),
 games_1:scene('A dealer’s second hand',()=> 'The roadside card dealer never lets their left hand leave their sleeve. Their audience is watching the cards instead.',[choice('coins','Stake two gold on one careful round'),choice('story','Ask to play without a stake'),choice('leave','Walk away from the table')],1),
 night_0:scene('The lamp beyond the curfew',n=>`${n} is waiting by the shutters. A traveling singer is playing at the far end of the street; your household has already barred the door.`,[choice('sneak','Slip out without waking anyone'),choice('ask','Wake your caregiver and ask'),choice('stay','Listen from the window')]),
 night_1:scene('The flooded underpass',n=>`${n} brought a lantern. The old underpass is full of ankle-deep water, and there is a second glow beyond its bend.`,[choice('sneak','Follow the glow together'),choice('ask','Find an older guide before going in'),choice('stay','Make your evening on the dry steps')]),
 crush_0:scene('A name in the margin',n=>`${n} lends you a book. Your name is written once in its margin, then crossed out. When you return it, they ask whether you read all the way through.`,[choice('tell','Say you noticed your name'),choice('friend','Ask them to walk home as a friend'),choice('keep','Return it without mentioning the margin')]),
 crush_1:scene('Two ribbons left over',n=>`After the village dance, ${n} offers you one of the two ribbons they kept. “I thought you might want it,” they say, looking at the knot instead of you.`,[choice('tell','Ask what they hoped the ribbon would mean'),choice('friend','Accept it as a friend’s keepsake'),choice('keep','Decline gently and leave the meaning alone')]),
 dinner_0:scene('The chair nobody uses',n=>`${n} arrives early to help lay the table. They put one plate at the empty chair without thinking, then stop.`,[choice('listen','Let them tell you who used to sit there'),choice('gather','Fill the table with everyone who came'),choice('small','Make it a quiet supper for the two of you')]),
 dinner_1:scene('Two guests, one old argument',()=> 'Two of your guests recognize each other in the doorway. One says, “I did not know you would be here.” The meal is already on the table.',[choice('listen','Hear each of them away from the table'),choice('gather','Invite them to sit at opposite ends'),choice('small','Offer to meet each on a different evening')]),
 performance_0:scene('A voice from the back row',n=>`Halfway through your performance, ${n} calls out a correction. They know the old version by heart. The audience turns to you.`,[choice('invite','Invite them to share the old version'),choice('finish','Finish the version you prepared'),choice('stop','End early and speak with them afterward')]),
 performance_1:scene('An audience of one',()=> 'Rain has emptied the little hall. One traveler sits in the back row with their coat still dripping. They ask whether the performance will go ahead.',[choice('invite','Make it a conversation with your listener'),choice('finish','Give the whole performance to this one person'),choice('stop','Share a warm drink instead')]),
 pet_arrival:scene('A creature on the doorstep',()=> 'The rescue keeper opens three baskets. A young cat watches your hands; a small hound hides its face; a raven taps the wicker twice. None has a name yet.',[choice('cat','Offer a home to the cat'),choice('hound','Offer a home to the hound'),choice('raven','Offer a home to the raven'),choice('wait','Leave the baskets with the keeper for now')]),
 pet_care:scene('A place beside your hands',()=> 'Your animal has found the place where you are trying to work and settled there. There are burrs to brush out, a bowl to fill, and nowhere urgent you need to be.',[choice('walk','Make a little outing together'),choice('groom','Brush and tend them at home'),choice('teach','Practice a familiar little trick')],1),
});
const plain=v=>Boolean(v&&typeof v==='object'&&!Array.isArray(v)&&[Object.prototype,null].includes(Object.getPrototypeOf(v)));
const int=(n,max=2000000)=>Number.isInteger(n)&&n>=0&&n<=max;
const text=(s,max=2000)=>typeof s==='string'&&s.length>0&&s.length<=max;
const clamp=(n)=>Math.max(0,Math.min(100,n));
const ownerId=s=>s.lineage?.currentPersonId||`birth-${s.timeline?.birthDay??0}`;
const actor=(s,id)=>s.life?.people?.find(p=>p.id===id&&p.alive!==false);
const nearby=s=>(s.life?.people||[]).filter(p=>p.alive!==false&&(!p.locationId||p.locationId===s.locationId));
const caregiver=s=>nearby(s).find(p=>['parent','guardian'].includes(p.familyRole))||nearby(s).find(p=>p.role==='relative');
const peer=s=>nearby(s).find(p=>!p.familyRole&&p.role!=='relative'&&Math.abs((p.age??s.age)-s.age)<=5)||nearby(s).find(p=>p.familyRole==='sibling');
const companion=s=>peer(s)||nearby(s).find(p=>!p.familyRole&&p.role!=='relative')||caregiver(s);
const blocked=s=>s.phase==='retired'||s.event||s.battle||s.dungeon||s.conversations?.pending||s.timeline?.journey||s.workshop?.project||s.careers?.batch||s.life?.plan;
const note=(s,ctx,title,body)=>{s.notice=body;s.pastimes.history.push({day:s.day,age:s.age,title,text:body});s.pastimes.history=s.pastimes.history.slice(-100);(ctx.journalLiteral||ctx.journal)?.(title,body,'life');};
const fact=(s,f)=>{if(!s.pastimes.facts.includes(f))s.pastimes.facts.push(f);s.pastimes.facts=s.pastimes.facts.slice(-200);};
const wellbeing=(s,h=0,stress=0)=>{if(s.life){s.life.happiness=clamp(s.life.happiness+h);s.life.stress=clamp(s.life.stress+stress);}};
function remember(s,id,body,n=0){const p=actor(s,id);if(!p)return;p.bond=clamp((p.bond||0)+n);p.memories||=[];if(!p.memories.includes(body))p.memories.push(body);p.memories=p.memories.slice(-30);}
function gain(s,id,n=1){if(Number.isFinite(s.hero.skills?.[id]))s.hero.skills[id]+=n;}
const uses=(s,id)=>s.pastimes.uses[`${s.age}:${id}`]||0;
const priceAtAge=(age,id,pick)=>id==='games'&&pick==='coins'?2:id==='fair'&&age>=18?3:id==='dinner'?5:0;
const price=(s,id,pick)=>priceAtAge(s.age,id,pick);
const eventFor=kind=>kind==='interest'?'pastime_interest':kind==='callback'?'pastime_callback':kind==='pet'?'pastime_pet_choice':'pastime_scene';
function row(s,id,label,description,days=0,cost=0,reason){return{id:`pastime_${id}`,label,description,days:0,cost:0,durationDays:days,quotedCost:cost,timeDescription:days?`${days} days`:'No day passes.',group:'Everyday life',...(reason||s.hero.gold<cost?{disabledReason:reason||`Requires ${cost} gold.`}:{})};}

function initializePastimes(s,{reset=false}={}){
 if(reset||s.pastimes===undefined)s.pastimes={version:1,startedDay:s.day,activeInterestId:null,interests:{},pet:null,petHistory:[],uses:{},history:[],facts:[],project:null,pending:null,callbacks:[]};
}
function pastimeActions(s){
 if(!s.pastimes||blocked(s))return[];const p=s.pastimes;
 if(p.project)return[row(s,'continue',`Continue: ${p.project.title}`,'Return to the same unfinished afternoon.',p.project.remainingDays,p.project.cost-p.project.paidCost,s.locationId!==p.project.locationId?'Return to where you began.':undefined),row(s,'abandon','Set this activity aside','Keep the days already spent and leave the afternoon unfinished.')];
 if(p.pending)return[];
 const a=[];if(s.age>=4)a.push(row(s,'interest',p.activeInterestId?'Choose what interests you now':'Find something you enjoy','Books, music, a little garden, drawings, stories or a crownstones board.'));
 if(s.age<4||!isSettlement(s.world,s.locationId))return a;
 const limit=(id,n=1)=>uses(s,id)>=n?'Leave room for other afternoons this year.':undefined;
 if(p.activeInterestId)a.push(row(s,'practice',`Spend time ${INTERESTS[p.activeInterestId].name.toLowerCase()}`,'Something for yourself, away from examinations and wages.',3,0,limit('practice',3)));
 if(s.age>=6)a.push(row(s,'fair','Visit the traveling fair','Lanterns, puppets and borrowed luck.',2,s.age>=18?3:0,limit('fair',2)));
 if(s.age>=7&&!p.pet)a.push(row(s,'pet','Visit the animal rescue keeper','See whether your household has room for a creature.',2,0,s.age<18&&!caregiver(s)?'Meet with your caregiver first.':limit('pet')));
 if(p.pet?.alive)a.push(row(s,'petcare',`Make time for ${p.pet.name}`,'A bowl, a brush, and a familiar presence.',1,0,s.locationId!==p.pet.locationId?`Return to ${s.world.locations.find(l=>l.id===p.pet.locationId)?.name||'their home'}.`:limit('petcare',4)));
 if(s.education?.enrolled){
  if(s.age>=8)a.push(row(s,'club','Spend an afternoon with the school club','Rehearsals, secrets and the question of who belongs.',2,0,!peer(s)?'There is nobody from your own age group here.':limit('club',2)));
  if(s.age>=10){a.push(row(s,'prank','Find out what the pupils are plotting','There are footsteps in the corridor.',1,0,!peer(s)?'Meet another pupil here first.':limit('prank')));a.push(row(s,'revision','Join a revision afternoon','Decide what sort of preparation you want.',3,0,limit('revision',2)));}
  if(s.age>=12&&s.age<18)a.push(row(s,'skip','Spend a lesson day your own way','The school bell is ringing. Your name is on the register.',2,0,!peer(s)?'Meet another pupil here first.':limit('skip')));
 }
 if(s.age>=12)a.push(row(s,'games','Visit the gaming table','Crownstones and cards, stories and small stakes.',1,0,limit('games',2)));
 if(s.age>=14&&s.age<18)a.push(row(s,'night','Make plans after curfew','Someone has brought a lantern.',2,0,!peer(s)?'Meet someone your own age here first.':limit('night')));
 if(s.age>=16&&s.age<18)a.push(row(s,'crush','Spend time with someone you like','There may be more to an ordinary invitation.',2,0,!peer(s)||peer(s)?.familyRole?'An unrelated person your own age must be here.':limit('crush')));
 if(s.age>=18){a.push(row(s,'dinner','Invite people to supper','Make room at the table for the lives around yours.',2,5,!companion(s)?'Meet someone here to invite.':limit('dinner',2)));if(p.activeInterestId&&['music','storytelling','sketching'].includes(p.activeInterestId))a.push(row(s,'performance','Share what you have been making','Ask for a place in a little hall.',2,0,limit('performance',2)));}
 return a;
}
function sceneId(s,id){if(id==='pet')return'pet_arrival';if(id==='petcare')return'pet_care';const group=id==='practice'?s.pastimes.activeInterestId:id;const pool=Object.keys(SCENES).filter(k=>k.startsWith(`${group}_`));return pool[seededRoll(s.seed,`pastime:${ownerId(s)}:${s.age}:${group}:${uses(s,id)}`,pool.length)];}
function setScene(s,id,ctx){
 const key=sceneId(s,id),d=SCENES[key];if(!d)return false;
 const person=id==='crush'||['club','prank','skip','night'].includes(id)?peer(s):companion(s);
 s.pastimes.pending={kind:id==='pet'||id==='petcare'?'pet':'scene',sceneId:key,actionId:id,actorIds:person?[person.id]:[],day:s.day,age:s.age};
 const name=person?.name||(id==='performance'?'a listener':'your neighbor');let body=d.body(name);
 if(id==='pet'&&s.age<18)body=`${caregiver(s).name} came with you to the rescue keeper. ${body}`;
 if(id==='petcare')body=body.replace('Your animal',s.pastimes.pet.name);
 ctx.setEvent(eventFor(s.pastimes.pending.kind),d.title,'An ordinary afternoon',body,d.choices.map(c=>({...c,...(id==='games'&&c.id==='coins'&&s.hero.gold<2?{disabledReason:'Requires two gold.'}:{})})));return true;
}
function applyPastimeAction(s,id,ctx){
 if(!id.startsWith('pastime_')||!s.pastimes)return false;
 const selected=pastimeActions(s).find(a=>a.id===id);if(!selected||selected.disabledReason)return false;
 if(id==='pastime_continue')return continueWork(s,ctx);
 if(id==='pastime_abandon'){const p=s.pastimes.project;s.pastimes.project=null;note(s,ctx,'An unfinished afternoon',`You left ${p.title.toLowerCase()} where it was, with ${p.completedDays} day${p.completedDays===1?'':'s'} already spent.`);return true;}
 if(id==='pastime_interest'){s.pastimes.pending={kind:'interest',sceneId:'interest',actionId:'interest',actorIds:[],day:s.day,age:s.age};ctx.setEvent('pastime_interest','Something that is yours','Personal interests','What draws your attention when nobody is telling you what to become?',Object.entries(INTERESTS).map(([id,d])=>choice(id,d.name,d.description)));return true;}
 return setScene(s,id.slice('pastime_'.length),ctx);
}
function addCallback(s,kind,actorIds,days,pick){if(s.pastimes.callbacks.some(c=>c.kind===kind&&c.resolved===false))return;const id=`${kind}:${s.day}:${s.pastimes.history.length}`;s.pastimes.callbacks.push({id,kind,actorIds:[...actorIds],dueDay:s.day+days,createdDay:s.day,pick,resolved:false});s.pastimes.callbacks=s.pastimes.callbacks.slice(-40);}
function complete(s,pr,ctx){
 const id=pr.actionId,pick=pr.pick,name=actor(s,pr.actorIds[0])?.name||'the person who spent that afternoon with you',aid=pr.actorIds[0];
 let body='The afternoon slipped into the ordinary shape of your life.';let happy=2,stress=-1;
 if(id==='practice'){
  const hobby=s.pastimes.interests[pr.interestId];const old=hobby.level;hobby.practiceDays+=pr.totalDays;hobby.level=Math.min(8,Math.floor(hobby.practiceDays/6));hobby.lastPracticeDay=s.day;if(hobby.level>old)gain(s,INTERESTS[pr.interestId].skill,hobby.level-old);
  body={manuscripts:`You left another set of small notes between the pages.`,sketching:pick==='redo'?'There is another likeness beneath the first.':pick==='share'?'Your drawing has found a place on somebody else’s wall.':'The drawing stayed folded inside your notebook.',music:pick==='together'?'The tune has an ending you would never have written alone.':pick==='quiet'?'The instrument waited beside the window. You came back to it in the morning.':'By the third evening the reed no longer squealed.',gardening:pick==='pull'?'A new row of hardy herbs covers the disturbed earth.':pick==='share'?'Two sets of hands worked the little patch.':'Each evening you looked for the smallest change.',storytelling:pick==='private'?'You kept one story for an audience that already understood it.':'The tale changed in the telling; one listener stayed after everyone else left.',strategy:pick==='concede'?'You looked at the familiar pieces differently when the next game began.':'You played until the worn pieces cast long shadows.'}[pr.interestId];
  if(aid)remember(s,aid,`We spent time with ${INTERESTS[pr.interestId].name.toLowerCase()}.`,pick==='together'||pick==='share'||pick==='rewrite'?3:1);
  if(['sketching','storytelling'].includes(pr.interestId))addCallback(s,'keepsake',pr.actorIds,20,pick);
 }else if(id==='pet'){
  if(pick==='wait'){body='The keeper closed the baskets. You can come back in another year.';}
  else if(s.age<18&&!caregiver(s)){body='The keeper left the basket beside the warm stove. With nobody from your household there to make the arrangement, the animal stayed in their care.';happy=0;}
  else{const def=PETS[pick],serial=s.pastimes.petHistory.length,id=`pet-${ownerId(s)}-${serial}-${s.day}`;const age=1;const bornDay=s.day-age*365,deathDay=bornDay+(def.years+seededRoll(s.seed,`${id}:life`,def.range))*365;
   s.pastimes.pet={id,name:def.names[seededRoll(s.seed,`${id}:name`,def.names.length)],species:pick,bornDay,deathDay,introducedDay:s.day,age,alive:true,bond:30,health:90,lastCareDay:s.day,neglectNotedDay:null,locationId:pr.locationId,caregiverId:s.age<18?caregiver(s)?.id||null:null};body=`${s.pastimes.pet.name} inspected the threshold, then crossed it. That evening you learned the sound of their footsteps.`;happy=6;fact(s,`pet:${id}`);}
 }else if(id==='petcare'){
  const pet=s.pastimes.pet;if(!pet?.alive){body='You returned to the place where your companion used to wait.';happy=0;}else{pet.lastCareDay=s.day;pet.neglectNotedDay=null;pet.health=clamp(pet.health+12);pet.bond=clamp(pet.bond+(pick==='teach'?5:8));body=pick==='walk'?`${pet.name} found a hundred things worth smelling or watching. You took the long way home.`:pick==='groom'?`${pet.name} fell asleep while you worked the last burr free.`:`${pet.name} remembered the familiar signal before you had finished making it.`;happy=5;}
 }else if(id==='fair'){body=pick==='keep'?'The black pebble stayed warm in your pocket long after the fair lamps went out.':pick==='perform'?'Someone laughed behind the curtain. It was enough to make the next line easier.':pick==='repair'?'Your fingers still smelled of paste when the procession began.':'You came home carrying a tune you had not known that morning.';if(pick==='keep')fact(s,'fair:black-pebble');if(aid)remember(s,aid,'We went to the traveling fair.',3);}
 else if(id==='club'){body=pick==='inside'?`${name} folded the little membership paper with your name on it. The waiting pupil had already gone.`:pick==='four'?'The paper tore a little beneath the fourth name. Nobody suggested crossing it out.':pick==='outside'?'Your new club met on the other side of the same wall.':pick==='cover'?'By evening your voice stumbled between two different roles. The missing player’s costume still waited on their chair.':pick==='wait'?'The teacher closed the school gate and came looking with you. You asked at the communal hearth first.':'The players put their costumes away. They agreed to rehearse again another afternoon.';const memory={inside:'We both belonged to the little club behind the wall.',four:'You made room for the fourth pupil.',outside:'You began a second club with the waiting pupil.',cover:'You learned the missing player’s lines as well as your own.',wait:'You asked the teacher to help find the missing player.',cancel:'You asked us to wait for the player who had not come.'}[pick];remember(s,aid,memory,pick==='inside'?4:2);fact(s,`club:${pick}`);addCallback(s,'club',pr.actorIds,35,pick);}
 else if(id==='prank'){const slate=pr.sceneId==='prank_1';body=pick==='join'?(slate?'The tutor found two ridiculous spiders on the slate. You stood beside the first artist when the questions began.':`You and ${name} ran until you could not hear the bell. Someone else was called into the tutor’s room.`):pick==='name'?`${name} stood very still while you spoke to the tutor.`:slate?'The slate was clean when the tutor entered. One pupil gave you a quick look across the room.':'The tutor rang the bell and began the lesson. One pupil gave you a quick look across the room.';remember(s,aid,pick==='join'?'You joined in when I played the school prank.':pick==='name'?'You named me when the tutor asked who played the prank.':'You put the schoolroom right without naming me.',pick==='join'?7:pick==='name'?-8:2);if(s.education&&pick==='join')s.education.performance=clamp(s.education.performance-4);fact(s,`prank:${pick}`);addCallback(s,'prank',pr.actorIds,15,pick);}
 else if(id==='skip'){body=pick==='return'?'Your place in the lesson was still empty when you entered. You took it.':pick==='cover'?`${name} kept to the agreed story. Later, the tutor asked which errand had taken all afternoon.`:'For a while there was no bell, no register, and no reason to hurry. The next morning your place on the slate had a mark beside it.';if(s.education&&pick!=='return')s.education.performance=clamp(s.education.performance-(pick==='cover'?7:4));remember(s,aid,'We decided what to do when the lesson bell rang.',pick==='return'?0:5);fact(s,`school-absence:${pr.startedAge}:${pick}`);if(pick!=='return')addCallback(s,'absence',pr.actorIds,7,pick);}
 else if(id==='revision'){body=pick==='copy'?'The familiar answers came easily. A question asked a different way still stopped you.':pick==='alone'?'You put the other pupils’ advice aside. Your own notes acquired fresh ink.':'You worked through the questions that had frightened you until you could explain your answers.';if(s.education){s.education.performance=clamp(s.education.performance+(pick==='copy'?1:4));if(pick!=='copy'&&s.education.preparationsThisYear<2){s.education.preparationsThisYear++;s.education.progress++;gain(s,'scholarship');}}fact(s,`revision:${pick}`);if(pick==='copy')addCallback(s,'answers',pr.actorIds,30,pick);stress=pick==='copy'?2:-4;}
 else if(id==='games'){if(pick==='coins'){const win=seededRoll(s.seed,`wager:${pr.startedDay}:${ownerId(s)}`,4)===0;if(win)s.hero.gold+=4;body=win?'The dealer counted four gold into your hand. Their smile did not change.':'The dealer swept your two gold beneath the table and invited the next player.';happy=win?5:-2;}else body=pick==='story'?`${name} told the table a story you had never heard them tell before.`:'You watched the hand, then the sleeve, and left while you still had your money.';if(pick==='story')remember(s,aid,'We played for stories instead of coins.',4);}
 else if(id==='night'){const caught=pick==='sneak'&&seededRoll(s.seed,`curfew:${pr.startedDay}:${ownerId(s)}`,3)!==0;body=pick==='stay'?'You made a little world on the dry side of the threshold.':pick==='ask'?'Your caregiver listened, then found a second lantern.':caught?'A lamp was waiting in the window when you returned. Your caregiver had not gone to bed.':`You and ${name} brought home a song neither of you had known before.`;if(s.family)s.family.support=clamp(s.family.support+(pick==='ask'?3:caught?-6:0));remember(s,aid,'We made plans beyond the household curfew.',pick==='stay'?2:5);if(caught)addCallback(s,'curfew',pr.actorIds,10,pick);fact(s,`curfew:${caught?'caught':pick}`);}
 else if(id==='crush'){const accepted=seededRoll(s.seed,`crush:${aid}:${ownerId(s)}`,4)!==0,item=pr.sceneId==='crush_0'?'book':'ribbon';body=pick==='tell'?(accepted?`${name} smiled before finding an answer. You walked home more slowly than usual.`:`${name} looked down at the ${item} and said they had meant friendship. You still walked home together.`):pick==='friend'?`${name} kept the ${item} close and joined you on the ordinary road home.`:'You left the invitation where it was. The next conversation began with something else.';remember(s,aid,pick==='tell'?(accepted?'We admitted a first affection.':'We spoke about affection and kept the friendship.'):'We left room to decide what our friendship meant.',pick==='tell'&&accepted?8:2);fact(s,`first-affection:${aid}:${pick==='tell'?(accepted?'shared':'friendship'):pick}`);}
 else if(id==='dinner'){body=pick==='listen'?`${name} spoke until the candles were short. The food was cold by then; nobody complained.`:pick==='small'?'You made room for a quieter meal. The evening did not need to belong to everybody.':'The chairs filled. For once you could hear three conversations without being responsible for all of them.';remember(s,aid,'There was a place for me at your table.',6);addCallback(s,'supper',pr.actorIds,30,pick);happy=6;}
 else if(id==='performance'){body=pick==='invite'?'By the end, the voice in the room was no longer yours alone.':pick==='stop'?'You put your work away and stayed to talk. The hallkeeper left the lamp burning.':'You gave the ending the time it needed. One listener stayed to thank you.';gain(s,'persuasion');happy=5;fact(s,`performance:${pick}`);}
 wellbeing(s,happy,stress);note(s,ctx,SCENES[pr.sceneId].title,body);ctx.completedActionId=`pastime_${id}`;
}
function continueWork(s,ctx){
 const pr=s.pastimes.project;if(!pr)return false;if(s.phase==='retired'){s.pastimes.project=null;return true;}
 if(s.locationId!==pr.locationId)return false;
 const owed=pr.cost-pr.paidCost;if(owed>s.hero.gold)return false;
 // Reserve the agreed fee before provision costs accrue. A zero-day pause
 // returns the reservation immediately and cannot charge an unstarted outing.
 if(owed>0){s.hero.gold-=owed;pr.paidCost=pr.cost;}
 const outdoors=['fair','night'].includes(pr.actionId)||pr.actionId==='practice'&&pr.interestId==='gardening'||pr.actionId==='skip'&&pr.pick!=='return';
 const remaining=pr.remainingDays;const actual=Math.max(0,Math.min(remaining,ctx.spendDays(remaining,{outdoors,night:pr.actionId==='night'?true:s.flags?.travelByNight})||0));
 if(actual===0&&owed>0){s.hero.gold+=owed;pr.paidCost-=owed;}
 pr.completedDays+=actual;pr.remainingDays-=actual;
 if(s.phase==='retired'){s.pastimes.project=null;return true;}
 if(pr.remainingDays===0){s.pastimes.project=null;complete(s,pr,ctx);}else s.notice=actual?`You set ${pr.title.toLowerCase()} aside when the day called you elsewhere.`:'The afternoon is waiting until the current matter is settled.';
 return true;
}
function applyPastimeChoice(s,eventId,pick,ctx){
 const p=s.pastimes?.pending;if(!p||eventId!==eventFor(p.kind))return false;
 if(p.kind==='interest'){
  if(!INTERESTS[pick]||s.age<4)return false;const returning=Boolean(s.pastimes.interests[pick]);s.pastimes.pending=null;s.pastimes.activeInterestId=pick;s.pastimes.interests[pick]||={id:pick,startedDay:s.day,practiceDays:0,level:0,lastPracticeDay:null};note(s,ctx,'Something that is yours',`You ${returning?'returned to':'began making room for'} ${INTERESTS[pick].name.toLowerCase()}.`);return true;
 }
 if(p.kind==='callback')return applyCallback(s,p,pick,ctx);
 const d=SCENES[p.sceneId];if(!d||!d.choices.some(c=>c.id===pick))return false;
 const cost=price(s,p.actionId,pick);if(s.hero.gold<cost)return false;
 s.pastimes.pending=null;s.pastimes.uses[`${p.age}:${p.actionId}`]=(s.pastimes.uses[`${p.age}:${p.actionId}`]||0)+1;
 s.pastimes.project={actionId:p.actionId,title:d.title,sceneId:p.sceneId,pick,actorIds:[...p.actorIds],interestId:p.actionId==='practice'?s.pastimes.activeInterestId:null,locationId:s.locationId,totalDays:d.days,remainingDays:d.days,completedDays:0,cost,paidCost:0,startedDay:s.day,startedAge:p.age};
 return continueWork(s,ctx);
}
function callbackBody(s,c){const name=actor(s,c.actorIds[0])?.name||'Someone who remembers the afternoon';return{prank:`${name} leaves a folded scrap from that school afternoon on your desk. For a moment neither of you speaks.`,absence:'The tutor closes the register when you enter. “I spoke with the pupils by the gate,” they say. There is a space left for your answer.',answers:'A question you memorized has returned in a different form. The old answer sounds wrong when you say it aloud.',curfew:'A lantern waits beside the door tonight. There is a note asking when you will be home.',club:`${name} unfolds an old list from your school club. There is a new name below the others, written in a hand you do not recognize.`,keepsake:`${name} has brought back something you made that afternoon. The folded corners are worn from being carried.`,supper:`${name} arrives with a bowl and asks whether there is room at the table again.`}[c.kind];}
function applyCallback(s,p,pick,ctx){
 if(!['answer','listen','leave'].includes(pick))return false;const c=s.pastimes.callbacks.find(c=>c.id===p.callbackId&&!c.resolved);if(!c)return false;
 c.resolved=true;s.pastimes.pending=null;const name=actor(s,c.actorIds[0])?.name||'the person who remembered';
 const body=pick==='answer'?'You found words for something you had left unfinished. The reply was shorter than you expected.':pick==='listen'?`${name} stayed long enough to tell you their version of that day.`:'You put the reminder aside. The old afternoon stayed where you had left it.';
 if(pick!=='leave'){remember(s,c.actorIds[0],`We returned to the afternoon of ${c.kind}.`,pick==='listen'?4:2);wellbeing(s,2,-2);if(c.kind==='absence'&&s.education)s.education.performance=clamp(s.education.performance+2);}
 fact(s,`callback:${c.id}:${pick}`);note(s,ctx,'An afternoon returns',body);return true;
}
function flushPastimeEvent(s,ctx){
 if(!s.pastimes||blocked(s)||s.pastimes.project||s.pastimes.pending)return false;
 const c=s.pastimes.callbacks.find(c=>!c.resolved&&c.dueDay<=s.day);if(!c)return false;
 // A dead or departed pupil does not materialize to hand over a keepsake.
 if(c.actorIds.length&&!c.actorIds.some(id=>actor(s,id))){c.resolved=true;return false;}
 s.pastimes.pending={kind:'callback',sceneId:c.kind,callbackId:c.id,actionId:'callback',actorIds:[...c.actorIds],day:s.day,age:s.age};
 ctx.setEvent('pastime_callback','An afternoon returns','A remembered day',callbackBody(s,c),[choice('answer','Speak about what happened'),choice('listen','Hear their version first'),choice('leave','Leave the old day alone')]);return true;
}
function onPastimeTime(s,{oldDay,newDay},ctx){
 const p=s.pastimes;if(!p)return;const pet=p.pet;
 if(pet?.alive){pet.age=Math.max(0,Math.floor((Math.min(newDay,pet.deathDay)-pet.bornDay)/365));
  if(newDay>=pet.deathDay){pet.alive=false;const record={...pet,endedDay:pet.deathDay,cause:'old age'};p.petHistory.push(record);p.petHistory=p.petHistory.slice(-20);p.pet=null;wellbeing(s,-8,4);note(s,ctx,'The quiet place by the door',`${pet.name} died after ${pet.age} years. For days, you still listened for the familiar footsteps.`);}
  else if(newDay-pet.lastCareDay>=90&&pet.neglectNotedDay===null){const guardian=s.age<18&&actor(s,pet.caregiverId);if(guardian&&(!guardian.locationId||guardian.locationId===pet.locationId)){pet.lastCareDay=newDay;}else{pet.neglectNotedDay=newDay;pet.health=clamp(pet.health-12);pet.bond=clamp(pet.bond-6);note(s,ctx,'A bowl beside the door',`${pet.name} has been waiting while your days filled with other things. Their familiar place beside you feels farther away.`);}}
 }
 if(s.phase==='retired')p.project=null;
 // Uses are bounded per actual age and remain distinct across birthdays.
 for(const key of Object.keys(p.uses))if(Number(key.split(':')[0])<s.age-3)delete p.uses[key];
}
function pastimeEventIds(){return{pastime_interest:Object.keys(INTERESTS),pastime_scene:[...new Set(Object.values(SCENES).flatMap(d=>d.choices.map(c=>c.id)))],pastime_pet_choice:['cat','hound','raven','wait','walk','groom','teach'],pastime_callback:['answer','listen','leave']};}
function pastimeView(s){
 const p=s.pastimes;if(!p)return{enabled:false,age:s.age,hobbies:[],pet:null,petHistory:[],history:[],facts:[],availableActions:[],commitment:null,summary:'There is time yet to find what you enjoy.'};
 const pet=p.pet?{...p.pet,species:PETS[p.pet.species].name,description:p.pet.health<80?'A familiar companion who needs a little more of your time.':p.pet.bond>=65?'They know the sound of your return before you reach the door.':'They are learning the shape of your days.'}:null;
 return{enabled:true,age:s.age,activeInterestId:p.activeInterestId,summary:s.age<4?'Your first years belong to the people keeping you safe.':Object.keys(p.interests).length?'Not every afternoon needs to become a qualification.':'What do you enjoy when nobody is directing your future?',hobbies:Object.values(p.interests).map(h=>({...h,name:INTERESTS[h.id].name,description:INTERESTS[h.id].description,progress:h.practiceDays%6,lastPlayed:h.lastPracticeDay,active:h.id===p.activeInterestId})),pet,petHistory:p.petHistory.map(h=>({...h,species:PETS[h.species].name})),history:p.history.map(h=>({...h})),facts:[...p.facts],commitment:p.project?{title:p.project.title,completedDays:p.project.completedDays,totalDays:p.project.totalDays,remainingDays:p.project.remainingDays,locationId:p.project.locationId}:null,availableActions:pastimeActions(s)};
}
function inheritPastimes(parent,child){
 initializePastimes(child,{reset:true});const pet=parent.pastimes?.pet;
 if(pet?.alive&&pet.deathDay>child.day){child.pastimes.pet={...pet,age:Math.max(0,Math.floor((child.day-pet.bornDay)/365)),bond:Math.min(40,pet.bond),caregiverId:child.age<18?caregiver(child)?.id||null:null};child.pastimes.facts.push(`inherited-pet:${pet.id}`);}
 // An heir keeps the animal, not their parent's learned hobbies or private afternoons.
}
function actionScene(actionId,key,interestId){return actionId==='pet'?key==='pet_arrival':actionId==='petcare'?key==='pet_care':actionId==='practice'?!!INTERESTS[interestId]&&key.startsWith(`${interestId}_`):['fair','club','prank','skip','revision','games','night','crush','dinner','performance'].includes(actionId)&&key.startsWith(`${actionId}_`);}
const ACTIVITY_LIMITS={practice:3,fair:2,pet:1,petcare:4,club:2,prank:1,skip:1,revision:2,games:2,night:1,crush:1,dinner:2,performance:2};
function ageAllowed(actionId,age){return age>=({practice:4,fair:6,pet:7,petcare:0,club:8,prank:10,skip:12,revision:10,games:12,night:14,crush:16,dinner:18,performance:18}[actionId]??999)&&(!['skip','night','crush'].includes(actionId)||age<18);}
function validatePastimes(v,s){
 try{
  if(v===undefined)return true;if(!plain(v)||v.version!==1||!int(v.startedDay)||v.startedDay>s.day||!(v.activeInterestId===null||Object.hasOwn(INTERESTS,v.activeInterestId))||!plain(v.interests)||!plain(v.uses)||!Array.isArray(v.history)||v.history.length>100||!Array.isArray(v.petHistory)||v.petHistory.length>20||!Array.isArray(v.facts)||v.facts.length>200||new Set(v.facts).size!==v.facts.length||!v.facts.every(f=>text(f,300))||!Array.isArray(v.callbacks)||v.callbacks.length>40)return false;
  for(const[id,h]of Object.entries(v.interests))if(!INTERESTS[id]||!plain(h)||h.id!==id||!int(h.startedDay)||h.startedDay>s.day||!int(h.practiceDays,100000)||!int(h.level,8)||h.level!==Math.min(8,Math.floor(h.practiceDays/6))||!(h.lastPracticeDay===null||int(h.lastPracticeDay)&&h.lastPracticeDay>=h.startedDay&&h.lastPracticeDay<=s.day))return false;
  if(v.activeInterestId!==null&&!v.interests[v.activeInterestId])return false;
  if(!Object.entries(v.uses).every(([id,n])=>{const[year,activity]=id.split(':');return /^\d{1,3}:(practice|fair|pet|petcare|club|prank|skip|revision|games|night|crush|dinner|performance)$/.test(id)&&int(n,ACTIVITY_LIMITS[activity])&&Number(year)<=s.age&&ageAllowed(activity,Number(year));}))return false;
  if(!v.history.every(h=>plain(h)&&int(h.day)&&h.day<=s.day&&int(h.age,300)&&h.age<=s.age&&text(h.title,200)&&text(h.text)))return false;
