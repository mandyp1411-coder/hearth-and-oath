  if (state.life?.lifestyle === 'comfortable') level += 5; else if (state.life?.lifestyle === 'generous') level += 10;
  if (state.life?.partnerId) level += 6;
  if ((state.life?.children || []).some(c => c.alive !== false)) level += 4;
  if (b?.debt > 0) level -= 8;
