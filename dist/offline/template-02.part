          ],
          "costs": {
            "days": 4,
            "gold": 35,
            "rations": 3
          },
          "result": "The widow stops raiding this route for one bounded season.",
          "consequence": "Food stock falls; named suppliers and protected travelers remember the cost.",
          "requires": [
