}

return {ENEMY_ATLASES,ENEMY_DESCRIPTIONS,ENEMY_SPECIES,enemyDisplayName,enemyEncounterTerrains,enemyIllustration,enemySpeciesPool,identifyEnemy,proceduralEnemies,renderEnemyPortrait,validEnemyIllustration};
