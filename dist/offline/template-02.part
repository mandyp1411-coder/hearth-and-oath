function randomizeCreatorDraft(previous) {
  const base=normalizeCreatorDraft(previous),locked=new Set(base.creatorLocks);
  if(Object.keys(CREATOR_LOCKS).every(k=>locked.has(k)))return base;
  const roll=freshSeed(),seed=locked.has('fate')?base.seed:roll;
  // A locked dependent choice keeps its ancestry compatible; a locked family
  // keeps its origin because the household is generated from that origin.
  const keepRace=locked.has('ancestry')||locked.has('heritage')||locked.has('origin')||locked.has('portrait')||locked.has('fate');
  const ancestry=keepRace?base.appearance.ancestry:generateCharacter(roll,'creator').appearance.ancestry;
  const originId=locked.has('origin')||locked.has('fate')?base.originId:'random';
  const fate=rollLifeCircumstances(seed,originId,ancestry),pronouns=locked.has('pronouns')?base.pronouns:rollLifeCircumstances(roll,originId,ancestry).pronouns;
  let appearance=locked.has('portrait')?base.appearance:generateCharacter(roll,'creator',{ancestry,pronouns,age:base.startAge,heritage:locked.has('heritage')?effectiveHeritage(base.appearance).id:undefined}).appearance;
  if(locked.has('heritage')&&effectiveHeritage(appearance).id!==effectiveHeritage(base.appearance).id)appearance=assignHeritage(appearance,effectiveHeritage(base.appearance).id,roll);
  return normalizeCreatorDraft({...base,...fate,seed,name:base.name,nameChoice:base.nameChoice,nameRoll:0,originId,ancestryChoice:locked.has('ancestry')?base.ancestryChoice:'fate',identityChoice:locked.has('pronouns')?base.identityChoice:'fate',heritageChoice:locked.has('heritage')?base.heritageChoice:'fate',portraitChoice:locked.has('portrait')?base.portraitChoice:'fate',pronouns,appearance});
}
function randomizeCreatorPortrait(previous){
 const d=normalizeCreatorDraft(previous),rows=availablePortraits(d,d.startAge),current=portraitContext(d,d.startAge),key=d.appearance.portraitSelections?.[current.stage],other=rows.filter(p=>p.key!==key),choices=other.length?other:rows;
 if(!choices.length)return d;
 return selectCreatorPortrait(d,choices[Math.floor(Math.random()*choices.length)].key);
}
function toggleCreatorLock(previous,key){const d=normalizeCreatorDraft(previous);if(!Object.hasOwn(CREATOR_LOCKS,key))return d;return {...d,creatorLocks:d.creatorLocks.includes(key)?d.creatorLocks.filter(k=>k!==key):[...d.creatorLocks,key]};}
function creatorDependencyChanges(before,after){
 const changes=[];
 if(before.appearance.ancestry!==after.appearance.ancestry){
  changes.push('Portrait and available heritages now follow '+ancestryLabel(after.appearance.ancestry)+'.');
  if(before.heritageChoice!==after.heritageChoice)changes.push('The former heritage is unavailable; heritage returns to fate.');
  if(before.originId!==after.originId)changes.push((originById(before.originId)?.label||'The former origin')+' is unavailable; origin returns to fate.');
 }
 if(before.startAge!==after.startAge){
  const removed=before.personalityTraits.filter(id=>!after.personalityTraits.includes(id));
  if(removed.length)changes.push('Traits removed for this age: '+removed.map(id=>personalityTrait(id)?.name).join(', ')+'.');
  if(attributePointsSpent(before.attributePoints)!==attributePointsSpent(after.attributePoints))changes.push('Assigned bonuses were reduced to fit the '+attributePointBudget(after.startAge)+' point age budget.');
  if(portraitContext(before,before.startAge).stage!==portraitContext(after,after.startAge).stage)changes.push('The portrait now shows the selected age stage. Choices for other stages remain saved.');
 }
 return changes;
}
function selectCreatorPortrait(previous,key) {
  const d=normalizeCreatorDraft(previous),appearance=selectPortrait(d.appearance,key,{age:d.startAge,identity:d.seed});
  return appearance?normalizeCreatorDraft({...d,appearance,portraitChoice:'chosen'}):d;
}
function selectCreatorHeritage(previous,id) {
  const d=normalizeCreatorDraft(previous);return heritageById(id,d.appearance.ancestry)?normalizeCreatorDraft({...d,heritageChoice:id,creatorLocks:[...new Set([...d.creatorLocks,'heritage'])]}):d;
}

function rollCreatorName(previous){const d=normalizeCreatorDraft(previous);return normalizeCreatorDraft({...d,nameChoice:'fate',nameRoll:d.nameRoll+1});}
function toggleCreatorTrait(previous,id){const d=normalizeCreatorDraft(previous),t=personalityTrait(id);if(!t)return d;const ids=d.personalityTraits;if(ids.includes(id))return normalizeCreatorDraft({...d,personalityTraits:ids.filter(k=>k!==id)});if(ids.length>=3||ids.includes(t.opposite)||traitPoints(ids)+t.cost>traitPointBudget(d.startAge))return d;return normalizeCreatorDraft({...d,personalityTraits:[...ids,id]});}
function adjustCreatorAttribute(previous,key,delta){const d=normalizeCreatorDraft(previous);if(!STARTING_ATTRIBUTES.includes(key)||![1,-1].includes(delta))return d;const n=d.attributePoints[key]+delta;if(n<0||n>6||delta>0&&attributePointsSpent(d.attributePoints)>=attributePointBudget(d.startAge))return d;return {...d,attributePoints:{...d.attributePoints,[key]:n}};}
function selectCreatorOrigin(previous,id){const d=normalizeCreatorDraft(previous);if(id!=='random'&&(d.ancestryChoice==='fate'||!availableOrigins(d.appearance.ancestry).some(o=>o.id===id)))return d;return normalizeCreatorDraft({...d,originId:id,creatorLocks:id==='random'?d.creatorLocks.filter(k=>k!=='origin'):[...new Set([...d.creatorLocks,'origin'])]});}

function op(label,command,id='',className='secondary',disabled=false){return `<button type="button" class="button ${className}" data-op="${command}" data-id="${e(id)}"${disabled?' disabled':''}>${label}</button>`;}
function ancestryLabel(value){return AVATAR_OPTIONS.find(field=>field.key==='ancestry').options.find(option=>option.value===value)?.label??'Human';}
function renderCreatorOriginOptions(value) {
  const d=normalizeCreatorDraft(value),rows=[{id:'random',label:'Cast by Fate',sigil:'✦',description:d.ancestryChoice==='fate'?'Let fate choose your ancestry and its beginning. Choose an ancestry above to select one of its stories.':'Begin with an unexpected story among your people.'},...(d.ancestryChoice==='fate'?[]:availableOrigins(d.appearance.ancestry))];
  return `<input type="hidden" name="originId" value="${e(d.originId)}">`+rows.map((o,index)=>`<button type="button" class="creator-origin${d.originId===o.id?' is-selected':''}" data-op="creator-origin" data-id="${o.id}" aria-label="${index+1}. ${e(o.label)}" aria-pressed="${d.originId===o.id}"><span class="origin-sigil" aria-hidden="true">${index+1}</span><span><strong>${e(o.label)}</strong><small>${e(d.startAge===0?(o.birthDescription??o.description):o.description)}</small>${o.communityName?`<small class="origin-community">${e(o.communityName)}</small>`:''}</span></button>`).join('');
}
function renderCreatorPortraitControls(value) {
  const d=normalizeCreatorDraft(value);
  const budget=attributePointBudget(d.startAge),spent=attributePointsSpent(d.attributePoints);
  return `${renderTraitPicker(d.personalityTraits,d.startAge)}<section class="attribute-allocation" aria-label="Starting ability points"><div class="section-heading"><h3>Attribute Points</h3><span class="badge" data-attribute-points>${budget-spent} / ${budget} available</span></div><p>Assign points to Strength, Agility, Vitality, Intellect, Willpower and Presence. More points are available when you begin at an older age. Any points you leave unspent are distributed by fate when you enter this life.</p><div class="attribute-buy-list">${STARTING_ATTRIBUTES.map(key=>`<div class="attribute-buy-row"><span><strong>${ATTRIBUTE_LABELS[key]}</strong><small>${{strength:'Weapon power and physical work',agility:'Initiative, stealth and movement',vitality:'Health and endurance',intellect:'Magic, study and craft',willpower:'Resolve and spiritual practice',presence:'Persuasion and leadership'}[key]}</small></span><button type="button" class="button ghost small" data-op="creator-attribute" data-id="${key}:-1" aria-label="Remove one ${ATTRIBUTE_LABELS[key]} point" aria-describedby="attribute-limit-${key}" ${d.attributePoints[key]?'':'disabled'}>−</button><output aria-label="${ATTRIBUTE_LABELS[key]} bonus">+${d.attributePoints[key]}</output><button type="button" class="button secondary small" data-op="creator-attribute" data-id="${key}:1" aria-label="Add one ${ATTRIBUTE_LABELS[key]} point" aria-describedby="attribute-limit-${key}" ${spent>=budget||d.attributePoints[key]>=6?'disabled':''}>+</button><small class="attribute-limit" id="attribute-limit-${key}">${d.attributePoints[key]>=6?'Maximum six assigned points.':spent>=budget?(d.startAge<3?'Assigned points begin at age 3.':'No points remain in this age budget.'):'You can add a point.'}${d.attributePoints[key]?'':' No assigned point to remove.'}</small></div>`).join('')}</div><p class="small-copy">${d.startAge<3?'A newborn begins without assigned bonuses.':'These bonuses add to the abilities earned in your earlier years. Each attribute can receive up to six assigned points. Shown bonuses are assigned additions, not the final totals from your lived history.'}</p></section>`;
}
// This is a new-life draft choice only. Prehistory is generated under Standard
// rules; the app attaches secure metadata at the guarded first-save boundary.
function renderLifeMode(d) {
  return `<section class="creator-life-mode" aria-labelledby="life-mode-label"><label class="field" for="life-mode"><span class="field-label" id="life-mode-label">Life mode</span><select id="life-mode" name="lifeMode"><option value="standard"${d.lifeMode==='standard'?' selected':''}>Standard</option><option value="ironman"${d.lifeMode==='ironman'?' selected':''}>Ironman (combat permadeath)</option></select></label>${d.lifeMode==='ironman'?'<p>Combat death ends this life. Party deaths are permanent.</p>':'<p class="small-copy">Standard keeps the usual save and recovery options.</p>'}</section>`;
}
function renderCharacterCreator(value, requestedStep=0, {notice='',canUndo=false,error='',busy=false,slotSummary=''}={}) {
  const d=normalizeCreatorDraft(value),step=Math.max(0,Math.min(2,Number(requestedStep)||0));
  const portrait=renderAvatar({id:'creator',name:d.name,pronouns:d.pronouns,appearance:d.appearance},{size:'hero',age:d.startAge});
  const races=AVATAR_OPTIONS.find(field=>field.key==='ancestry').options;
  const heritage=effectiveHeritage(d.appearance),heritages=availableHeritages(d.appearance.ancestry);
  return `<section class="creator-screen" aria-label="Create a new life"><div class="creator-topline"><div class="creator-history-controls"><button type="button" class="button ghost creator-undo" data-op="creator-undo" aria-label="Undo last change" title="Undo last change"${!canUndo||busy?' disabled':''}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M9 5 4 10l5 5M4 10h10a6 6 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>${op('‹ Title screen','title-menu','','ghost small',busy)}</div><span class="eyebrow">HEARTH &amp; OATH · A NEW LIFE</span>${op('Settings','creator-settings','','ghost small',busy)}</div><nav class="creator-steps" aria-label="Character creation steps">${creatorStepTitles.map((label,i)=>`<button type="button" class="creator-step${i===step?' is-current':''}" data-op="creator-step" data-id="${i}"${i===step?' aria-current="step"':''}${busy?' disabled':''}><span>${i+1}. ${e(label)}</span><span class="sr-only">${i===step?', current step':i<step?', completed step':''}</span></button>`).join('')}</nav><p class="sr-only" data-creator-notice role="status" aria-live="polite"${notice?'':' hidden'}>${e(notice)}</p><p class="creator-error" data-creator-error role="alert"${error?'':' hidden'}>${e(error)}</p><p data-creation-progress role="status" aria-live="polite">${busy?'Drawing your life. Please wait.':'Draft only · nothing is saved until Begin This Life.'}</p><form id="character-form" data-creator-step="${step}"${busy?' aria-busy="true" inert':''}><div class="creator-workspace"><aside class="creator-portrait"><div class="creator-portrait-stage portrait-stage" data-avatar-preview>${portrait}</div><div class="creator-plate-caption"><span class="eyebrow">A FACE AMONG THE FORGOTTEN</span><h2 data-preview-name>${e(d.name)}</h2><small class="portrait-roll-help">Choose a whole illustrated portrait, or leave the face to fate.</small>${op('Choose portrait','creator-portraits','','secondary small')}</div><div class="creator-age"><label for="start-age" class="creator-age-label"><span>Begin at age</span><output id="start-age-value" for="start-age start-age-number" data-start-age>${d.startAge}</output></label><input id="start-age" name="startAge" type="range" min="0" max="${maxStartAge(d.appearance.ancestry)}" step="1" value="${d.startAge}" aria-describedby="start-age-description"><label class="field age-precise" for="start-age-number">Exact age<input id="start-age-number" type="number" inputmode="numeric" min="0" max="${maxStartAge(d.appearance.ancestry)}" step="1" value="${d.startAge}" aria-describedby="start-age-description age-validation"></label><p id="age-validation" role="status"></p><div class="creator-age-marks" aria-hidden="true"><span>Birth</span><span>18</span><span>40</span>${maxStartAge(d.appearance.ancestry)>65?`<span>65</span><span>${maxStartAge(d.appearance.ancestry)}</span>`:`<span>${maxStartAge(d.appearance.ancestry)}</span>`}</div><p id="start-age-description" data-age-description>${e(startingAgeDescription(d.startAge))} ${d.startAge} years of history · ${attributePointBudget(d.startAge)} ability points. ${d.startAge<3?'The first years are observed through your carers; choices begin as you learn to speak.':''}</p><p class="creator-past-note">Your face changes with age. Choose a portrait for the current stage; your saved choices stay with this life.</p></div></aside><div class="creator-controls">
    <fieldset class="creator-fieldset"${step===0?'':' hidden'} aria-labelledby="creator-heading-0"><legend class="sr-only">Beginning</legend><div class="creator-intro"><span class="eyebrow">1 / BEGINNING</span><h1 id="creator-heading-0" tabindex="-1">Where the story finds you.</h1><p>Choose a beginning and the age you enter this world. The rest can belong to fate.</p></div><div class="creator-name-field"><label class="field" for="character-name"><span class="field-label">Your name</span><input id="character-name" name="name" maxlength="40" value="${e(d.name)}" autocomplete="off" required><small>${e(namingLore(d.appearance.ancestry,heritage.id).lore)}</small></label>${op('Roll a name','creator-name','','ghost small')}</div><div class="creator-identity-grid"><label class="field"><span class="field-label">Ancestry</span><select name="ancestry"><option value="fate"${d.ancestryChoice==='fate'?' selected':''}>Cast by Fate</option>${races.map(o=>`<option value="${o.value}"${d.ancestryChoice===o.value?' selected':''}>${o.label}</option>`).join('')}</select></label><label class="field"><span class="field-label">Pronouns</span><select name="identity"><option value="fate"${d.identityChoice==='fate'?' selected':''}>Cast by Fate</option>${['he/him','she/her','they/them'].map(v=>`<option value="${v}"${d.identityChoice===v?' selected':''}>${e(pronounDisplayLabel(v))}</option>`).join('')}</select></label><label class="field creator-heritage-field"><span class="field-label">Heritage</span><select name="heritageChoice"><option value="fate"${d.heritageChoice==='fate'?' selected':''}>Cast by Fate</option>${heritages.map(h=>`<option value="${h.id}"${d.heritageChoice===h.id?' selected':''}>${e(h.name)}</option>`).join('')}</select><small data-heritage-description>${e(d.heritageChoice==='fate'?'Your heritage is revealed when this life begins.':heritage.description)}</small></label></div><p class="creator-note">Each ancestry has its own beginnings and portraits. Changing ancestry updates incompatible choices. The arrow at the top left undoes the last change. Pronouns and portrait presentation are independent.</p><div class="creator-origin-grid" data-origin-options role="group" aria-label="Origin">${renderCreatorOriginOptions(d)}</div><p class="creator-note">Keep a culturally drawn name or write your own. Family, fortune and early experiences belong to fate. No calling or moral path binds your future.</p></fieldset>
    <fieldset class="creator-fieldset"${step===1?'':' hidden'} aria-labelledby="creator-heading-1"><legend class="sr-only">Character attributes</legend><div class="creator-intro"><span class="eyebrow">2 / NATURE &amp; ABILITIES</span><h1 id="creator-heading-1" tabindex="-1">A life waiting to unfold.</h1><p>Choose up to three traits, then assign your age-based attribute points.</p></div><div data-portrait-controls>${renderCreatorPortraitControls(d)}</div></fieldset>
    ${step===2?renderCreatorReview(d)+`<p class="creator-slot-summary">${e(slotSummary)}</p>${op('Choose an empty slot','creator-slots','','ghost small')}`:renderLifeMode(d)}${step<2?renderCreatorRandomControls(d):''}</div></div><footer class="creator-footer">${op(step?'‹ Beginning':'‹ Return','creator-back','','ghost')}<span class="creator-footer-note">${step===2?'Review this exact draft before saving.':'Your draft stays with you as you move between steps.'}</span>${step<2?op(step===0?'Nature &amp; Abilities →':'Review this life →','creator-step',String(step+1),'primary'):'<button type="submit" class="button primary begin-button">Begin This Life <span aria-hidden="true">→</span></button>'}</footer></form></section>`;
}

function renderCreatorRandomControls(d){return `<section class="creator-fate" aria-labelledby="creator-fate-heading"><h3 id="creator-fate-heading">Leave room for fate</h3><p>Randomize unlocked choices in your beginning. Age, traits, assigned points and a custom name stay yours. Locked dependent choices also keep their ancestry compatible.</p><div class="creator-locks" role="group" aria-label="Randomization locks">${Object.entries(CREATOR_LOCKS).map(([key,label])=>`<button type="button" class="button ghost small" data-op="creator-lock" data-id="${key}" aria-pressed="${d.creatorLocks.includes(key)}">${d.creatorLocks.includes(key)?'Locked':'Unlocked'}: ${e(label)}</button>`).join('')}</div><div class="creator-random-actions">${op('Randomize unlocked choices','creator-random','','secondary')}${op('Randomize portrait only','creator-random-portrait','','secondary')}</div></section>`;}
function renderCreatorReview(value){
 const d=normalizeCreatorDraft(value),fate=rollLifeCircumstances(d.seed,d.originId,d.appearance.ancestry),points=completeAttributePoints(d.attributePoints,d.startAge,d.seed),stage=PORTRAIT_STAGES.find(p=>p.id===portraitContext(d,d.startAge).stage),heritage=effectiveHeritage(d.appearance);
 return `<section class="creator-review" data-creator-review aria-labelledby="creator-heading-2"><span class="eyebrow">3 / REVIEW</span><h1 id="creator-heading-2" tabindex="-1">Meet the life you’ll begin.</h1><dl><dt>Name</dt><dd>${e(d.name)}</dd><dt>Age &amp; portrait stage</dt><dd>${d.startAge} · ${e(stage.label)} (${stage.max===null?stage.min+'+':stage.min+'–'+stage.max})</dd><dt>Ancestry · heritage</dt><dd>${e(ancestryLabel(d.appearance.ancestry))} · ${e(heritage.name)}</dd><dt>Beginning</dt><dd>${e(fate.originLabel)}</dd><dt>Station</dt><dd>Fate’s to decide. Most births are hard; you learn yours with your first breath.</dd><dt>Pronouns</dt><dd>${e(pronounDisplayLabel(d.pronouns))}</dd><dt>Nature</dt><dd>${d.personalityTraits.map(id=>e(personalityTrait(id)?.name)).join(', ')||'Open to experience'}</dd><dt>Ability bonuses</dt><dd>${STARTING_ATTRIBUTES.map(key=>`${ATTRIBUTE_LABELS[key]} +${d.attributePoints[key]} assigned${points[key]>d.attributePoints[key]?' / +'+(points[key]-d.attributePoints[key])+' from fate':''}`).join(' · ')}</dd><dt>Family &amp; fortune from fate</dt><dd>${e({two_parents:'Two parents',single_parent:'One present parent',orphan:'Community guardians',homeless:'A shelter guardian'}[fate.familySetup])} · ${e({poor:'Poor',tradesfolk:'Tradesfolk',noble:'Noble'}[fate.household]||'Unrecorded')} birth household. Earlier experiences and final ability totals are drawn from ${d.startAge} years of history.</dd><dt>Mode</dt><dd>${d.lifeMode==='ironman'?'Ironman — combat death ends this life; party deaths are permanent.':'Standard'}</dd></dl><p>Unspent bonuses shown above use this draft’s fixed fate. Beginning this life does not reroll your choices.</p><div class="creator-review-edits">${op('Edit beginning','creator-step','0','secondary')}${op('Edit nature &amp; abilities','creator-step','1','secondary')}${op('Edit portrait','creator-portraits','','secondary')}</div></section>`;
}

return {CREATOR_LOCKS,adjustCreatorAttribute,captureCreatorDraft,creatorDependencyChanges,creatorStepTitles,defaultCreatorDraft,normalizeCreatorDraft,randomizeCreatorDraft,randomizeCreatorPortrait,renderCharacterCreator,renderCreatorOriginOptions,renderCreatorPortraitControls,renderCreatorReview,rollCreatorName,selectCreatorHeritage,selectCreatorOrigin,selectCreatorPortrait,toggleCreatorLock,toggleCreatorTrait};
})();
const __portrait_gallery = (() => {
const { renderAvatar, portraitLayers } = __avatar;
const { PORTRAIT_LIBRARY, PORTRAIT_STAGES, portraitContext, availablePortraits, portraitEntry } = __portrait_library;
const { availableHeritages, heritageAllowsPortrait } = __heritages;
const e=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
const labels={watch:'Knights & wardens',wanderer:'Cloaks & travelers',scholar:'Scholars & mages',healer:'Healers & pilgrims',craft:'Craftspeople',performer:'Bards & performers',court:'Court & finery',field:'Workers & countryfolk',young:'Young faces',elder:'Elder faces'};
const presentationLabels={masculine:'Masculine',feminine:'Feminine',androgynous:'Androgynous'};
const PORTRAITS_PER_PAGE=24;
function portraitGalleryPage(person,{age=27,state={},currentPerson=person}={}) {
  const requested=PORTRAIT_STAGES.find(p=>p.id===state.stage),previewAge=requested?requested.min:age,realContext=portraitContext(person,age),context=portraitContext(person,previewAge),current=portraitLayers(currentPerson,{age}).preset;
  const presentation=['masculine','feminine','androgynous'].includes(state.presentation)?state.presentation:'all';
  const archetype=Object.hasOwn(labels,state.archetype)?state.archetype:'all';
  const unlocked=availablePortraits(person,previewAge),all=PORTRAIT_LIBRARY.filter(p=>p.ancestry===context.ancestry&&p.stage===context.stage);
  let filtered=(state.showLocked?all:unlocked).filter(p=>(presentation==='all'||p.presentation===presentation)&&(archetype==='all'||p.archetype===archetype));
  const pages=Math.max(1,Math.ceil(filtered.length/PORTRAITS_PER_PAGE)),page=Math.max(0,Math.min(pages-1,Number.isInteger(state.page)?state.page:0));
  const key=current.key||PORTRAIT_LIBRARY.find(p=>p.src===current.src&&p.cell===current.cell)?.key;
  return {context,current,key,previewAge,realStage:realContext.stage,unlocked:unlocked.length,locked:all.length-unlocked.length,total:filtered.length,pages,page,presentation,archetype,
    currentVisible:filtered.some(p=>p.key===key),available:all.length,rows:filtered.slice(page*PORTRAITS_PER_PAGE,(page+1)*PORTRAITS_PER_PAGE)};
}
function preview(entry,age) {
  const profile=availableHeritages(entry.ancestry).find(h=>heritageAllowsPortrait(h,entry));
  const appearance={ancestry:entry.ancestry,heritage:profile.id,heritageVersion:1,portraitPresentation:entry.presentation,preset:entry.index>=0?'p'+String(entry.index).padStart(4,'0'):'legacy',portraitSelections:{[entry.stage]:entry.key}};
  return renderAvatar({appearance},{size:'large',age}).replace('decoding="async"','decoding="async" loading="lazy"');
}
function findCurrentPortrait(person,{age=27}={}){
 const v=portraitGalleryPage(person,{age}),rows=availablePortraits(person,age),index=rows.findIndex(p=>p.key===v.key);
 return {page:index<0?0:Math.floor(index/PORTRAITS_PER_PAGE),presentation:'all',archetype:'all',showLocked:false,previewKey:null,message:index<0?'The current portrait is retained but is not a selectable entry in this stage’s gallery.':'Filters cleared. Your current portrait is shown; selection has not changed.'};
}
function renderPortraitGallery(person,{age=27,state={},reason='',canChooseHeritage=false,currentPerson=person}={}) {
 const v=portraitGalleryPage(person,{age,state,currentPerson}),h=v.context.heritage,heritages=availableHeritages(v.context.ancestry),frozen=Boolean(reason),stage=PORTRAIT_STAGES.find(s=>s.id===v.context.stage);
 const candidate=portraitEntry(state.previewKey),allowedCandidate=candidate&&candidate.ancestry===v.context.ancestry&&candidate.stage===v.context.stage&&heritageAllowsPortrait(h,candidate)&&(!v.context.wolf||candidate.morphology==='canine');
 const choices=heritages.map(profile=>`<button type="button" class="portrait-heritage${profile.id===h.id?' is-selected':''}" data-op="gallery-heritage" data-id="${profile.id}" aria-pressed="${profile.id===h.id}"${!canChooseHeritage||v.context.wolf||frozen?' disabled':''}>${e(profile.name)}</button>`).join('');
 const stages=PORTRAIT_STAGES.map(p=>`<button type="button" data-op="gallery-stage" data-id="${p.id}" aria-pressed="${p.id===v.context.stage}" class="button ghost portrait-stage-filter"><strong>${p.label}</strong><small>${p.min}${p.max===null?'+':'–'+p.max} · ${p.id===v.realStage?'Your stage':'Preview only'}</small></button>`).join('');

 return `<div class="eyebrow">THE PORTRAIT BOOK · ${e(v.context.ancestry.toUpperCase())}</div><h2>Choose your portrait</h2><p class="portrait-gallery-intro">Browsing ${stage.label} portraits · ages ${stage.min}${stage.max===null?'+':'–'+stage.max}. Your character is ${Math.floor(age)}.${v.context.stage!==v.realStage?' Preview only; selecting requires your current life stage.':''} Paintings represent a life stage. Portrait presentation is independent of pronouns.</p><div class="portrait-gallery-header"><div class="portrait-gallery-current">${renderAvatar(currentPerson,{size:'large',age})}</div><div><span class="eyebrow">CURRENT PORTRAIT · BROWSING ${e(h.name)}</span><p>${e(h.description)}</p><p class="portrait-gallery-help">Browse freely. Preview a face, then use Select Portrait to apply it. Closing this book keeps your existing portrait and heritage.</p></div></div><div class="portrait-heritages" role="group" aria-label="Heritage to browse">${choices}</div><div class="portrait-age-locks" aria-label="Portrait age stages">${stages}</div>${reason?`<p class="notice" role="status">${e(reason)}</p>`:''}<div class="portrait-gallery-filters"><label>Presentation<select data-gallery-filter="presentation"><option value="all">All faces</option>${Object.entries(presentationLabels).map(([id,label])=>`<option value="${id}"${v.presentation===id?' selected':''}>${label}</option>`).join('')}</select></label><label>Collection<select data-gallery-filter="archetype"><option value="all">All collections</option>${[...new Set(PORTRAIT_LIBRARY.filter(p=>p.ancestry===v.context.ancestry&&p.stage===v.context.stage).map(p=>p.archetype))].map(id=>`<option value="${id}"${v.archetype===id?' selected':''}>${e(labels[id])}</option>`).join('')}</select></label><button type="button" class="button ghost small" data-op="gallery-locked" aria-pressed="${Boolean(state.showLocked)}">${state.showLocked?'Hide':'Show'} heritage locks (${v.locked})</button><button type="button" class="button ghost small" data-op="gallery-clear">Clear Filters</button><button type="button" class="button secondary small" data-op="gallery-current">Find Current Portrait</button></div><p class="portrait-gallery-count" role="status" aria-live="polite">${v.total} matching · ${v.unlocked} selectable for ${e(h.name)} · ${v.available} total in this ancestry and stage. ${v.total?`${v.page*PORTRAITS_PER_PAGE+1}–${Math.min(v.total,(v.page+1)*PORTRAITS_PER_PAGE)} shown`:'No portraits match these filters.'} · Page ${v.page+1} / ${v.pages}.${v.currentVisible?'':' Your current portrait is outside these filters; it remains selected.'} ${e(state.message||'')}</p>${allowedCandidate?`<section class="portrait-candidate" aria-labelledby="portrait-preview-heading"><div>${preview(candidate,v.previewAge)}</div><div><h3 id="portrait-preview-heading" tabindex="-1">Portrait preview</h3><p>${e(labels[candidate.archetype])} · ${e(presentationLabels[candidate.presentation])} · ${stage.label}</p><p>Illustrated equipment is part of the painting.</p><button type="button" class="button primary" data-op="gallery-select" data-id="${e(candidate.key)}"${frozen||v.context.stage!==v.realStage?' disabled':''}>Select Portrait</button><button type="button" class="button ghost" data-op="gallery-cancel-preview">Back to faces</button></div></section>`:''}<div class="portrait-gallery-grid" role="group" aria-label="Available illustrated portraits">${v.rows.map(p=>{
  const allowed=heritageAllowsPortrait(h,p)&&(!v.context.wolf||p.morphology==='canine'),selected=v.key===p.key,previewed=allowedCandidate&&candidate.key===p.key,unlock=availableHeritages(p.ancestry).filter(profile=>heritageAllowsPortrait(profile,p)).map(profile=>profile.name).join(' / '),caption=`${labels[p.archetype]} · ${(p.index>=0?p.index:p.cell)+1}`;
  return `<button type="button" class="portrait-choice${selected?' is-selected':''}${allowed?'':' is-locked'}" data-op="gallery-preview" data-id="${e(p.key)}" aria-label="${e(`${caption}, ${presentationLabels[p.presentation]}${selected?', current portrait':''}${allowed?'':', requires '+unlock}`)}" aria-pressed="${Boolean(previewed)}"${!allowed||frozen?' disabled':''}>${preview(p,v.previewAge)}<span class="portrait-choice-caption">${e(caption)}</span><small>${e(allowed?selected?'Current portrait':previewed?'Previewing':presentationLabels[p.presentation]:'Locked · '+unlock)}</small></button>`;
 }).join('')||'<p class="muted">Clear filters or choose another collection or presentation.</p>'}</div><div class="portrait-gallery-pagination"><button type="button" class="button secondary small" data-op="gallery-page" data-id="${v.page-1}"${v.page===0?' disabled':''}>‹ Previous</button><span>${v.page+1} / ${v.pages}</span><button type="button" class="button secondary small" data-op="gallery-page" data-id="${v.page+1}"${v.page+1===v.pages?' disabled':''}>Next ›</button></div><p class="portrait-gallery-help">Browse any stage without changing your character’s age. Only your current age stage can be selected. Your earlier saved portrait choices remain with this life.</p><div class="modal-buttons"><button type="button" class="button secondary" data-op="close-modal">Keep Current Portrait</button></div>`;
}

return {PORTRAITS_PER_PAGE,findCurrentPortrait,portraitGalleryPage,renderPortraitGallery};
