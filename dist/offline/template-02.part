function readDisplay(storage=globalThis.localStorage){try{return normalizeDisplay(JSON.parse(storage?.getItem(key)||'{}'));}catch{return {...defaults};}}
function saveDisplay(value,storage=globalThis.localStorage){const settings=normalizeDisplay(value);try{storage?.setItem(key,JSON.stringify(settings));}catch{}return settings;}
function applyDisplay(settings,document=globalThis.document){document?.documentElement?.style?.setProperty?.('--reading-scale',String(settings.scale));document?.documentElement?.setAttribute?.('data-reading-font',settings.font);document?.documentElement?.setAttribute?.('data-reading-motion',settings.reducedMotion?'reduced':'system');}

function readWorkspace(state,storage=globalThis.localStorage){try{const v=JSON.parse(storage?.getItem(`hearth-and-oath:workspace:${state.seed}:${state.dynasty?.generation||1}`)||'null');return v&&typeof v==='object'?v:null;}catch{return null;}}
