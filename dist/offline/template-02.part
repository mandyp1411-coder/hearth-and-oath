          ],
          "costs": {
            "days": 2,
            "gold": 20
          },
          "result": "Receive a finite payment of 55 gold and a broker contact.",
          "consequence": "The affected named travelers may discover the sale; secrecy is determined by witnesses rather than automatic omniscience.",
          "requires": [
