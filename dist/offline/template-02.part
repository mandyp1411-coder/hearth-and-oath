  for(const r of a.repairAccounts||[]){
    const original=a.choices[r.index];
    if(!original||original.day>r.day||kinds[recordedDeed(a,original)]!==r.kind)continue;
    if(!a.choices.slice(r.index+1).some(c=>kinds[recordedDeed(a,c)]===r.kind&&c.day>=r.day))facts[r.kind]=false;
  }
  return facts;
}

function continuityRow(a,base){
  if(!a.choices.length||a.chapter>=3)return base;
  const f=storyDeeds(a),last=a.choices.at(-1);
  if(a.id==='two_names'){
    if(a.chapter===1&&/credited copy/.test(last.label.toLowerCase()))return [
      '{name} brings the credited copying contract. A flood has moved its crossing, and the caravan leaves tomorrow. The buyer now demands a fresh survey without paying for more field work.',
      make('Defend the limit and share the urgent correction','You record the changed crossing and both contributors. The buyer must obtain agreement before requesting more work.','share_credit'),
      make('Agree a new paid survey with both names','The extra field work has its own fee and deadline. Both surveyors keep their credit.','share_credit'),
      make('Force the colleague to finish unpaid work','You keep the buyer’s extension fee while requiring unpaid field work. A dated wage grievance remains beside the credited map.','unpaid_work'),
    ];
    if(a.chapter===1)return [
      `{name} has measured a crossing washed away since the first map. The caravan needs a corrected route before tomorrow.${f.credit?' Their original signed pages also expose your earlier claim to sole authorship.':' Your earlier signatures remain on the first account.'}`,
      make(f.credit?'Correct your claim and credit the new observations':'Compare the changed crossing together',f.credit?'You publicly correct the authorship claim and record both surveyors. The correction costs your local standing; the new crossing is documented.':'The caravan receives a newly measured crossing, signed by both surveyors. The old map remains dated in the record.',f.credit?'restore_credit':'share_credit',f.credit?{reputationCost:true}:{}),
      make('Sell a bounded inspection under your own name','You check only the section you personally inspected and state the limits. The original fieldworker’s account remains available.','bounded_inspection'),
      make('Send a false report about the rival’s new route','You invent a fault in their new route. The buyer suspends the rival’s work; the measured crossing can still expose your allegation.','false_report'),
    ];
    const grievance=f.unpaid?'The archive hearing now includes the colleague’s unpaid-work tally. The survey’s shared credit remains on the map.':f.falseReport?'The new crossing measurements contradict the false report you sent. The hearing names your disputed allegation and preserves the measurement beside it.':f.suppressed?'The patron has withheld the account you paid to suppress. The archive now requires its original pages, including every maker’s signature.':f.credit?'The permanent archive requests the original signed field pages. Your claim to their authorship is still unresolved.':'The ferry archive needs one dated account of the changed crossing. Both surveyors bring their earlier pages; the keeper will preserve disagreement as well as corrections.';
    return [grievance+' {name} asks what the next caravan should be allowed to read.',
      f.unpaid?make('Pay the arrears and keep both names','You pay the recorded arrears and preserve the colleague’s credited work. The archive records the wage grievance and its settlement.','pay_arrears'):
        make(f.credit||f.falseReport?'Correct your claim before the public archive':'File both accounts beside a joint correction',f.credit||f.falseReport?'You correct the exact disputed claim. The named maker’s account is restored; the public correction costs your own local standing.':'The archive keeps the old disagreement and the new measured crossing, with both contributors named.',f.credit||f.falseReport?'restore_credit':'share_credit',f.credit||f.falseReport?{reputationCost:true}:{}),
      make(f.unpaid?'Fund an independent wage review':'Pay for an independent archive review',f.unpaid?'An independent reviewer examines the unpaid-work account. Paying for the review does not itself settle the wages.':'An independent reviewer keeps the original pages and disputed claims distinct. You pay for the review rather than selling a verdict.','independent_review',{review:true}),
      make('Use the patron to exclude the rival’s account','The keeper restricts the archive under pressure. The surviving pages and any unsettled wage or authorship grievance remain outside your control.','exclude_archive'),
    ];
  }
  if(a.id==='own_key'){
    if(a.chapter===1)return [
      `{name} has won a new commission and needs a reference before its deadline. The patron asks whether their methods may belong to their own practice.${f.credit?' Their dated contributions still contradict the sole credit you claimed.':' Your earlier agreement already credits both contributions.'}`,
      make(f.credit?'Restore their authorship and endorse their practice':'Endorse their independent practice with a clear limit',f.credit?'You correct the authorship record at a cost to your local standing. The new commission belongs to its maker.':'Your reference names only the work you observed. The new practice keeps control of its own methods and time.',f.credit?'restore_credit':'independent_reference',f.credit?{reputationCost:true}:{}),
      make('Compete through a separate paid commission','You complete your own paid contribution and keep each maker’s credit separate. The buyer can choose between independent practices.','share_credit'),
      make('Reserve the teaching record and control who may learn','You restrict access to the teaching record. Existing authorship credits remain written; the grievance is exclusion from the archive.','exclude_archive'),
    ];
    return [
      `{name} returns with a learner of their own. The next workbench needs permission to copy the old teaching record.${f.archive?' Your restriction still blocks access; that restriction did not erase the names already on the work.':f.credit?' The original maker’s missing credit must also be addressed.':' The earlier contributions remain separately credited.'}`,
      make(f.credit?'Restore authorship and open the teaching record':'Open the record to independent learners',f.credit?'The correction costs your local standing and restores the maker’s name. Independent learners receive an agreed copy.':'You attend the copying work and agree access at the existing workbench. Each learner keeps control of their own future.',f.credit?'restore_credit_access':'restore_access',f.credit?{reputationCost:true}:{}),
      make('Fund an independent copy without owning the new school','You pay for a separately held copy. Each practice keeps its own prices and names; the original archive’s restrictions remain recorded.','independent_copy',{review:true}),
      make('Retain exclusive control of the archive','You pay to maintain the restricted archive. The other learners keep their own account of exclusion. The existing credits remain visible while access is denied.','exclude_archive'),
    ];
  }
  if(a.id==='night_door'){
    if(a.chapter===1)return [
      `Winter fuel now limits the existing room to one more week. {name} brings the hosts’ proposed rota.${f.route?' The traveler also brings the private route you sold; that disclosure is still a separate grievance.':' The earlier room agreement did not purchase the traveler’s future service.'}`,
      make(f.route?'Release the sold route and agree a limited shelter rota':'Agree a shelter rota with an end date',f.route?'You release the private route and fund the agreed week. The household chooses what may be recorded afterward.':'The hosts fund one agreed week and name when their shifts end. They promise no endless unpaid care.',f.route?'release_route':'shelter_limit'),
      make('Offer paid work with hours and an end date','The traveler accepts a bounded paid contribution. The room and work agreements remain separate.','paid_work'),
      make('Require unpaid service in exchange for shelter','You make shelter conditional on unpaid service. The household records the imposed shifts and the hours it worked.','unpaid_work'),
    ];
    return [
      `The gatekeeper is leaving, and the hosts must choose who controls the existing door.${f.unpaid?' Their tally lists the unpaid service you required.':f.route?' The sold route remains in the gate account.':f.gate?' Your exclusive admission rule is still disputed.':' The winter agreement has reached its recorded end.'} {name} brings a proposed charter covering the hosts’ existing rooms and agreed rota.`,
      make(f.unpaid?'Pay the shelter arrears and open the shared door':'Agree a shared door with willing hosts',f.unpaid?'You pay the service arrears and attend the charter work. The existing room opens under a rota the hosts can end.':'You fund supplies and attend the charter work for the existing room. Hosts keep a limited rota and travelers keep their private routes.',f.unpaid?'pay_arrears':'open_gate'),
      make('Run the existing rooms as a private inn','The hosts agree prices and boundaries for their existing rooms. Buying a room never buys its guest’s service.','priced_door'),
      make('Buy the patron’s exclusive admission charter','You pay for control of the existing door. Refused households retain the account of the restriction and seek other hosts.','exclude_gate'),
    ];
  }
  return base;
}

function chapterTerms(a,pick,row){
  const option=row[ids.indexOf(pick)+1];
  if(option.terms)return {...option.terms};
  if(a.contentVersion!==4)return {days:{care:6,enterprise:4,coercion:3}[pick],cost:pick==='care'?8+a.chapter*8:0,reward:pick==='enterprise'?24+a.chapter*18:pick==='coercion'?60+a.chapter*30:0,bond:pick==='care'?8:pick==='enterprise'?2:-18,standing:option.reputationCost||/costs your reputation/.test(option.outcome)?-3:pick==='care'?3:pick==='coercion'?-5:0,career:option.reputationCost||/costs your reputation/.test(option.outcome)?-5:pick==='care'?5:pick==='enterprise'?2:-12,skill:pick==='care'?1:0,visit:false};
  const [days,cost,reward]=schedules[a.id][Math.min(a.chapter,2)][ids.indexOf(pick)];
  const terms={days,cost,reward,bond:pick==='care'?6:pick==='enterprise'?2:-14,standing:pick==='care'?2:pick==='enterprise'?0:-4,career:pick==='care'?3:pick==='enterprise'?2:-8,skill:pick==='care'?1:0,visit:false};
  if(a.id==='child_other_road'){terms.standing=0;terms.bond=pick==='coercion'?-18:pick==='care'?4:1;}
  if(option.reputationCost){terms.standing=-3;terms.career=-5;terms.bond=10;}
  if(option.review){terms.reward=0;terms.bond=2;terms.standing=0;terms.career=0;}
  if(/^(pay|buy|fund|purchase)\b/i.test(option.label))terms.cost=Math.max(terms.cost,4);
  if(a.id==='two_names'&&a.chapter===2&&pick==='care'&&storyDeeds(a).unpaid)terms.cost=18;
  if(a.id==='night_door'&&a.chapter===2&&pick==='care'&&storyDeeds(a).unpaid)terms.cost=22;
  // Only hands-on work needs the recorded site; letters and bounded agreements do not.
  terms.visit=(a.id==='winter_commons'&&a.chapter===0&&pick==='care')||(a.id==='cracked_mark'&&a.chapter<2&&pick==='care')||(a.id==='festival_hollow_lantern'&&a.chapter===1&&pick==='care');
  return terms;
}

function captureStoryRow(a,base){
  const row=continuityRow(a,base);
  return [row[0],...row.slice(1).map((option,i)=>({...option,deed:recordedDeed(a,{...option,id:ids[i]}),terms:chapterTerms({...a,contentVersion:4},ids[i],row)}))];
}

function validStoryTerms(t){
  const integer=(n,min,max)=>Number.isSafeInteger(n)&&n>=min&&n<=max;
  return t&&integer(t.days,1,14)&&integer(t.cost,0,1000)&&integer(t.reward,0,1000)&&integer(t.bond,-25,25)&&integer(t.standing,-20,20)&&integer(t.career,-25,25)&&integer(t.skill,0,2)&&typeof t.visit==='boolean';
}

return {captureStoryRow,chapterTerms,continuityRow,recordedDeed,storyDeeds,validStoryTerms};
})();
const __companion_dialogue_v27 = (() => {
// Five distinct decisions for each companion. Names and past choices are saved in the scene.
const COMPANION_DIALOGUE_V27 = {
 mira:[
  ['The Letter with No Address','{companion} has written a letter to a sister who left the old household. They do not know where she lives. Three drafts call her foolish; a fourth says only, “There is a seat if you want one.” {companion} folds that draft very carefully. They ask you to help decide what can be sent without making a stranger’s whereabouts a debt.',
   'You help write an invitation that can be declined. {companion} sends it through a willing courier; no answer is invented.',
   'You pay a courier for delivery within a stated route. {companion} earns a copyist’s fee without selling the sister’s private destination.',
   'You buy the household correspondence from a creditor. {companion} learns you have made somebody’s uncertainty a source of leverage.'],
  ['A Reply That Is Not a Return','A short reply arrives: a drawing of two boots, one patched, and the words “Still walking.” There is no address and no promise to return. {companion} laughs at the boots, then becomes angry at how much the paper matters. The keeper in {place} offers to put a notice on a public board.',
   'You keep the reply private and let {companion} answer without demanding a return. The patched boots become a shared joke.',
   'You arrange paid courier work so future letters can travel safely. The service gains an honest route; the reply remains private.',
   'You publish the drawing as a missing-person notice against its author’s wishes. The public board remembers who supplied it.'],
  ['The Door They Could Choose','A small room near {place} is vacant. {companion} wants to leave a key with a neighbor, rather than keep the room waiting for one particular person forever. “A door,” they say, “ought to work for somebody.” The neighbor wants to know whose permission a guest would need.',
   'You prepare a shared shelter with the neighbor. A guest may refuse questions about their route; {companion} keeps a key without owning the guest.',
   'You prepare a small paid lodging agreement. Its prices and private rooms are recorded, and the courier work pays for linen.',
   'You reserve the room for favored petitioners and sell access to its key. {companion} remembers the people turned away.'],
  ['Someone at the Borrowed Hearth','A traveler uses the room and leaves an excellent stew, a terrible song, and a complaint about the chimney. Nobody recognizes them as the person in the old letter. {companion} almost asks you to investigate, then asks instead who should repair the chimney.',
   'You repair the chimney with the people who use the room. {companion} accepts a useful home without forcing it to become a reunion.',
   'You commission a paid repair and share the ledger. The lodging income supports the work without selling the guest list.',
   'You sell the guest list to the creditor. A practical repair is paid for with a private confidence; the traveler changes their route.'],
  ['A Seat Kept, a Life Continued','The original letter is worn at its folds. {companion} has new work and new friends in {place}; the missing address remains missing. They want to keep the invitation, and to stop standing every evening beside a door.',
   'You support an independent shelter rota. {companion} chooses when to travel with you and when to keep their own hearth.',
   'You divide the lodging work under an honest agreement. {companion} keeps their earnings and the freedom to leave the party.',
   'You insist their room and correspondence serve your household alone. {companion} closes the argument by leaving your circle; the invitation is theirs.'],
 ],
 orrin:[
  ['The Copy Nobody Ordered','{companion} carries a translation nobody commissioned. The official copy says a buried bell rang for a dead king; a fisher’s version says it rang for soup. The second version makes {companion} laugh. They want to know why the archive kept only one.',
   'You compare the two accounts with their living readers. {companion} preserves the disagreement instead of choosing a prestigious truth.',
   'You sell a clearly credited edition with both readings. The modest fee pays the copyist rather than buying an exclusive history.',
   'You sell the court the fisher’s name as a troublesome witness. {companion} keeps the unaltered translation and remembers the betrayal.'],
  ['The Learner Who Misread a King','A learner quotes the soup version at a formal lesson in {place}. The teacher is furious; the other learners cannot stop laughing. {companion} asks whether the mistake should be corrected in public, privately, or turned into a profitable scandal.',
   'You help the learner explain the actual source. The laughter becomes a lesson in competing evidence, with no invented insult.',
   'You arrange a paid evening lecture with the teacher’s permission. The learner keeps credit for asking the awkward question.',
   'You sell a caricature naming the learner and the teacher. The scandal earns coin while closing the learner’s next classroom door.'],
  ['An Archive with Two Keys','The archive offers {companion} a room for public lessons if a patron receives the only key to restricted material. The soup bell is now famous enough that visitors ask to hear it. There is no surviving bell to ring.',
   'You establish lessons that distinguish a story from an object. The school keeps both accounts and gives readers their own keys.',
   'You establish a paid translation bench with clearly limited access. Fees support copies without promising a bell that does not exist.',
   'You promise the patron exclusive control of the disputed copies. {companion} hides one honest copy outside the room.'],
  ['The Patron’s Missing Footnote','A new edition removes the fisher’s account from a footnote. {companion} finds a copy corrected by hand: “Soup is also history.” The unknown annotator has left no name. The patron asks you to help find them.',
   'You restore the competing account without pursuing its reader. {companion} records the correction and lets the marginal joke survive.',
   'You negotiate a corrected edition for a copyist’s fee. The public record changes through a contract its readers can inspect.',
   'You hunt for the annotator on the patron’s behalf. Readers stop leaving questions where the archive can see them.'],
  ['What a Teacher Can Leave','{companion} is offered a permanent teaching practice in {place}. It will take time away from the road. The old translation lies beside a new learner’s question, neither finished enough to be a monument.',
   'You support the independent teaching room. {companion} can return to the party by choice, carrying new questions rather than an owed favor.',
   'You share a paid copying practice with separate credits. The school remains usable while its teacher keeps a life outside your journey.',
   'You claim the teaching record as your exclusive property. {companion} takes the learners and leaves; owning a copy never owned its author.'],
 ],
 kest:[
  ['The Empty Place in the Rota','{companion} recognizes a watch signature on a contract in {place}. Its writer deserted after a captain sent children to carry messages through a battle. A magistrate wants a name; the household wants its missing wages. {companion} has no proof the deserter is still alive.',
   'You hear the household’s wage claim without supplying an unverified destination. {companion} trusts the distinction.',
   'You inspect the actual payroll for a negotiated fee. The wage claim stays separate from the unverified hunt.',
   'You sell the old signature as a current lead. The magistrate pays, and an unrelated household receives the first search.'],
  ['A Child’s Bad Map','A young messenger shows {companion} a route drawn from memory. It avoids every watch post and adds an enormous dog beside a very small bridge. The child asks for the route to be safe, not for praise as a scout.',
   'You test the safe portions with an adult guide and keep the child away from danger. The enormous dog becomes a warning, not an enemy you pretend to have killed.',
   'You pay an adult courier to carry messages along a checked route. {companion} can earn honest work without recruiting the child.',
   'You sell the child’s route to the watch. The search becomes easier; the child’s trust does not.'],
  ['A Road without Young Runners','The checked route could become a public courier road. The old captain wants exclusive military use. {companion} asks who will carry messages when the next conflict arrives, and who may say no.',
   'You establish an adult courier rota with a right to refuse danger. The recorded route supports ordinary households.',
   'You establish a paid route with explicit adult contracts. The courier’s wages and safe stopping places enter the ledger.',
   'You grant the captain exclusive control of the route. {companion} keeps a private record of the households the contract excludes.'],
  ['The Signature Comes Back','The payroll returns with a correction: the captain had signed for wages never paid. The missing deserter’s name is crossed out as “unavailable,” not “dead.” {companion} wants to use the proof without inventing a triumphant reunion.',
   'You carry the verified wage claim to the public court. The household receives a hearing about a real unpaid account.',
   'You negotiate a limited settlement and document the deductions. The record stays available to the claimants.',
   'You sell the proof back to the captain. The household’s claim survives in a copy {companion} will not surrender.'],
  ['The Watch They Can Decline','A civilian courier office offers {companion} a place. It asks for training adults, keeping wages, and refusing unsafe work. The old captain calls that cowardice. {companion} asks whether friendship means they must always remain on your road.',
   'You support the civilian office and their freedom to come and go. A route service remains, and the friendship continues by choice.',
   'You divide the courier earnings under separate contracts. {companion} has independent work and may join your journeys when available.',
   'You demand the route serve your plans alone. {companion} leaves your circle rather than repeat the captain’s command.'],
 ],
 sable:[
  ['A Bowl after Midnight','{companion} has kept a patient’s bowl warm through two missed meals of their own. They ask you to watch the lamp while they eat. The patient has fallen asleep, and the broth is so heavily peppered that both of you begin laughing very quietly.',
   'You keep the lamp and make room for the healer’s rest. The patient’s private illness stays private.',
   'You take paid relief work with an agreed end to the shift. {companion} eats a real meal while the lamp remains watched.',
   'You sell the patient’s symptoms to a collector of household debts. {companion} removes you from the private care notes.'],
  ['The Healer’s Closed Door','People knock at {companion}’s door even when the sign says they are sleeping. A neighbor offers to collect complaints about the sign. {companion} asks you to organize care without making exhaustion a test of kindness.',
   'You build a willing relief rota. Patients can ask for care while the healer can close a door and sleep.',
   'You pay for predictable relief shifts and publish the fees. Emergency care keeps a place for people unable to pay.',
   'You charge for access to the sleeping healer. The queue shrinks through exclusion, and {companion} remembers the terms.'],
  ['Linen and Limits','A vacant room in {place} could become a clinic. The donor wants their family treated before every other patient. {companion} lays clean linen over the table, then folds it back up while waiting for your answer.',
   'You establish a clinic with willing shifts and need-based access. {companion} opens the linen without owing the donor private obedience.',
   'You establish priced appointments with a protected free relief hour. The clinic ledger records what its fees actually support.',
   'You sell the donor priority over the waiting room. {companion} keeps a separate record of every patient displaced.'],
  ['The Recovery Nobody Advertised','A patient leaves the clinic able to work again, then returns with a pie nobody wants to cut first. The donor asks for a public story of the cure. {companion} says the patient has already said they want to be left out of it.',
   'You accept the pie without publishing the patient. {companion} remembers that gratitude need not become a performance.',
   'You publish the clinic’s actual work totals without names. A modest fundraiser keeps linen and relief shifts available.',
   'You publish a named cure story over the patient’s refusal. Donations arrive, and fewer households trust the private room.'],
  ['The Last Shift Is Not a Promise','The clinic can now support its own rota. {companion} wants a week away and is afraid that saying so will sound like abandoning people. Their bag contains a book, two clean shirts, and absolutely no medical notes.',
   'You arrange willing cover and protect the week away. The clinic remains usable; {companion} joins future journeys when rested.',
   'You pay a qualified relief worker under a clear contract. {companion} keeps their earnings and time beyond the clinic.',
   'You insist the healer remain available to your household alone. {companion} leaves the circle and keeps their patients’ private notes.'],
 ],
 tovin:[
  ['The Wage of an Old Company','{companion} brings a company token to {place}. The paymaster who signed it died years ago. Their living child owns a bakery, not the company. Hungry veterans want somebody to answer; {companion} wants the wage claim heard without inventing hereditary guilt.',
   'You inspect the original claim and separate the bakery from the company assets. {companion} keeps a record of what is actually owed.',
   'You arrange paid accounting work on the surviving company chest. The bakery remains an independent business.',
   'You use the token to threaten the paymaster’s child. The veterans gain coin through pressure on someone who never signed the claim.'],
  ['A Sword for the Flour Sack','A veteran offers to guard the bakery in return for supper. {companion} catches them pretending an enormous sack of flour is a sleeping dragon. It is the first laugh you have heard from them in weeks. The baker wants ordinary work, not a permanent garrison.',
   'You agree a voluntary short guard shift and let the baker set its limits. The veteran receives supper without taking the shop.',
   'You prepare a paid delivery contract with named hours. The sword becomes one tool among the bakery’s real work.',
   'You establish an armed toll at the bakery door. {companion} records that the guard arrived by invitation and stayed through force.'],
  ['Straps before Standards','A room could teach young adults to mend straps and keep a civilian watch. The old company wants it to display their standard. {companion} puts the flour-dragon drawing on the wall instead, waiting to see whether you take it down.',
   'You establish a repair workshop and a voluntary watch school. No learner owes service to the old standard.',
   'You establish a paid equipment practice with credited makers. The school publishes wages and an end to each contract.',
   'You reserve the room for the company’s clients. The standard returns; {companion} keeps the drawing in a private drawer.'],
  ['The Chest’s Actual Contents','The company chest is opened at last. It holds a little coin, a great deal of mold, and a commander’s letter blaming the dead paymaster for everything. {companion} wants the limited assets shared without pretending they can settle every loss.',
   'You record the contents and divide the verified wage share publicly. The unpaid remainder stays an honest claim.',
   'You negotiate a limited settlement with each willing claimant. No signature promises money the chest does not contain.',
   'You keep the best contents by threatening the claimants. {companion} copies the inventory before you close the lid.'],
  ['A Watch for Ordinary Doors','The workshop offers {companion} civilian work. It involves repairing hinges, training willing adults, and watching doors whose owners may tell the watch to leave. The old commander calls it an embarrassing retirement.',
   'You support the civilian practice. {companion} keeps independent work and can choose the road without a commander’s permission.',
   'You share the repair earnings under clear credits. The workshop remains useful without becoming your private company.',
   'You demand a personal armed retinue instead. {companion} leaves the circle, taking the inventory and the flour-dragon drawing.'],
 ],
 vesper:[
