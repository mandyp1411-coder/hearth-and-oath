  {
    "id": "farm_neighbour_voice",
    "role": "neighbour",
    "voice": "blunt",
    "lines": [
      {
        "id": "ditch",
        "text": "The ditch takes both our fields if it takes either. I wish the stone between us understood that."
      },
      {
        "id": "boots",
        "text": "I can tell which row you walked by the clay on your boots. The lower end needs a drain."
      },
      {
        "id": "spring",
        "text": "My father waited for swallows before sowing. He was wrong three years in five, but never stopped saying it."
      },
      {
        "id": "seed",
        "text": "I have seed enough for the field. Having enough left for supper troubles me."
      },
      {
        "id": "market",
        "text": "The buyer says the grain is damp. Yesterday he said the road was dry. It is always weather when he names the price."
      },
      {
        "id": "due",
        "text": "The reeve counted my purse twice. I thought of asking whether he expected it to breed."
      },
      {
        "id": "ox",
        "text": "The ox knows when I am angry. He stands still and lets me use up the words."
      },
      {
        "id": "water",
        "text": "A full ditch is a fine thing until it climbs the doorstep."
      },
      {
        "id": "work",
        "text": "Give me a plain no before a kind answer that never comes with a spade."
      },
      {
        "id": "boundary",
        "text": "A stone is easy to move. A name in this village takes longer."
      },
      {
        "id": "winter",
        "text": "The little one asked why the chest has a lock. I said mice. It was an easier answer."
      },
      {
        "id": "hope",
        "text": "I want one winter with a sound roof and dry lower beds. The court can keep its titles."
      },
      {
        "id": "memory",
        "text": "I remember who came when the water rose. I remember who stood at the gate as well."
      },
      {
        "id": "quiet",
        "text": "Sometimes I work the last row after dark. Nobody can ask me for anything there."
      },
      {
        "id": "heir",
        "text": "Tell the child where the ditch runs. We leave enough quarrels without leaving that one."
      }
    ],
    "source": "content/farmer/dialogue.json"
  },
  {
    "id": "farm_spouse_voice",
    "role": "spouse",
    "voice": "warm",
    "lines": [
      {
        "id": "chest",
        "text": "Tell me what stays in the chest before you tell me what the buyer offered."
      },
      {
        "id": "fire",
        "text": "Sit while the fire is awake. The field has had your whole day."
      },
      {
        "id": "love",
        "text": "I can love you and think you have done a cruel thing. Do not ask me to choose which is true."
      },
      {
        "id": "promise",
        "text": "I do not need a fine promise. I need to know which words I can build the winter around."
      },
      {
        "id": "worry",
        "text": "I counted the grain again. I knew the number before opening the lid."
      },
      {
        "id": "spring",
        "text": "The first warm night smells like a year that might forgive us."
      },
      {
        "id": "neighbour",
        "text": "Our neighbour has a hungry house too. That does not make the boundary theirs."
      },
      {
        "id": "work",
        "text": "The mending is work even when nobody brings a purse home for it."
      },
      {
        "id": "market",
        "text": "Gold buys bread until the road closes. Grain is here already."
      },
      {
        "id": "ambition",
        "text": "Tell me what you want from this life. I would rather hear an unfinished answer than borrow one for you."
      },
      {
        "id": "freedom",
        "text": "I picture the reeve walking past our door without stopping. I do not know what I would do with the silence."
      },
      {
        "id": "child",
        "text": "Children hear more through a shutter than grown people think. Let them hear us speak kindly tonight."
      },
      {
        "id": "memory",
        "text": "I remember what you put aside when you wanted something badly. So do you."
      },
      {
        "id": "sea",
        "text": "If you see the sea, bring me a stone worn smooth by it. I want to hold the edge of the world."
      },
      {
        "id": "years",
        "text": "The house has changed us. I would like us to have some say in what it changes us into."
      }
    ],
    "source": "content/farmer/dialogue.json"
  }
]);
const DIALOGUES_BY_ID = freeze(Object.fromEntries(DIALOGUES.map(x => [x.id, x])));

return {DIALOGUES,DIALOGUES_BY_ID};
