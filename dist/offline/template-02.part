elected.disabledReason))}<p role="status" class="${selected.disabledReason?'disabled-reason':'small-copy'}">${e(selected.disabledReason||'Review the result and costs. Nothing is spent until you confirm.')}</p></div><p class="small-copy">${session.category==='equipment'?'Finished equipment goes into Inventory. Nothing is equipped automatically.':'Work uses the existing calendar and saved project rules.'}</p>`:'<div class="craft-empty"><span class="eyebrow">AT THE WORKBENCH</span><h4>Choose What to Make</h4><p>Inspect a design to see its result, your materials, direct fee, time and expected household accrual before beginning.</p></div>';
 return `<section class="service-meeting crafting-meeting" data-service-person="${e(r.personId)}"><div class="trade-workspace craft-workspace"><header class="trade-heading"><div class="trade-merchant">${renderAvatar(r.person,{size:'small',age:r.person.age})}<div><span class="eyebrow">THE CRAFTSPERSON’S WORKBENCH</span><h3 id="craft-heading" tabindex="-1">Craft with ${e(r.name)}</h3></div></div>${button('Back to Conversation','craft-conversation','','ghost small')}</header><div class="craft-summary"><span>Craftsmanship <strong>${v.crafting}</strong></span><span>Workbench <strong>Tier ${workshopTier(s)}</strong></span><span>Your Gold <strong>${s.hero.gold}</strong></span></div>${progress}<nav class="craft-tabs" aria-label="Crafting Categories">${CRAFTING_TABS.map(([id,label])=>button(label,'craft-category',id,`ghost small ${session.category===id?'active':''}`,false,session.category===id)).join('')}</nav><form id="craft-search" class="trade-toolbar"><label class="sr-only" for="craft-query">Search Designs</label><input id="craft-query" name="query" type="search" placeholder="Search Designs" value="${e(session.query)}">${session.category==='equipment'?`<label>Slot<select name="slot">${[['all','All Slots'],...Object.entries(SLOT_NAMES)].map(([id,label])=>`<option value="${e(id)}" ${session.filter===id?'selected':''}>${e(label)}</option>`).join('')}</select></label><label>Finish<select name="finish"><option value="plain" ${session.finish==='plain'?'selected':''}>Standard Design</option>${v.patterns.map(p=>`<option value="${p.id}" ${session.finish===p.id?'selected':''}>${e(p.name)}${p.learned?'':' · Study First'}</option>`).join('')}</select></label>`:''}<button type="submit" class="button secondary small">Find</button>${session.query||session.filter!=='all'?button('Clear search &amp; slot filter','craft-clear','','ghost small'):''}</form><div class="craft-columns"><section class="craft-catalog-pane" aria-label="Available Designs"><h4>${e(CRAFTING_TABS.find(([id])=>id===session.category)?.[1]||'Designs')} <small>${shown.length} matching of ${rows.length} designs</small></h4><div class="trade-item-grid craft-design-grid">${shown.map(a=>`<button type="button" class="trade-cell ${a.disabledReason?'untradeable':''} ${a.id===session.selected?'selected':''}" data-op="craft-item" data-id="${e(a.id)}" aria-pressed="${a.id===session.selected}" aria-label="${e(a.name+' · '+(a.cost||0)+' Gold · '+(a.days||0)+' Days'+(a.disabledReason?' · '+a.disabledReason:''))}">${art(a)}<span class="trade-item-name">${e(a.name)}</span><small>${a.cost||0}g · ${a.days||0}d${a.disabledReason?' · Locked':''}</small></button>`).join('')}</div>${shown.length?'':'<p class="small-copy">No designs match these filters. Clear the search or choose another slot or category to see its requirements.</p>'}</section><section class="craft-detail" aria-label="Selected Design">${details}</section></div><details class="craft-stock"><summary>Your Material Store</summary><div class="resource-grid">${v.materials.map(m=>`<div><span>${e(m.label)}</span><strong>${m.amount}</strong></div>`).join('')}</div><p class="small-copy">These are the same carried materials used by commissions. A Materials Merchant at the Market supplies bundles.</p></details></div></section>`;
}

return {CRAFTING_TABS,craftEquipmentComparison,craftQuote,craftRows,currentCraftSession,newCraftSession,renderCraftingWindow};
})();
const __gear_organizer_ui = (() => {
const { gearOrganizer, getGearItem, projectedEquipment } = __gear;
const { EQUIPMENT_SLOTS, SLOT_NAMES } = __gear_loot;
const { gearPreset, gearPresetFingerprint, nextGearPresetId, stageGearPreset } = __gear_organizer;
const { compareGearPreset } = __gear_comparison;
const { renderLoadoutComparison } = __equipment_comparison_ui;
function renderGearOrganizer(state,ui,{selectedId=null,reason=null}={}) {
  const {e,button}=ui,organizer=gearOrganizer(state),selected=gearPreset(state,selectedId),free=nextGearPresetId(state);
  const rows=organizer.presets.map(p=>{
    const staged=stageGearPreset(state,p.id),blocked=reason||(!staged.ok?staged.reason:null);
    return `<article class="gear-loadout-row" data-loadout-id="${e(p.id)}"><div><h3>${e(p.label)}</h3><p class="small-copy">${Object.values(p.slots).filter(Boolean).length} saved pieces${staged.issues?.length?' · '+staged.issues.length+' unavailable':''}${staged.ok&&!staged.changed?' · Equipped':''}</p></div><div class="gear-loadout-actions">${button('Preview','gear-preset-preview',p.id,'ghost small',false,selectedId===p.id)}${button('Apply','gear-preset-apply',p.id,'secondary small',Boolean(blocked)||!staged.changed)}${button('Replace','gear-preset-replace',p.id,'ghost small')}${button('Delete','gear-preset-delete',p.id,'ghost small')}</div></article>`;
  }).join('');
  let preview='';
  if(selected) {
    const result=compareGearPreset(state,selected.id),comparison=result.comparison;
    preview=`<section class="gear-loadout-detail" aria-label="Selected loadout"><h3 id="gear-loadout-heading" tabindex="-1">${e(selected.label)}</h3><form id="gear-preset-rename"><input type="hidden" name="preset" value="${e(selected.id)}"><label for="gear-preset-rename-label">Loadout name</label><input id="gear-preset-rename-label" name="label" value="${e(selected.label)}" maxlength="40" required><button type="submit" class="button secondary small">Rename</button></form>${comparison?renderLoadoutComparison(comparison,ui,{id:selected.id,label:selected.label,preset:true}):`<p class="disabled-reason">${e(result.reason)}</p><ul class="gear-loadout-issues">${result.issues.map(issue=>`<li><strong>${e(SLOT_NAMES[issue.slot])}: ${e(issue.name)}</strong> · ${e(issue.reason)}</li>`).join('')}</ul>`}${reason?`<p class="disabled-reason">${e(reason)} You can still review this arrangement.</p>`:''}</section>`;
  }
  return `<details class="gear-loadouts" data-disclosure="gear-loadouts" ${selected?'open':''}><summary>Saved Loadouts · ${organizer.presets.length}/4</summary><div class="gear-loadout-body"><p class="small-copy">Each loadout remembers every slot, including empty ones. Apply uses only the exact pieces you carry, never buys or substitutes items, and changes nothing if any piece is unavailable.</p>${rows||'<p class="small-copy">No loadouts saved yet.</p>'}${free?`<form id="gear-preset-save"><input type="hidden" name="preset" value="${e(free)}"><label for="gear-preset-new-label">Name your current equipment</label><input id="gear-preset-new-label" name="label" maxlength="40" placeholder="For example, Road kit" required><button type="submit" class="button secondary small">Save Current Equipment</button></form>`:'<p class="small-copy">All four slots are used. Replace or delete a saved arrangement to make room.</p>'}${preview}</div></details>`;
}

function renderGearPresetReview(state,review,{e,button}) {
  const preset=gearPreset(state,review?.id),current=preset&&review.expected===gearPresetFingerprint(preset),replacing=review?.kind==='replace';
  if(!current)return `<h2>Loadout changed</h2><p>This saved arrangement changed after you opened it. Nothing has been changed by this review.</p>${button('Back to Inventory','close-modal','','primary')}`;
  const now=projectedEquipment(state),changes=EQUIPMENT_SLOTS.filter(slot=>preset.slots[slot]!==now[slot]).map(slot=>`${SLOT_NAMES[slot]}: ${preset.names[slot]||'Empty'} → ${getGearItem(state,now[slot])?.name||'Empty'}`);
  return `<span class="eyebrow">SAVED EQUIPMENT ONLY</span><h2>${replacing?'Replace':'Delete'} ${e(preset.label)}?</h2><p>${replacing?'Replace this saved arrangement with what you are wearing now, including empty slots. Your currently equipped items stay unchanged.':'Delete this saved arrangement only. You keep every item and your currently equipped items stay unchanged.'}</p>${replacing?`<ul class="gear-loadout-issues">${changes.map(change=>`<li>${e(change)}</li>`).join('')||'<li>The saved slots already match your equipment.</li>'}</ul>`:''}<div class="modal-buttons">${button('Keep Saved Loadout','close-modal','','primary')}${button(replacing?'Replace Saved Loadout':'Delete Saved Loadout','gear-preset-confirm',preset.id,replacing?'secondary':'danger')}</div>`;
}

return {renderGearOrganizer,renderGearPresetReview};
})();
const __inventory_ui = (() => {
const { renderFieldPotionTreatment } = __field_treatment_ui;
const { INN_GOODS } = __hospitality_v36;
const { ownedGear, getGearItem, gearBonuses, gearScore, projectedEquipment, gearOrganizer } = __gear;
const { EQUIPMENT_SLOTS, SLOT_NAMES, itemScore, setProgress } = __gear_loot;
const { equipmentComparator } = __gear_comparison;
const { renderEquipmentComparison, bonusText } = __equipment_comparison_ui;
const { equipmentActionReason, consumableReason, fieldPotionQuote, getActions } = __engine;
const { renderAvatar } = __avatar;
const { renderGearArt: gearIllustration, renderCarriedArt } = __item_art;
const { CAMP_KITS } = __travel_energy;
const { renderGearOrganizer } = __gear_organizer_ui;
function renderGearArt(item,e=String){return gearIllustration(item,e);}
const title=s=>String(s).replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase());
const ranks={common:0,uncommon:1,rare:2,epic:3,legendary:4};
function inventoryEntries(s){
 const equipped=projectedEquipment(s),rows=ownedGear(s).map(item=>({id:'gear:'+item.id,item,kind:'equipment',name:item.name,slot:item.slot,quality:item.quality||'common',score:itemScore(item),value:item.price||0,quantity:1,favorite:gearOrganizer(s).favorites.includes(item.id),equipped:equipped[item.slot]===item.id}));
 for(const g of INN_GOODS)if(s.hospitality?.bag[g.id]>0)rows.push({id:'supply:'+g.id,kind:'supplies',name:g.name,quantity:s.hospitality.bag[g.id],value:g.price,description:g.description});
 for(const [id,n] of Object.entries(s.equipment?.materials||{}))if(n>0)rows.push({id:'material:'+id,kind:'materials',name:title(id),quantity:n,value:0,description:'Materials carried for equipment designs and workshop projects.'});
 if(s.flags?.herbs>0)rows.push({id:'supply:herbs',kind:'supplies',name:'Medicinal Herbs',quantity:s.flags.herbs,value:0,description:'Gathered herbs for available remedies and care.'});
 if(s.hero.potions>0)rows.push({id:'supply:potions',kind:'supplies',name:'Healing Potions',quantity:s.hero.potions,value:0});
 for(const pack of s.trail?.kits||[]){const kit=CAMP_KITS.find(k=>k.id===pack.kind);rows.push({id:'camp:'+pack.id,kind:'supplies',name:kit.name,quantity:1,value:0,description:pack.remaining+'/'+kit.nights+' sheltered nights remain. Make camp from the travelling screen or Recovery while on the trail. Each sheltered night restores Focus and Health and reduces Stress.'});}
 if(s.adventuring?.rations>0)rows.push({id:'supply:rations',kind:'supplies',name:'Expedition Rations',quantity:s.adventuring.rations,value:0});
 for(const l of s.adventuring?.loot||[])rows.push({id:'loot:'+l.id,kind:'loot',name:l.name,quantity:1,value:l.value||0,description:l.stolen?'Stolen goods retain their witnessed consequences. '+(l.ownerName?'Original owner: '+l.ownerName+'.':'Original owner unknown.')+' Taken at '+(s.world.locations.find(p=>p.id===l.source)?.name||l.source)+' on day '+l.day+'.':'Recovered during an actual expedition.'});
 for(const p of s.rpg?.properties||[])if(p.soldDay===null&&p.returnedDay===null)rows.push({id:'property:'+p.id,kind:'loot',name:p.label,quantity:1,value:0,description:`Acquired on day ${p.acquiredDay}. Its source and owner remain recorded.`});
 return rows;
}
function inventoryPage(s,{query='',filter='all',category='all',sort='type',selectedId=null,favoritesOnly=false}={}){
 const all=inventoryEntries(s),q=String(query).trim().toLowerCase();let rows=all.filter(r=>(!favoritesOnly||r.favorite)&&(filter==='all'||r.slot===filter)&&(category==='all'||r.kind===category)&&(!q||(r.name+' '+(r.slot||'')+' '+r.kind).toLowerCase().includes(q)));
 rows.sort((a,b)=>sort==='name'?a.name.localeCompare(b.name):sort==='value'?b.value-a.value||a.name.localeCompare(b.name):sort==='rarity'?(ranks[b.quality]||0)-(ranks[a.quality]||0)||a.name.localeCompare(b.name):sort==='score'?(b.score||0)-(a.score||0)||a.name.localeCompare(b.name):(a.slot||a.kind).localeCompare(b.slot||b.kind)||a.name.localeCompare(b.name));
 const selected=rows.find(r=>r.id===selectedId)||rows[0]||null;return {all,rows,selected};
}
function renderPlayerInventory(s,ui,options={}){
 const {e,button}=ui,v=inventoryPage(s,options),eq=projectedEquipment(s),reason=equipmentActionReason(s),bonuses=gearBonuses(s),selected=v.selected;
 const slotIcons={weapon:'⚔',offhand:'◈',head:'♜',armor:'▣',hands:'✥',feet:'♟',cloak:'◇',belt:'═',trinket:'✦',ring:'○'};
 const order=['head','armor','hands','feet','cloak','trinket','ring','belt','weapon','offhand'];
 const doll=`<section class="inventory-character" aria-label="Equipped Character"><header><h2>${e(s.hero.name)}</h2><p>Level ${s.hero.level} · ${e(s.hero.specialization||(s.hero.path==='unformed'?s.hero.profession:title(s.hero.path)))}</p></header><div class="inventory-doll"><div class="inventory-portrait">${renderAvatar(s.hero,{size:'hero',age:s.age})}</div>${order.map((slot,i)=>{const item=getGearItem(s,eq[slot]);return `<button type="button" class="inventory-equip-slot rarity-${item?.quality||'common'}" data-op="gear-slot" data-id="${slot}" data-equipment-slot="${slot}" style="grid-column:${i<5?1:3};grid-row:${i%5+1}" aria-label="${e(SLOT_NAMES[slot]+': '+(item?.name||'Empty'))}" title="${e(SLOT_NAMES[slot]+': '+(item?.name||'Empty'))}">${item?renderGearArt(item,e):`<span aria-hidden="true">${slotIcons[slot]}</span>`}<small>${e(SLOT_NAMES[slot])}</small></button>`;}).join('')}</div><dl class="inventory-stat-line"><div><dt>Health</dt><dd>${s.hero.hp}/${s.hero.maxHp}</dd></div><div><dt>Focus</dt><dd>${s.hero.mp}/${s.hero.maxMp}</dd></div><div><dt>Equipment Score</dt><dd>${gearScore(s)}</dd></div></dl><div class="inventory-bonuses">${Object.entries(bonuses).filter(([,n])=>n).map(([k,n])=>`<span>${e(title(k))} ${n>0?'+':''}${n}</span>`).join('')||'<span>No Equipment Bonuses</span>'}</div>${setProgress(ownedGear(s).filter(i=>Object.values(eq).includes(i.id))).map(set=>`<details class="inventory-set"><summary>${e(set.name)} · ${set.count} Pieces</summary>${set.thresholds.map(t=>`<p>${t.count} pieces · ${t.active?'Active':'Inactive'} · ${e(bonusText(t.bonuses))}</p>`).join('')}</details>`).join('')}${renderGearOrganizer(s,ui,{selectedId:options.presetId,reason})}</section>`;
 const categories=[['all','All Items'],['equipment','Equipment'],['supplies','Supplies'],['materials','Materials'],['loot','Loot']];
 const toolbar=`<form id="inventory-search" class="inventory-toolbar"><label class="sr-only" for="inventory-query">Search Inventory</label><input id="inventory-query" name="query" type="search" value="${e(options.query||'')}" placeholder="Search Inventory"><button class="button secondary small" type="submit">Search</button><label>Sort<select id="inventory-sort" name="sort">${[['type','Type'],['name','Name'],['rarity','Rarity'],['score','Score'],['value','Value']].map(([id,label])=>`<option value="${id}" ${(options.sort||'type')===id?'selected':''}>${label}</option>`).join('')}</select></label><label>Slot<select id="inventory-slot" name="slot">${[['all','All Slots'],...EQUIPMENT_SLOTS.map(slot=>[slot,SLOT_NAMES[slot]])].map(([id,label])=>`<option value="${id}" ${(options.filter||'all')===id?'selected':''}>${label}</option>`).join('')}</select></label></form><nav class="inventory-categories" aria-label="Inventory Categories">${categories.map(([id,label])=>button(label,'inventory-category',id,'ghost small',false,(options.category||'all')===id)).join('')}${button('★ Favorites','inventory-favorites','','ghost small',false,Boolean(options.favoritesOnly))}</nav>`;
 const cells=v.rows.map(r=>`<button type="button" class="inventory-cell rarity-${r.quality||'common'} ${r.id===selected?.id?'selected':''}" data-op="inventory-item" data-id="${e(r.id)}" data-item-id="${e(r.item?.id||r.id)}" ${r.item?`draggable="true" data-draggable-gear="${e(r.item.id)}"`:""} aria-pressed="${r.id===selected?.id}" aria-label="${e(r.name+(r.equipped?' · Equipped':'')+(r.favorite?' · Favorite':'')+(r.quantity>1?' · '+r.quantity:''))}" title="${e(r.name)}">${renderCarriedArt(r,e)}${r.quantity>1?`<small class="item-quantity">${r.quantity}</small>`:''}${r.equipped?'<span class="item-equipped" aria-label="Equipped">◆</span>':''}${r.favorite?'<span class="item-favorite" aria-hidden="true">★</span>':''}</button>`).join('');
 const empty=Array.from({length:Math.max(0,24-v.rows.length)},()=>'<span class="inventory-cell empty" aria-hidden="true"></span>').join('');
 let detail='<section class="inventory-detail"><h2 id="inventory-item-heading" tabindex="-1">Your Backpack</h2><p>Select an item to inspect it. Drag equipment into a matching slot, or choose Equip.</p></section>';
 if(selected){const r=selected,i=r.item,valuable=r.id.startsWith('loot:')?s.adventuring.loot.find(l=>l.id===r.id.slice(5)):null,propertyActions=i?.stolen?getActions(s).filter(a=>a.id==='realm_sellgear_'+i.id||a.id==='realm_returngear_'+i.id):valuable?.stolen?getActions(s).filter(a=>a.id==='realm_sellloot_'+valuable.id&&!a.disabledReason):[],comparison=i?equipmentComparator(s)(r.equipped?'unequip_'+i.slot:i.id):null;detail=`<section class="inventory-detail" data-inventory-selected="${e(r.id)}"><div class="section-heading"><h2 id="inventory-item-heading" tabindex="-1">${e(r.name)}</h2>${i?`<span class="badge">${e(title(r.quality))} · ${e(SLOT_NAMES[r.slot])}</span>`:`<span class="badge">${r.quantity} Carried</span>`}</div>${renderCarriedArt(r,e)}<p>${e(i?.description||r.description||(r.id==='supply:potions'?'Use one to restore up to 30 Health to yourself or a living active companion. Potions do not cure illnesses or revive the downed.':'Provisions for actual descents and camps.'))}</p>${i?.stolen?`<p class="small-copy inventory-provenance">Stolen property · ${e(i.provenance.ownerName?'Original owner: '+i.provenance.ownerName:'Original owner unknown')}. Taken at ${e(s.world.locations.find(p=>p.id===i.source)?.name||i.source)} on day ${i.foundDay}. Equipping it does not erase its origin.</p>`:''}${i?`<div class="inventory-bonuses">${Object.entries(i.bonuses).filter(([,n])=>n).map(([k,n])=>`<span>${e(title(k))} ${n>0?'+':''}${n}</span>`).join('')}</div><p class="small-copy">Score ${r.score} · Value ${r.value} Gold${r.equipped?' · Equipped':''}</p><div class="inventory-item-actions">${button(r.equipped?'Unequip':'Equip','equip',r.equipped?'unequip_'+i.slot:i.id,'primary',Boolean(reason))}${button(r.favorite?'★ Unfavorite':'☆ Favorite','gear-favorite',i.id,'secondary',false,Boolean(r.favorite))}${reason?`<span class="disabled-reason">${e(reason)}</span>`:''}</div><p class="small-copy">Favorites are bookmarks, not sale locks. You can still deliberately sell a favorited piece.</p>${propertyActions.length?`<div class="inventory-property-actions">${propertyActions.map(a=>`<p>${e(a.description)}</p>${button(a.label,'activity',a.id,'secondary',Boolean(a.disabledReason))}${a.disabledReason?`<p class="disabled-reason">${e(a.disabledReason)}</p>`:''}`).join('')}</div>`:''}<details class="inventory-comparison"><summary>Equipment Changes</summary>${renderEquipmentComparison(comparison,ui)}</details>`:r.id==='supply:potions'?`${renderFieldPotionTreatment(fieldPotionQuote(s),ui,{hero:true})}${(s.companions||[]).some(c=>c.recruited)?`<section class="field-party-treatment" aria-label="Choose a companion for field treatment"><h3>Treat a traveling companion</h3><p class="small-copy">Choose the named person to use one potion. Living, available active travelers only. Potions do not cure illness or stabilize the downed.</p>${s.companions.filter(c=>c.recruited).map(c=>renderFieldPotionTreatment(fieldPotionQuote(s,c.id),ui)).join('')}</section>`:''}`:['supply:herbs','supply:meals','supply:ale'].includes(r.id)?`${button(r.id==='supply:potions'?'Drink Potion':r.id==='supply:meals'?'Eat Meal':r.id==='supply:ale'?'Drink Ale':'Prepare Medicinal Herbs','use-consumable',r.id.split(':')[1],'primary',Boolean(consumableReason(s,r.id.split(':')[1])))}${consumableReason(s,r.id.split(':')[1])?`<p class="disabled-reason">${e(consumableReason(s,r.id.split(':')[1]))}</p>`:''}`:r.kind==='materials'?'<p class="small-copy">Visit a craftsperson in a settlement to use these materials.</p>':valuable?.stolen?`<p class="small-copy">Valuation ${r.value} Gold, not cash. Selling does not erase earlier evidence.</p>${!propertyActions.length?'<p class="small-copy">Visit an open Market for a current buyer and sale offer.</p>':''}${propertyActions.map(a=>`<p>${e(a.description)}</p>${button(a.label,'activity',a.id,'secondary',Boolean(a.disabledReason))}${a.disabledReason?`<p class="disabled-reason">${e(a.disabledReason)}</p>`:''}`).join('')}`:''}</section>`;}
 return `<div class="inventory-workspace" data-pack-pane="inventory"><header class="inventory-heading"><div><span class="eyebrow">WHAT YOU CARRY</span><h1>Inventory</h1></div><span class="inventory-gold">◈ ${s.hero.gold} Gold</span></header><div class="inventory-layout">${doll}<section class="inventory-backpack" aria-label="Backpack">${toolbar}<p class="small-copy" data-view-results>${v.rows.length} ${v.rows.length===1?'item':'items'} shown · ${v.all.length} carried ${v.all.length===1?'entry':'entries'}.</p><div class="inventory-grid" role="group" aria-label="Carried Items">${cells}${empty}</div>${!v.rows.length?'<p class="inventory-empty">No carried items match this view.</p>':''}${detail}</section></div></div>`;
}

return {inventoryEntries,inventoryPage,renderGearArt,renderPlayerInventory};
})();
const __shop_ui = (() => {
const { interactionChoice, meetingShell } = __interaction_ui_v40;
const { innkeeper } = __hospitality_v36;
const { renderAvatar } = __avatar;
const { inventoryEntries } = __inventory_ui;
const { renderCarriedArt } = __item_art;
const { tradeInventory, quoteTrade, shopAccessReason, tradeMerchant } = __trading;
const { equipmentComparator } = __gear_comparison;
const { renderEquipmentComparison } = __equipment_comparison_ui;
const greeting={generous:'Come in from the road. Take a look, and we will see what you can spare.',exacting:'Good tools deserve a careful eye. Set your goods on the counter and I will weigh the price.',secretive:'A quiet customer is welcome. Tell me what you need for the road.',gregarious:'There you are. Roads bring stories, but a good pair of boots brings you home.',wary:'Keep your belongings where we can both see them. Now, what do you need?',ambitious:'A small counter for now. One day I will have a house full of these goods. What can I find for you?'};
function currentShopSession(s,session){if(session?.vendor==='inn'&&!innkeeper(s)?.here)return null;const m=tradeMerchant(s,session?.vendor||'market');return session?.merchantId===m?.id&&session?.locationId===s.locationId?session:null;}
function renderMerchantMeeting(s,r,ui){
 const {e,button}=ui,vendor=r.kind==='materials'?'materials':r.subjectId||'market',session=currentShopSession(s,ui.shopSession),reason=shopAccessReason(s,vendor),mode=session?.mode||'dialogue',terms=mode==='terms';
 if(mode==='trade')return `<section class="service-meeting merchant-meeting">${renderTradeTable(s,session,ui)}</section>`;
 const line=terms?'I buy unequipped gear and honestly recovered treasure. Choose what you want and what you can offer; coins settle the difference.':vendor==='materials'?'I sell ore, cloth, timber, stone, hide and crystal in bundles of three. Choose one bundle per trade; collecting it takes one day. The work steward handles commissions.':vendor==='apothecary'?'Looking for a remedy? I have healing potions. They restore Health, though an illness still needs a doctor.':vendor==='outfitter'?'Heading out? I keep rations and camping kits. Take a look before you leave.':greeting[r.person.disposition]||greeting.wary;
 const choices=interactionChoice(ui,{label:'“What Are You Selling?”',op:'shop-browse',description:'Browse their stock and offer your own goods.',disabledReason:reason})+(terms?'':interactionChoice(ui,{label:'“What Would You Take in Trade?”',op:'shop-terms'}))+interactionChoice(ui,{label:'“Perhaps Another Time.”',op:'shop-leave',quiet:true});
 return meetingShell(s,r,ui,{className:'merchant-meeting',backLabel:'← Back to the Market',speech:'“'+line+'”',choices});
}

function renderTradeTable(s,session,ui){
 const {e,button}=ui,v=tradeInventory(s,session.vendor||'market'),draft=session.draft,q=quoteTrade(s,draft),selection=session.selected||'',side=selection.startsWith('sell:')?'sell':'buy',id=selection.slice(side.length+1);
 const carried=inventoryEntries(s),sell=carried.map(r=>({...r,...v.sell.find(i=>i.id===r.id),disabledReason:v.sell.find(i=>i.id===r.id)?.disabledReason||(!v.sell.some(i=>i.id===r.id)?'This shop does not trade for this belonging.':null)}));
 const selected=(side==='sell'?sell:v.buy).find(i=>i.id===id),count=(which,key)=>draft[which].find(i=>i.id===key)?.quantity||0;
 const matches=r=>(session.filter||'all')==='all'||r.kind===session.filter;
 const query=String(session.query||'').trim().toLowerCase(),visible=rows=>rows.filter(r=>matches(r)&&(!query||r.name.toLowerCase().includes(query)));
 const grid=(rows,which)=>{const shown=visible(rows);return `<div class="trade-item-grid" role="group" aria-label="${which==='buy'?'Shopkeeper Stock':'Your Carried Items'}">${shown.map(r=>`<button type="button" class="trade-cell rarity-${r.item?.quality||'common'} ${r.disabledReason?'untradeable':''} ${selection===which+':'+r.id?'selected':''}" data-op="shop-item" data-id="${e(which+':'+r.id)}" aria-pressed="${selection===which+':'+r.id}" aria-label="${e(r.name+' · '+(r.disabledReason||r.price+' Gold')+(count(which,r.id)?' · '+count(which,r.id)+' Offered':''))}">${renderCarriedArt(r,e)}<span class="trade-item-name">${e(r.name)}</span><small>${r.disabledReason?'—':r.price+'g'}${r.quantity>1?' · ×'+r.quantity:''}</small>${count(which,r.id)?`<span class="trade-count">${count(which,r.id)}</span>`:''}</button>`).join('')}</div>${shown.length?'':'<p class="small-copy">No items match this view.</p>'}`;};
 const quantityButton=(which,r,increase,{inspector=false}={})=>`<button type="button" class="button ${inspector?'secondary':'ghost'} small" data-op="${increase?'shop-add':'shop-remove'}" data-id="${e(which+':'+r.id)}" aria-label="${e((increase?'Increase':'Decrease')+' '+(which==='buy'?'buy':'sell')+' quantity for '+r.name+' by one'+(session.vendor==='materials'&&which==='buy'?' bundle':''))}" ${(increase&&(Boolean(r.disabledReason)||count(which,r.id)>=(which==='buy'?v.buy:v.sell).find(i=>i.id===r.id)?.quantity))?'disabled':''}>${inspector?(which==='buy'?'Request One':'Offer One'):increase?'+':'−'}</button>`;
 const offer=(which,rows)=>`<div class="trade-offer" aria-label="${which==='buy'?'Goods Requested':'Goods Offered'}"><h4>${which==='buy'?'You Receive':'You Offer'}</h4>${rows.length?rows.map(r=>`<div class="trade-offer-row"><span>${e(r.name)} <small>×${r.quantity} · ${r.price*r.quantity}g</small></span>${quantityButton(which,r,false)}${quantityButton(which,r,true)}</div>`).join(''):'<p class="small-copy">Choose items from this inventory.</p>'}</div>`;
 const inspector=selected?`<section class="trade-inspector" aria-label="Selected Item">${renderCarriedArt(selected,e)}<div><h3 id="trade-item-heading" tabindex="-1">${e(selected.name)}</h3><p>${e(selected.description||'A carried belonging.')}</p><p>${selected.disabledReason?e(selected.disabledReason):`${side==='buy'?'Asking Price':'Offered Credit'}: <strong>${selected.price} Gold</strong> · ${side==='buy'?(selected.kind==='materials'?'3 Units per Bundle · 1 Day to Collect':(selected.stock||selected.quantity)+' in stock'):selected.quantity+' carried'}`}</p>${selected.item?`<p class="small-copy">${Object.entries(selected.item.bonuses).filter(([,n])=>n).map(([k,n])=>e(k[0].toUpperCase()+k.slice(1))+' '+(n>0?'+':'')+n).join(' · ')}</p>${side==='buy'?`<details class="trade-comparison"><summary>Equipment Changes</summary>${renderEquipmentComparison(equipmentComparator(s)(selected.item.id),ui,{purchase:true})}</details>`:''}`:''}</div>${quantityButton(side,selected,true,{inspector:true})}</section>`:'<p class="trade-inspect-help">Choose an item to inspect it, then add it to the table.</p>';
 return `<div class="trade-workspace"><header class="trade-heading"><div class="trade-merchant">${renderAvatar(v.merchant,{size:'small',age:v.merchant.age})}<div><span class="eyebrow">ACROSS THE COUNTER</span><h3 id="trade-heading" tabindex="-1">Trade with ${e(v.merchant.name)}</h3></div></div><div>${button('Back to Conversation','shop-conversation','','ghost small')}</div></header><form id="shop-search" class="trade-toolbar"><label class="sr-only" for="shop-query">Search Both Inventories</label><input id="shop-query" name="query" type="search" placeholder="Search Both Inventories" value="${e(session.query||'')}"><label>Show<select name="category">${[['all','All Goods'],['equipment','Equipment'],['supplies','Supplies'],['materials','Materials'],['loot','Treasure']].map(([key,name])=>`<option value="${key}" ${key===(session.filter||'all')?'selected':''}>${name}</option>`).join('')}</select></label><button type="submit" class="button secondary small">Find</button></form><div class="trade-inventories"><section><div class="section-heading"><h4>${e(v.merchant.name)}’s Stock</h4><span class="small-copy">${session.vendor==='inn'?'Food &amp; Drink':session.vendor==='materials'?'3 Units per Bundle':'Season '+(v.merchant.season+1)}</span></div>${grid(v.buy,'buy')}${offer('buy',q.buy)}</section><section><div class="section-heading"><h4>Your Inventory</h4><span class="inventory-gold">${s.hero.gold} Gold</span></div>${grid(sell,'sell')}${offer('sell',q.sell)}</section></div>${inspector}<footer class="trade-settlement"><div class="trade-totals"><span>Goods Requested <strong>${q.buyTotal}g</strong></span><span>Your Goods <strong>${q.sellTotal}g</strong></span><span>${q.goldDue<0?'You Receive':'You Pay'} <strong>${Math.abs(q.goldDue)} Gold</strong></span><span>Gold After Trade <strong>${q.goldAfter}g</strong></span>${session.vendor==='materials'?`<span>Collection Time <strong>${q.days} Day${q.days===1?'':'s'}</strong></span>`:''}</div><div class="trade-confirm">${button('Confirm Trade','shop-confirm','','primary',Boolean(q.disabledReason))}${button('Clear Offer','shop-clear','','ghost small',!draft.buy.length&&!draft.sell.length)}</div><p class="small-copy" role="status">${e(q.disabledReason||(session.vendor==='materials'?'Choose one bundle per trade: 3 units, 1 day to collect. Goods and coins exchange together on confirmation.':'Both sides exchange together. Nothing changes until you confirm.'))}</p></footer></div>`;
}

return {currentShopSession,renderMerchantMeeting,renderTradeTable};
})();
const __world_services_ui = (() => {
