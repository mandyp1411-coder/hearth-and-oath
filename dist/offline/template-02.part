const __companion_combat_ui = (() => {
const { companionCombatProfile } = __companion_combat_profile;
const escape = value => String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

/** Render one native disclosure. Opening it is only a view, never an action. */
function renderCompanionCombatProfile(game, companion, { readinessReason = null } = {}) {
  const p = companionCombatProfile(game, companion), a = p.actor, g = p.growth;
  const growth = !g.enabled ? 'This older life uses combat rules without victory-based growth.' : g.nextAt === null ? `Growth ${g.step}/${g.max} · ${g.victories} shared victories. The existing combat-growth cap is reached.` : `Growth ${g.step}/${g.max} · ${g.victories} shared victories. Next step at ${g.nextAt} victories (${g.remaining} more).`;
  const move = m => `<p class="small-copy" data-companion-move="${escape(m.id)}"><strong>${escape(m.label)} · ${m.cost ? `${m.cost} MP` : 'Free'} · ${escape(m.kind)}</strong><br>${escape(m.description)}${m.cost > a.mp ? ' <span class="disabled-reason">Not enough current Focus.</span>' : ''}</p>`;
  return `<p class="small-copy companion-readiness" data-companion-readiness="${escape(p.readiness.code)}">${escape(p.readiness.detail)}${readinessReason ? ` <span class="disabled-reason">${escape(readinessReason)}</span>` : ''}</p><details class="companion-combat-profile" data-companion-profile="${escape(companion.id)}" data-disclosure="companion-combat-${escape(companion.id)}"><summary>Combat · ${escape(p.calling)}${g.enabled ? ` · growth ${g.step}/${g.max}` : ''}</summary><p class="small-copy"><strong>Role ${escape(p.role)} · Calling ${escape(p.calling)}</strong><br>Health ${a.hp}/${a.maxHp} · Focus ${a.mp}/${a.maxMp}<br>Attack ${p.attack} · Armor ${p.armor} · Initiative ${p.initiative} · Spell power ${p.spellPower}</p><p class="small-copy">Entry values before temporary battle effects and enemy replies; target armor, wards and resistance affect final damage. Initiative is the actual battle-order speed.</p>${p.legacyDefaults ? '<p class="small-copy">Missing legacy reserves use battle defaults for this readout only. Viewing changes no recorded resources.</p>' : ''}<p class="small-copy" data-companion-growth>${escape(growth)}${g.enabled ? ' Victories count only when this companion participated. Growth improves attack, spell attributes and periodic armor, not maximum Health, Focus or initiative.' : ''}</p><h4>Battle moves</h4>${p.moves.map(move).join('')}<h4>Chapter-earned techniques</h4>${p.techniques.length ? p.techniques.map(move).join('') : '<p class="small-copy">None learned yet. Their own recorded chapter choices can earn techniques; viewing this profile grants none.</p>'}<p class="small-copy">Shared supplies, retreat and any earned party formation remain battle commands.</p></details>`;
}

return {renderCompanionCombatProfile};
})();
const __home_ui = (() => {
const { renderResearchShelf } = __research_ui;
const { renderRepertoire } = __repertoire_ui;
const { independentHousehold } = __household_residence;
const { HOME_DEFINITIONS, householdHome } = __home_ownership;
function renderHome(s,actions,ui) {
 const {e,button,actionCards}=ui,home=householdHome(s),def=HOME_DEFINITIONS[home.tier],here=home.locationId===s.locationId,site=s.world.locations.find(p=>p.id===home.locationId);
 const essentials=actions.filter(a=>a.id==='home_rest'||a.id==='career_work'&&s.hero.profession==='Scholar'&&here);
 const time=actions.filter(a=>a.id.startsWith('lineage_nurture_')||!independentHousehold(s)&&a.id.startsWith('family_'));
 const household=[s.hero.name,...(s.life.people||[]).filter(p=>p.id===s.life.partnerId&&p.alive!==false).map(p=>p.name),...(s.life.children||[]).filter(c=>c.alive!==false).map(c=>c.name)];
 const offers=actions.filter(a=>a.id.startsWith('life_home_'));
 const records=home.legacyCottages.filter(c=>c.locationId!==home.locationId||home.tier!=='cottage');
 const listings=offers.map(a=>`<article class="home-offer"><div><h4>${e(HOME_DEFINITIONS[a.id.slice(10)].label)}</h4><p>${a.cost} Gold · ${a.days} Days</p><small>${HOME_DEFINITIONS[a.id.slice(10)].upkeep} Gold yearly upkeep</small>${a.disabledReason?`<p class="disabled-reason">${e(a.disabledReason)}</p>`:''}</div>${button('Review '+(home.owned?'Upgrade':'Purchase'),'activity',a.id,'secondary small',!!a.disabledReason)}</article>`).join('');
 return `<section class="home-overview" aria-label="Your household home"><span class="eyebrow">${home.owned?'YOUR HOME':'A PLACE OF YOUR OWN'}</span><h3>${def?e(def.label):'Your next hearth'}</h3><p class="home-address">${home.owned?here?'Here in '+e(site?.name||s.locationId):site?'In '+e(site.name):'Your earlier home has no recorded address.':'You do not own a home yet.'}</p>${def?`<p class="small-copy">${def.upkeep} Gold yearly upkeep${!here?' · Rest is available at your home’s settlement.':''}</p>`:'<p class="small-copy">Choose one home for your household. Later, move up to a townhouse or estate.</p>'}${home.owned?`<p class="home-members small-copy">Your household: ${e(household.join(', '))}. Your parents and other relatives keep their own homes.</p>`:''}${actionCards(essentials)}${renderResearchShelf(s,actions,ui)}${renderRepertoire(s,actions,ui)}<div class="home-shortcuts">${button('Family','home-family','','ghost small')}${button('Belongings','tab','inventory','ghost small')}${home.owned&&!here&&home.locationId?button('Find Home','quest-location',home.locationId,'ghost small'):''}</div>${time.length?`<details class="home-disclosure" data-disclosure="home-household"><summary>Time with your household</summary>${actionCards(time)}</details>`:''}${offers.length?`<details class="home-disclosure" data-disclosure="home-upgrades" ${!home.owned?'open':''}><summary>${home.owned?'Upgrade your home':'Choose your first home'}</summary><p class="small-copy">${home.owned?'Only larger homes are available. An upgrade replaces your household address, not your family or belongings.':'You can own one household home.'} Review the price and move before deciding.</p>${listings}</details>`:home.tier==='estate'?'<p class="home-settled small-copy">Your estate is the largest household home. No further purchase is needed.</p>':s.age<18?'<p class="small-copy">Home purchases open at eighteen.</p>':'<p class="small-copy">Finish your current moment to review homes.</p>'}${records.length?`<details class="home-disclosure" data-disclosure="home-kept-buildings"><summary>Earlier buildings</summary><p class="small-copy">These existing cottages remain in your world with their contents and benefits. No property was sold or removed.</p>${records.map(c=>`<p>${e(s.world.locations.find(p=>p.id===c.locationId)?.name||c.locationId)} · Cottage · ${e(c.condition)}</p>`).join('')}</details>`:''}</section>`;
}
function renderHomePurchase(q,ui) {
 if(!q)return '<h2>Review your home</h2>';
 const {e,button}=ui;
 return `<span class="eyebrow">${q.upgrading?'ONE HOME, A LARGER HEARTH':'YOUR FIRST HOME'}</span><h2>${q.upgrading?'Upgrade to':'Buy'} ${q.to==='Estate'?'an':'a'} ${e(q.to.toLowerCase())}?</h2><div class="home-move"><div><small>Current</small><strong>${e(q.from)}</strong>${q.upgrading?`<span>${e(q.fromPlace)}</span>`:''}</div><span aria-hidden="true">→</span><div><small>New home</small><strong>${e(q.to)}</strong><span>${e(q.toPlace)}</span></div></div><p><strong>${q.cost} Gold · ${q.days} Days</strong></p><p>${q.upkeep} Gold yearly upkeep. Ordinary living costs during the move are approximately ${q.livingCost} Gold, in addition to the price.</p><p>${q.upgrading?'This replaces your household home; it does not buy a second one. The full price applies, with no refund or trade-in credit.':'This becomes your one household home.'} Your family, belongings and existing built-property records are kept.</p>${q.disabledReason?`<p class="disabled-reason">${e(q.disabledReason)}</p>`:''}<div class="modal-buttons">${button(q.upgrading?'Confirm Upgrade':'Confirm Purchase','home-purchase-confirm',q.tier,'primary',!!q.disabledReason)}${button('Not Now','close-modal','','ghost')}</div>`;
}

return {renderHome,renderHomePurchase};
})();
const __notifications_ui_v40 = (() => {
const { notificationsFor, unreadNotifications } = __notifications_v40;
const names={letter:'Letter',gift:'Gift',health:'Health'};
function letterDate(s,n,ui){
 const m=s.conversations?.threads?.[n.personId]?.find(m=>m.id===n.sourceId),gap=s.day-n.day;
 return `Letter from ${ui.date(n.day)}${Number.isInteger(m?.age)?' · Age '+m.age:''}${gap>0?' · '+(gap>=365?Math.floor(gap/365)+' year'+(gap>=730?'s':''):gap+' day'+(gap===1?'':'s'))+' ago':''}`;
}
function renderInbox(s,ui,{selectedId,soundEnabled=true,page=0}={}){
  const {e,button,date,paragraphs}=ui,rows=notificationsFor(s),unread=unreadNotifications(s),pages=Math.max(1,Math.ceil(rows.length/20)),current=Math.max(0,Math.min(pages-1,Number.isSafeInteger(page)?page:0)),shown=rows.slice(current*20,(current+1)*20),retention=s.inbox?.retention;
  const paging=pages>1?`<nav class="inbox-paging" aria-label="Inbox pages">${button('Previous','inbox-page',String(current-1),'ghost small',current===0)}<span>Page ${current+1} of ${pages} · ${rows.length} kept</span>${button('Next','inbox-page',String(current+1),'ghost small',current===pages-1)}</nav>`:'';
  return `<header class="inbox-heading"><span class="eyebrow">LETTERS &amp; NOTICES</span><h2 id="inbox-title" tabindex="-1">Your Inbox</h2><p>${unread?unread+' Unread':'All Caught Up'}</p><div class="inbox-tools">${unread?button('Mark All Read','notice-read-all','','ghost small'):''}${button('Sound '+(soundEnabled?'On':'Off'),'notification-sound','','ghost small',false,soundEnabled)}</div></header>${paging}${retention?`<p class="inbox-retention" role="status">Earlier retention record: ${retention.olderUnread} unread and ${retention.olderRead} read notices are outside the 400-notice archive. Letter threads and original game records remain separately available; older notice text is no longer retained here.</p>`:''}<div class="inbox-list">${shown.map(n=>`<article class="inbox-entry ${n.read?'read':'unread'} ${n.id===selectedId?'open':''}"><button type="button" class="inbox-entry-open" data-op="notice-open" data-id="${e(n.id)}" aria-expanded="${n.id===selectedId}"><span class="inbox-unread-dot" aria-label="${n.read?'Read':'Unread'}"></span><span><small>${names[n.kind]} · ${e(date(n.day))}</small><strong>${e(n.title)}</strong></span><span aria-hidden="true">${n.id===selectedId?'−':'+'}</span></button>${n.id===selectedId?`<div class="inbox-letter">${n.kind==='letter'?`<p class="inbox-letter-date">${e(letterDate(s,n,ui))}${n.day<s.day?' · Kept correspondence':''}</p>`:''}${paragraphs(n.body)}${n.kind==='letter'&&n.personId?button('Find Their Recorded Place','notice-person',n.personId,'ghost small'):n.kind==='health'?button('Open Recovery','notice-recovery','','ghost small'):n.kind==='gift'?button('Open Inventory','notice-inventory','','ghost small'):''}</div>`:''}</article>`).join('')||'<div class="inbox-empty"><p>No letters or notices yet.</p><p class="muted">Letters, gifts and changes to your health will be kept here as they happen.</p></div>'}</div>`;
}
function renderNotificationToasts(rows,ui,{hidden=false}={}){
  const {e}=ui;
  // One quiet corner card at a time. The rest are already waiting in the
  // inbox; a short line says so instead of stacking cards over the page.
  const shown=rows.slice(0,1),more=rows.length-shown.length;
  const tail=more>0?`<p class="notification-toast-more"><button type="button" class="link-button" data-op="notifications">${more} more ${more===1?'notice':'notices'} in your inbox</button></p>`:'';
  return `<aside class="notification-toast-stack" aria-label="New Notifications" aria-live="polite"${hidden?' inert aria-hidden="true"':''}>${shown.map(n=>`<article class="notification-toast"><button type="button" class="notification-toast-open" data-op="notification-toast-open" data-id="${e(n.id)}"><small>${names[n.kind]}</small><strong>${e(n.title)}</strong><span>${e(n.body.length>140?n.body.slice(0,137)+'…':n.body)}</span></button><button type="button" class="notification-dismiss" data-op="notice-dismiss" data-id="${e(n.id)}" aria-label="Dismiss ${e(n.title)}">×</button></article>`).join('')}${tail}</aside>`;
}

return {renderInbox,renderNotificationToasts};
})();
const __maze_expedition = (() => {
const { mazeActions } = __maze_v31;
const { mazeMovementForecast } = __maze_rules;
const { campRecoveryView, mazeCampDescription } = __travel_energy;
/** Only carried supplies, active slots and current-room offers. No route/enemy totals. */
function mazeExpeditionView(s,actions=mazeActions(s)) {
 if(!s.maze)return null;
 const camp=campRecoveryView(s,{party:true}),active=(s.companions||[]).filter(p=>p.recruited&&p.active).slice(0,3);
 const party=[{...s.hero,id:'hero'},...active].map(p=>({
  id:p.id,name:p.name||'You',hp:p.hp,maxHp:p.maxHp,mp:p.mp,maxMp:p.maxMp,
  unavailable:camp.excluded.find(row=>row.id===p.id)?.reason||null,
 }));
 return {
  movement:mazeMovementForecast(s),party,
  kitNights:(s.trail?.kits||[]).reduce((total,kit)=>total+Math.max(0,kit.remaining),0),
  kit:camp.kit,potions:s.hero.potions||0,rations:s.adventuring?.rations||0,
  campAvailable:actions.some(a=>a.id==='maze_camp'&&!a.disabledReason),
  exitAvailable:actions.some(a=>a.id==='maze_exit'&&!a.disabledReason),
  campDescription:mazeCampDescription(s),
 };
}

return {mazeExpeditionView};
})();
const __area_scenes = (() => {
const { seededRoll } = __world;
function areaScene(state,{dungeon=null,room=null,site=null}={}) {
  site||=state.world.locations.find(p=>p.id===state.locationId);
  const terrain=site?.type||site?.id||'';
  const interior={tavern:3,shrine:4,watch:5};
  const wild=/forest|wood|wild/.test(terrain)?0:/coast|marsh|shore/.test(terrain)?1:/mountain|highland/.test(terrain)?2:null;
  const extra={workyard:0,hall:1,wayhouse:2,court:1,stronghold:1};
  const collection=!dungeon&&Object.hasOwn(extra,room?.id)?'c':!dungeon&&(Object.hasOwn(interior,room?.id)||wild!==null)?'b':'a';
  const cell=collection==='c'?extra[room.id]:collection==='b'?(interior[room?.id]??wild):dungeon?(/cistern/.test(state.maze?.sourceId||state.dungeon?.id||state.rpg?.expedition?.id||state.adventuring?.expedition?.theme||'')?3:/watchtower|citadel/.test(state.maze?.sourceId||state.dungeon?.id||state.rpg?.expedition?.id||state.adventuring?.expedition?.theme||'')?5:4):room?.id==='archive'?2:site?.type==='city'||site?.id==='city'?1:0;
  const moods=['The lanterns burn low.','Rain settles on old stone.','A draft carries the smell of smoke.','The last light gathers at the windows.'];
  const present={workyard:site?.status==='scarred'?'Scaffolds keep the damaged lane in use.':'Tools wait beside the worn benches.',hall:'Low voices carry from the long tables.',wayhouse:room?.operating?'Warm light spills from the doorway.':'The common room is quiet, and its hearth is cold.'};
  return {cell,collection,mood:present[room?.id]||moods[seededRoll(state.seed,`area-mood:${site?.id}:${room?.id||state.dungeon?.roomId||'outside'}`,moods.length)]};
}
function renderAreaScene(state,ui,options={}) {
  const {cell,mood,collection}=areaScene(state,options),site=options.site||state.world.locations.find(p=>p.id===state.locationId),title=options.dungeon?.room?.title||options.room?.name||site?.name||'The country';
  return `<figure class="area-scene" aria-label="${ui.e(title)} environment illustration"><div class="area-illustration scene-collection-${collection}" style="background-position:${cell%3*50}% ${Math.floor(cell/3)*100}%" role="img" aria-label="${ui.e(title)}"></div><figcaption><span>${ui.e(title)}</span><small>${ui.e(mood)}</small></figcaption></figure>`;
}
function settlementLayout(s) {
  const layouts=[
    {gate:[280,260],market:[140,160],tavern:[140,65],shrine:[420,160],watch:[280,350],archive:[420,65],homes:[65,260]},
    {gate:[280,345],market:[280,205],tavern:[125,210],shrine:[425,210],watch:[425,340],archive:[425,65],homes:[125,65]},
    {gate:[70,205],market:[215,205],tavern:[200,65],shrine:[355,205],watch:[85,345],archive:[470,65],homes:[455,340]},
    {gate:[280,340],market:[150,235],tavern:[75,90],shrine:[420,235],watch:[465,90],archive:[280,65],homes:[280,205]},
  ];
  const result=structuredClone(layouts[seededRoll(s.seed,'settlement-layout:'+s.locationId,layouts.length)]),candidates=[70,280,490].flatMap(x=>[55,150,245,340].map(y=>[x,y]));
  for(const id of ['workyard','hall','wayhouse','court','stronghold']){const point=[...candidates].sort((a,b)=>Math.min(...Object.values(result).map(p=>Math.hypot(p[0]-b[0],p[1]-b[1])))-Math.min(...Object.values(result).map(p=>Math.hypot(p[0]-a[0],p[1]-a[1]))))[0];result[id]=point;candidates.splice(candidates.indexOf(point),1);}
  return result;
}
function spatialMoveOffer(s,kind,id,actions) {
  if(kind==='hex') {
    const [q,r]=id.split(',').map(Number);
    const a=actions.find(a=>a.id===`atlas_step_${q}_${r}`);
    return a&&!a.disabledReason?{op:'activity',id:a.id}:null;
  }
  if(kind==='room') {
    const a=actions.find(a=>a.id==='atlas_room_'+id);
    return a&&!a.disabledReason?{op:'activity',id:a.id}:null;
  }
  if(kind==='rpg'){const a=actions.find(a=>a.id==='rpg_move_'+id);return a&&!a.disabledReason?{op:'activity',id:a.id}:null;}
  if(kind==='dungeon') {
    if(s.adventuring?.expedition?.layoutVersion===1&&/^radiant_[0-5]$/.test(id)){const c=s.event?.id==='adventure_room'&&s.event.choices.find(c=>c.id==='route_'+id.slice(8));return c&&!c.disabledReason?{op:'choice',id:c.id}:null;}
    const c=s.event?.choices.find(c=>c.id==='route_'+id);
    if(c&&!c.disabledReason)return {op:'choice',id:c.id};
    const a=actions.find(a=>a.id==='explore_route_'+id);
    return a&&!a.disabledReason?{op:'activity',id:a.id}:null;
  }
  return null;
}

return {areaScene,renderAreaScene,settlementLayout,spatialMoveOffer};
})();
const __life_ui = (() => {
const { getActions } = __engine;
const { getContacts } = __conversations;
const { renderAvatar } = __avatar;
const { socialView } = __social;
const { pastimeView } = __pastimes;
const { recoveryView } = __health;
const ICONS = {
  manuscripts:'M5 4h14v16H5zM8 8h8M8 12h8M8 16h5',
  sketching:'m5 19 2-6L17 3l4 4-10 10-6 2ZM7 13l4 4M15 5l4 4',
  music:'M9 18V6l10-3v12M9 6l10-3M9 16c-5-2-7 4-3 5 2 1 3-1 3-3Zm10-3c-5-2-7 4-3 5 2 1 3-1 3-3Z',
  gardening:'M12 21V10M12 14C3 14 3 7 3 7c8-1 9 7 9 7Zm0-4s-1-8 9-8c0 0 1 9-9 8ZM7 21h10',
  storytelling:'M4 5c3-2 6-1 8 1 2-2 5-3 8-1v15c-3-2-6-1-8 1-2-2-5-3-8-1V5Zm8 1v15M7 9h2m6 0h2M7 13h2m6 0h2',
  strategy:'M5 21h14M7 17h10l-2-7 3-5-5-2-2 5-4 1v3h5l-5 5Zm0 0v4m10-4v4',
};

function interestIcon(id) {
  return `<svg class="pastime-emblem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${ICONS[id] || ICONS.storytelling}"/></svg>`;
}

function contactChip(id,name,contacts,ui,small=false) {
  const person=contacts.find(p=>p.id===id);
  if(!person)return `<span class="social-known-name">${ui.e(name)}</span>`;
  return `<button type="button" class="social-person-link ${small?'small':''}" data-op="show-contact" data-id="${ui.e(id)}">${small?'':renderAvatar(person,{size:'small',age:person.age})}<span>${ui.e(person.name)}</span><span class="social-person-arrow" aria-hidden="true">›</span></button>`;
}

function socialActionGroups(offered,ui) {
  if(!offered.length)return '';
  const introductions=offered.filter(a=>a.id.startsWith('social_introduce_'));
  const ordinary=offered.filter(a=>!a.id.startsWith('social_introduce_')).sort((a,b)=>Number(b.id==='social_gather')-Number(a.id==='social_gather'));
  return `${ordinary.length?ui.actionCards(ordinary.slice(0,2)):''}${ordinary.length>2?`<details class="life-ui-disclosure" data-disclosure="social-other-plans"><summary>Other plans<span>${ordinary.length-2}</span></summary>${ui.actionCards(ordinary.slice(2))}</details>`:''}${introductions.length?`<details class="life-ui-disclosure" data-disclosure="social-introductions"><summary>Bring people together<span>${introductions.length}</span></summary>${ui.actionCards(introductions)}</details>`:''}`;
}

/** A view of witnessed connections, never the entire private social graph. */
function socialPanel(s,ui,selectedPersonId=null) {
  const v=socialView(s);if(!v.enabled)return '';
  const {e,date}=ui,contacts=getContacts(s);
  const ties=(v.ties || []).filter(t=>!selectedPersonId || t.personId===selectedPersonId || t.otherPersonId===selectedPersonId);
  const notices=(v.notices || []).filter(n=>!selectedPersonId || (n.actorIds || []).includes(selectedPersonId)).slice(-8).reverse();
  const offered=getActions(s).filter(a=>a.id.startsWith('social_') && (!selectedPersonId || !a.id.startsWith('social_checkin_') || a.id===`social_checkin_${selectedPersonId}`));
  const circles=selectedPersonId?[]:(v.circles || []).filter(c=>c.people?.length);
  if(s.age<4&&!ties.length&&!notices.length&&!offered.length)return '';
  const person=contacts.find(p=>p.id===selectedPersonId);
  const tieCard=t=>`<article class="social-tie" data-social-tie="${e(t.id)}"><div class="social-tie-people">${contactChip(t.personId,t.name,contacts,ui,true)}<span class="social-tie-thread" aria-hidden="true">—</span>${contactChip(t.otherPersonId,t.otherName,contacts,ui,true)}</div><span class="social-tie-label">${e(t.label || ui.title(t.kind))}</span><p>${e(t.description)}</p></article>`;
  const noticeCard=n=>`<li class="social-notice" data-social-notice="${e(n.id)}"><span class="social-note-mark" aria-hidden="true">✦</span><div><div class="social-notice-heading"><strong>${e(n.title)}</strong><time>${e(date(n.day))}</time></div><p>${e(n.text)}</p></div></li>`;
  const circleMarkup=circles.length?`<details class="life-ui-disclosure" data-disclosure="social-familiar-faces"><summary>The familiar faces<span>${circles.reduce((n,c)=>n+c.people.length,0)}</span></summary><div class="social-circles">${circles.map(c=>`<section class="social-circle"><h3>${e(c.title)}</h3><div class="social-circle-people">${c.people.map(p=>contactChip(p.id,p.name,contacts,ui)).join('')}</div></section>`).join('')}</div></details>`:'';
  const tiesMarkup=ties.length?`<div class="social-ties">${ties.slice(0,2).map(tieCard).join('')}</div>${ties.length>2?`<details class="life-ui-disclosure" data-disclosure="social-more-connections"><summary>More familiar connections<span>${ties.length-2}</span></summary><div class="social-ties">${ties.slice(2).map(tieCard).join('')}</div></details>`:''}`:person?`<p class="life-ui-empty">You have not heard much about ${e(person.name)}’s other friendships.</p>`:'<p class="life-ui-empty">For now, you know these people separately. There are stories you have not heard.</p>';
  const noticesMarkup=notices.length?`<section class="social-hearth-notes"><h3>What you have heard</h3><ol>${notices.slice(0,1).map(noticeCard).join('')}</ol>${notices.length>1?`<details class="life-ui-disclosure" data-disclosure="social-earlier-notices"><summary>Earlier word<span>${notices.length-1}</span></summary><ol>${notices.slice(1).map(noticeCard).join('')}</ol></details>`:''}</section>`:'';
  return `<section class="roleplay-section social-life-section"><div class="section-heading"><div><span class="eyebrow">${person?'AROUND '+e(person.name):'WORD AROUND THE HEARTH'}</span><h2>${person?'The people in their life':'A circle of lives'}</h2></div></div>${tiesMarkup}${circleMarkup}${noticesMarkup}${socialActionGroups(offered,ui)}</section>`;
}

function hobbyCard(h,ui) {
  return `<article class="pastime-card ${h.active?'active':''}" data-interest-id="${ui.e(h.id)}">${interestIcon(h.id)}<div><div class="pastime-card-heading"><h3>${ui.e(h.name)}</h3>${h.active?'<span class="pastime-active">Your pastime</span>':''}</div><p>${ui.e(h.description)}</p>${h.practiceDays>0?`<small>${ui.e(h.practiceDays)} ${h.practiceDays===1?'day':'days'} spent practicing</small>`:''}</div></article>`;
}

function petCard(p,ui,remembered=false) {
  const species=String(p.species || '').toLowerCase();
  const portrait=species==='cat'?'<path d="M6 12 5 4l6 4h2l6-4-1 8c3 7-15 7-12 0ZM9 12h.1m6 0h.1M12 14v2M3 13l5 1m8 0 5-1M3 17l5-1m8 0 5 1"/>':['dog','hound'].includes(species)?'<path d="m7 8-3-4-2 8 5 3M17 8l3-4 2 8-5 3M7 8c3-3 7-3 10 0v9c-2 4-8 4-10 0V8ZM9 12h.1m6 0h.1M10 16h4l-2 2-2-2Z"/>':'<path d="M3 18 7 13c0-5 4-8 8-5 1-5 5-5 6-1l2 2-5 1c1 6-3 9-8 8l-7 2 3-4M8 14l5-3-1 5-4-2Zm8-7h.1M11 18v4m4-5 1 5M9 22h4m1 0h4"/>';
  return `<article class="pastime-pet ${remembered?'remembered':''}" data-pet-id="${ui.e(p.id)}"><div class="pastime-pet-portrait"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${portrait}</svg></div><div><span class="eyebrow">${remembered?'REMEMBERED':'A SMALL COMPANION'}</span><h3>${ui.e(p.name)}</h3><p class="pastime-pet-meta">${ui.e(ui.title(p.species))}${Number.isFinite(p.age)?` · Age ${ui.e(p.age)}`:''}</p>${p.description?`<p>${ui.e(p.description)}</p>`:''}${remembered&&p.cause?`<p class="small-copy muted">${ui.e(p.cause)}</p>`:''}</div></article>`;
}

/** Pastimes remain ordinary activities with their actual time and price visible. */
function pastimePanel(s,ui,compact=false) {
  const v=pastimeView(s);if(!v.enabled)return '';
  const {e,actionCards,date}=ui;
  const offered=getActions(s).filter(a=>a.id.startsWith('pastime_'));
  const hobbies=v.hobbies || [],lived=hobbies.filter(h=>h.active||h.practiceDays>0);
  const pet=v.pet,remembered=v.petHistory || [],history=v.history || [];
  if(compact&&s.age<4&&!pet&&!lived.length)return '';
  const chosen=lived.find(h=>h.active)||lived[0];
  const empty=s.age<4?'Familiar voices and the room around you fill your world.':s.age<7?'A little free time. Something that is yours to enjoy.':s.age<12?'After lessons, before the lamps are lit. What will you do?':s.age<18?'Some days belong to school. Some are your own.':'There is life beyond work and the road.';
  const chooseActions=offered.filter(a=>a.id==='pastime_interest'||/^pastime_(choose|interest)_/.test(a.id));
  const ordinaryActions=offered.filter(a=>!chooseActions.includes(a));
  const compactActions=ordinaryActions.filter(a=>!a.disabledReason).sort((a,b)=>Number(/practice|care/.test(b.id))-Number(/practice|care/.test(a.id))).slice(0,2);
  return `<section class="roleplay-section pastime-section ${compact?'compact':''}"><div class="section-heading"><div><span class="eyebrow">THE HOURS BETWEEN</span><h2>${s.age<12?'Small adventures':'A life of your own'}</h2></div>${s.age>0?`<span class="badge">Age ${e(s.age)}</span>`:''}</div>${lived.length?`<div class="pastime-cards">${(compact?[chosen]:lived).filter(Boolean).map(h=>hobbyCard(h,ui)).join('')}</div>`:`<p class="life-ui-empty">${empty}</p>`}${pet?petCard(pet,ui):''}${actionCards(compact?compactActions:ordinaryActions)}${compact?ui.button('Pastimes &amp; small adventures','tab','activities','ghost small'):chooseActions.length?`<details class="life-ui-disclosure" data-disclosure="pastime-interests" ${!chosen?'open':''}><summary>${chosen?'Try another pastime':'Find something you love'}<span>${chooseActions.length}</span></summary>${actionCards(chooseActions)}</details>`:''}${!compact&&remembered.length?`<details class="life-ui-disclosure" data-disclosure="pastime-remembered-pets"><summary>Small lives remembered</summary>${remembered.map(p=>petCard(p,ui,true)).join('')}</details>`:''}${!compact&&history.length?`<details class="life-ui-disclosure" data-disclosure="pastime-earlier-days"><summary>Days you remember</summary><ol class="pastime-records">${history.slice(-12).reverse().map(h=>`<li><div><strong>${e(h.title)}</strong><time>${e(date(h.day))}</time></div><p>${e(h.text)}</p></li>`).join('')}</ol></details>`:''}</section>`;
}
const { storyView } = __life_stories;
function storiesPanel(s,ui){
  const v=storyView(s);if(!v||s.age<18||s.phase==='retired')return '';
  const {e,button,actionCards}=ui,offered=getActions(s).filter(a=>a.id.startsWith('stories_open_'));
  const active=v.arcs.filter(a=>a.status==='active'),last=v.history.at(-1);
  return `<details class="life-ui-disclosure personal-stories" data-disclosure="personal-stories"><summary>Personal stories<span>${offered.length?offered.length+' chapters waiting':active.length+' unfinished'}</span></summary><p class="small-copy">People keep their own accounts. A choice can return years later, with the same names and places.</p>${last?`<article class="personal-return"><strong>${e(last.title)}</strong><p>${e(last.text)}</p>${button('Read '+e(last.personName)+'’s correspondence','show-contact',last.personId,'ghost small')}</article>`:''}${active.map(a=>`<p><strong>${e(a.title)}</strong> · ${e(a.personName)} · ${a.chapter}/${a.totalChapters||3} chapters${s.age<a.nextAge?' · returns at age '+a.nextAge:''}</p>`).join('')}${actionCards(offered)}${v.arcs.some(a=>a.status!=='active')?`<p class="small-copy">${v.arcs.filter(a=>a.status==='completed').length} stories completed · ${v.arcs.filter(a=>a.status==='abandoned').length} left behind. Their recorded consequences remain in the chronicle and world.</p>`:''}</details>`;
}

function recoveryPanel(s,ui){
  if(s.age<16||s.phase==='retired')return '';
  const offered=getActions(s).filter(a=>a.id.startsWith('recovery_')),v=recoveryView(s),p=v.plan;
  if(!offered.length&&!p)return '';
  const {e,button}=ui;
  return `<details class="life-ui-disclosure recovery-plans" data-disclosure="recovery-plans" ${p?'open':''}><summary>Set aside time to recover<span>${p?p.remainingDays+' days remain':'14, 28 or 56 days'}</span></summary><p>${e(v.terms)}</p><p>Living costs continue. Dedicated recovery days earn no work wages. Birthdays, obligations and supernatural needs pause the plan. A separate rest, support or healer session supports symptoms but adds no plan attendance.</p>${p?`<div class="career-stats"><div><span>Plan attendance</span><strong>${p.attendedDays}/${p.totalDays} days</strong></div><div><span>Symptom-care days recorded</span><strong>${p.careDays??'Not separately recorded'}</strong></div><div><span>Consultation</span><strong>${p.paid?p.fee+'g paid once':p.fee+'g on first attendance'}</strong></div></div>${p.unrecordedCareDays?`<p class="small-copy">${p.unrecordedCareDays} earlier attended days have no separate symptom-care count. Their attendance is retained; missing care credit is not invented.</p>`:''}`:''}${offered.length?ui.actionCards(offered):`<p class="muted">The plan and its remaining days are saved. Resolve the waiting decision before continuing.</p>${button('Return to your life','tab','life','secondary')}`}</details>`;
}

return {pastimePanel,recoveryPanel,socialPanel,storiesPanel};
})();
const __field_ui = (() => {
// The field on the page (v0.68): two ranks a side, portraits with their bars
// and an intent glyph, the commands with what each would do, the log folded
// beneath. Reads the battle; never advances it. Legacy battles keep
// battle-ui.js. Portraits come from the caller, as battle-ui does it.
const { getBattleActions, previewBattleAction, battleActorDisplayName } = __combat;
const { renderCombatStatuses, renderEnemyPrediction } = __combat_status_ui;
const { renderEnemyPortrait } = __enemies;
const { reaches } = __enemy_targets;
const GLYPH = { strike: '⚔', charge: '⚡', ward: '◈', hex: '✶', heal: '✚', volley: '⋯', flank: '⟡', measure: '◎', wait: '·' };
function intentGlyph(text = '') {
  const t = text.toLowerCase();
  if (/measure/.test(t)) return GLYPH.measure;
  if (/charge|winds up|prepared|ritual/.test(t)) return GLYPH.charge;
  if (/ward|regenerat|heal|restore|recover/.test(t)) return /heal|restore|recover/.test(t) ? GLYPH.heal : GLYPH.ward;
  if (/every|entire|all |wave|volley|pulse/.test(t)) return GLYPH.volley;
  if (/weaken|hex|seal|silence|fear|poison|bleed|mark/.test(t)) return GLYPH.hex;
  if (/pack|flank|prey/.test(t)) return GLYPH.flank;
  if (/strike|hit|attack|smash|drain/.test(t)) return GLYPH.strike;
  return GLYPH.wait;
}
const shortIntent = text => String(text || '').split(/(?<=[.!?])\s/)[0].slice(0, 90);

function renderField(b, ui, { selectedEnemy = null, selectedAlly = null, portraitFor, outcomeContent = '', commandHelpFor = () => '' } = {}) {
  const { e, meter, chapter } = ui;
  const name = a => battleActorDisplayName(a, b), actor = b.actors.find(a => a.id === b.currentActorId), live = !b.outcome;
  const enemies = b.actors.filter(a => a.side === 'enemy' && a.hp > 0), allies = b.actors.filter(a => a.side === 'party' && a.hp > 0);
  if (!enemies.some(a => a.id === selectedEnemy)) selectedEnemy = enemies[0]?.id || null;
  if (!allies.some(a => a.id === selectedAlly)) selectedAlly = actor?.side === 'party' ? actor.id : allies[0]?.id || null;
  const actions = live ? getBattleActions(b).map(a => { const preview = previewBattleAction(b, a.id, a.targetSide === 'party' ? selectedAlly : selectedEnemy); return { ...a, preview, disabledReason: preview.legal ? null : preview.reason }; }) : [];
  const card = a => {
    const down = a.hp <= 0, mine = a.id === b.currentActorId, enemy = a.side === 'enemy';
    const reach = enemy && live && actor?.side === 'party' ? reaches(b, actor, a) : true;
    const intent = enemy && !down && a.intent ? `<p class="field-intent"><span class="field-glyph" aria-hidden="true">${intentGlyph(a.intent)}</span> ${e(shortIntent(a.intent))}</p>${live ? renderEnemyPrediction(b, a, name) : ''}` : '';
    const pick = !down && live ? (enemy ? `<label class="field-pick"><input type="radio" name="battle-target" value="${e(a.id)}" ${selectedEnemy === a.id ? 'checked' : ''}> ${selectedEnemy === a.id ? 'Target' : 'Aim here'}</label>` : `<label class="field-pick"><input type="radio" name="battle-ally-target" value="${e(a.id)}" ${selectedAlly === a.id ? 'checked' : ''}> ${selectedAlly === a.id ? 'Chosen' : 'Help'}</label>`) : '';
    return `<div class="field-card ${enemy ? 'enemy' : 'ally'} ${mine ? 'current' : ''} ${down ? 'down' : ''} ${!reach ? 'out-of-reach' : ''}" data-actor="${e(a.id)}"><div class="field-portrait">${enemy ? renderEnemyPortrait({ ...a, name: name(a) }) : portraitFor(a)}${mine ? '<span class="field-turn" aria-label="Their move">▶</span>' : ''}</div><div class="field-body"><strong>${e(name(a))}</strong>${down ? '<span class="field-down">down</span>' : ''}${!reach && !down ? '<span class="field-reach" title="Out of reach of a plain blow">behind</span>' : ''}${meter(a.hp, a.maxHp, 'Health')}${a.maxMp ? meter(a.mp, a.maxMp, 'Focus', 'focus-meter') : ''}${renderCombatStatuses(a)}${a.status?.inspected && enemy ? `<p class="field-known">${a.weakness ? 'Fears ' + e(a.weakness) : 'Fears nothing you know of'}.</p>` : ''}${intent}${pick}</div></div>`;
  };
  const rank = (side, row) => { const rows = b.actors.filter(a => a.side === side && (a.row || 'front') === row); return rows.length ? `<div class="field-rank ${row}" aria-label="${side === 'enemy' ? 'Their' : 'Your'} ${row} rank"><span class="field-rank-label">${row === 'front' ? 'Front' : 'Back'}</span>${rows.map(card).join('')}</div>` : ''; };
  const commands = !live ? outcomeContent : `<div class="section-heading"><div><span class="eyebrow">YOUR MOVE</span><h2>${e(name(actor))}</h2></div><span class="badge">${b.potions} potion${b.potions === 1 ? '' : 's'}</span></div><div class="field-actions">${actions.map(a => `<div class="field-action"><button class="button ${a.id === 'attack' ? 'primary' : a.art ? 'art' : 'secondary'}" data-op="battle-action" data-id="${e(a.id)}" ${a.disabledReason ? 'disabled' : ''} title="${e(a.disabledReason || a.description)}" aria-describedby="field-preview-${e(a.id)}">${e(a.label)}${a.cost && a.cost !== 'Free' ? ` <small>${e(a.cost)}</small>` : ''}</button><p class="small-copy field-preview" id="field-preview-${e(a.id)}" data-action-preview="${e(a.id)}">${e(a.disabledReason || a.preview.summary)}${commandHelpFor(a, actor)}</p></div>`).join('')}</div>`;
  return `<div class="field-workspace"><header class="field-topline">${chapter(b.title, !live ? 'The fight is over.' : `Round ${b.round}.`, 'THE FIELD')}</header><div class="field-ground"><section class="field-side enemies" aria-label="Them">${rank('enemy', 'back')}${rank('enemy', 'front')}</section><div class="field-line" aria-hidden="true"></div><section class="field-side party" aria-label="You">${rank('party', 'front')}${rank('party', 'back')}</section></div><section class="panel field-commands" aria-label="Battle commands">${commands}<details class="field-help"><summary>How to read the field</summary><p class="small-copy" data-preview-explanation>Each command shows its immediate result before turn effects and enemy replies. Choose a foe or an ally to compare.</p><p class="small-copy" data-enemy-prediction-note>A foe's named recipient is its current aim, not a promise. Guarding, Health, Focus, marks and what happens in between can change it before it acts. Nothing without a bow, a spell, a hook or a pack reaches the back rank while the front stands.</p></details><div class="field-recent" aria-live="polite">${b.log.slice(-3).map(l => `<p>${e(l)}</p>`).join('')}</div><details class="field-log"><summary>The whole of it</summary><ol class="battle-log">${b.log.map(l => `<li>${e(l)}</li>`).join('')}</ol></details></section></div>`;
}

// ---------------------------------------------------------------- above ground
const { battlecraftView, bestiaryView, treeView } = __battlecraft;
/** The arts of a calling, what a fight has cost, and who stands with you. Under Activities › Training. */
function battlecraftPanel(s, e, { sections = ['arts', 'injuries', 'companions', 'record'] } = {}) {
  const v = battlecraftView(s); if (!v) return '';
  const parts = [], want = id => sections.includes(id);
  const tree = want('arts') ? treeView(s) : null;
  if (tree) {
    const tiers = [2, 3].map(t => tree.rows.filter(r => r.tier === t));
    parts.push(`<div class="schooling-row"><span class="eyebrow">THE ARTS OF THE ${e(tree.calling.toUpperCase())}</span><p class="small-copy">Your calling's two gifts are always yours${tree.roots.length ? '; the two earned techniques sit beside them' : ''}. Beyond those, ${tree.rows.filter(r => r.learned).length} of ${tree.rows.length} learned.</p><ul class="field-tree">${tiers.map((rows, i) => `<li><strong>${i === 0 ? 'Second tier' : 'Third tier'}</strong><ul>${rows.map(r => `<li class="${r.learned ? 'learned' : r.reason ? 'locked' : 'open'}"><span>${e(r.name)}</span> <small>${e(r.learned ? r.line : r.reason || 'Within reach.')}</small></li>`).join('')}</ul></li>`).join('')}</ul></div>`);
  }
  if (want('injuries') && v.injuries.length) parts.push(`<div class="schooling-row"><span class="eyebrow">WHAT IT COST</span>${v.injuries.map(i => `<p><strong>${e(i.name)}</strong>${i.permanent ? ', for good' : `, ${i.daysLeft} day${i.daysLeft === 1 ? '' : 's'}${i.treated ? ', set and mending' : ', untended'}`}. ${e(i.line)}</p>`).join('')}</div>`);
  const people = want('companions') ? v.companions.filter(c => c.alive) : [];
  if (people.length) parts.push(`<div class="schooling-row"><span class="eyebrow">WHO STANDS WITH YOU</span>${people.map(c => `<p><strong>${e(c.name)}</strong>: ${c.loyalty >= 80 ? 'would follow you anywhere, and fights beside you as one' : c.loyalty >= 55 ? 'with you' : c.loyalty >= 30 ? 'with you, for now' : 'close to walking'}${c.wounded ? '; mending' : ''}.</p>`).join('')}</div>`);
  if (want('record') && v.record.fights) parts.push(`<p class="small-copy">${v.record.fights} fight${v.record.fights === 1 ? '' : 's'}: ${v.record.won} won, ${v.record.lost} lost, ${v.record.fled} walked away from${v.record.settled ? `, ${v.record.settled} not worth the telling` : ''}.</p>`);
  return parts.join('');
}
/** What a life knows of what lives in the dark. */
function bestiaryPanel(s, e) {
  const v = bestiaryView(s); if (!v || !v.rows.length) return '';
  return `<div class="schooling-row"><span class="eyebrow">THE BESTIARY</span>${v.schooled ? '<p class="small-copy">You read natural philosophy. You know what each kind fears before it shows you.</p>' : ''}<ul class="field-bestiary">${v.rows.slice(0, 24).map(r => `<li><strong>${e(r.name)}</strong> <small>${e(r.level >= 3 ? 'known' : r.level === 2 ? 'fought' : 'seen')}${r.killed ? `, ${r.killed} killed` : ''}</small>${r.description ? `<p class="small-copy">${e(r.description)}</p>` : ''}${r.habits ? `<p class="small-copy">${e(r.habits)}</p>` : ''}</li>`).join('')}</ul></div>`;
}

return {battlecraftPanel,bestiaryPanel,renderField};
})();
const __activities_v31 = (() => {
const { recoveryPanel } = __life_ui;
const { renderRunestones } = __runestone_ui;
const { renderTournamentCard } = __adult_tournament_ui;
const { renderStatusReference } = __status_reference;
const { renderRepertoire } = __repertoire_ui;
const { actionCostDetails, renderActionCostHelp } = __action_costs;
const { interactionChoice, activityQuote } = __interaction_ui_v40;
const { getActions, exploreTravelPreview, consumableReason } = __engine;
const { settlementServices } = __world_services;
const { travelEnergyView } = __travel_energy;
const { MISDEEDS, crimeCheck } = __daylife_v35;
const {ownedHomeHere,homeRestReason} = __home_recovery_v38;
const {personalServicesPanel} = __personal_services;
const { schoolingView } = __schooling;
const { guildView } = __guild;
const { battlecraftPanel, bestiaryPanel } = __field_ui;
/** The second slice of schooling on the school page: the institution, the studies, the bench, the two from the bench beside you, and what the examinations made you. */
function schoolingPanel(game,e){
  const v=schoolingView(game); if(!v) return '';
  const parts=[];
  if(v.institution){const i=v.institution;parts.push(`<div class="schooling-row"><span class="eyebrow">${e(i.label.toUpperCase())}</span><p>${e(i.major)}, year ${i.year} of ${i.years}. ${i.lessons} lectures heard.${i.degree?` Degree taken at ${i.degree.age}, grade ${i.degree.grade}.`:i.scholarship?' The scholarship pays.':i.patron?` ${e(i.patron.kind==='house'?'The house pays.':i.patron.name+' pays the fee.')}`:''} The lectures are given in ${e(game.world.locations.find(l=>l.id===i.locationId)?.name||'the capital')}.</p></div>`);}
  if(v.bond){const b=v.bond;parts.push(`<div class="schooling-row"><span class="eyebrow">THE BOND</span><p>${e(b.done?`Three years served under ${b.master}. You are a journeyman ${b.craft}.`:b.broken?`Bound to ${b.master} and ${b.broken.how==='paid'?'bought back':'broken, with the yard watching'}.`:`Bound to ${b.master}'s bench as a ${b.craft}'s apprentice, ${b.yearsLeft} year${b.yearsLeft===1?'':'s'} of the three to serve. ${b.lessons} days at the bench so far.`)}</p></div>`);}
  if(v.credentials.length)parts.push(`<div class="schooling-row"><span class="eyebrow">WHAT THE EXAMINATIONS MADE YOU</span><div class="qualification-list">${v.credentials.map(c=>`<span class="badge">${e(c.kind==='journeyman'?`Journeyman ${c.major}`:`${c.label[0].toUpperCase()}${c.label.slice(1)} · ${c.majorLabel}`)}</span>`).join('')}</div></div>`);
  if(v.studies.length)parts.push(`<div class="schooling-row"><span class="eyebrow">STUDIES</span><div class="qualification-list">${v.studies.map(s=>`<span class="badge ${s.fading?'muted':''}" title="${s.fading?'Fading for want of use':'Kept up'}">${e(s.label)} ${s.level}${s.fading?' ↓':''}</span>`).join('')}</div></div>`);
  if(v.classmates.length)parts.push(`<div class="schooling-row"><span class="eyebrow">THE BENCH</span>${v.classmates.map(c=>`<p><strong>${e(c.name)}</strong>, ${e(c.nature)}, ${c.age}. ${e(c.fate?(c.fate.told==='late'?c.fate.late:c.fate.early).replace(/^/,c.name+' '):c.contests.length?`${c.contests.filter(x=>x.won).length} prize${c.contests.filter(x=>x.won).length===1?'':'s'} to you, ${c.contests.filter(x=>!x.won).length} to them.`:`Sits beside you in ${c.subjectLabel.toLowerCase()}.`)}${c.standing>=2?' They think well of you.':c.standing<=-2?' They have not forgiven you.':''}</p>`).join('')}</div>`);
  return parts.length?`<div class="schooling-panel">${parts.join('')}</div>`:'';
}


/** The guild on the school page: the rolls, the dues, the hall's work, the road years, the people at the hall, and what the hall remembers. */
function guildPanel(game,e){
  const v=guildView(game); if(!v) return '';
  const parts=[], m=v.member;
  if(m){
    parts.push(`<div class="schooling-row"><span class="eyebrow">${e(m.name.replace(/^the /,'').toUpperCase())}</span><p>${e(`${m.rank[0].toUpperCase()}${m.rank.slice(1)}, ${m.years<1?'this year':m.years+' year'+(m.years===1?'':'s')} on the rolls, ${{born:'born to it',apprenticed:'by the master’s word',bought:'bought in',recruited:'at the hall’s asking',inherited:'by the name in the old book'}[m.how]}. The hall keeps its rolls at ${m.seat}. Your standing there is ${m.standingWord}.${m.dues?` Dues ${m.dues} gold a season${m.arrears?`, ${m.arrears} owed`:''}.`:' No dues at your rank.'}`)}</p>${m.rank==='journeyman'?`<p>${e(m.wander.done?'The road years are served.':`The road years: ${m.wander.seasons} of ${m.wander.need} seasons served in other regions’ halls.`)}${m.masterpiece?e(` ${m.masterpiece.name[0].toUpperCase()}${m.masterpiece.name.slice(1)}: ${m.masterpiece.judged?'looked at and refused':'waiting on the wardens'}.`):''}</p>`:''}${m.assignment?`<p>${e(`The hall’s work: ${m.assignment.what} at ${m.assignment.place}, ${m.assignment.pay} gold.${m.assignment.overdue?' Overdue.':''}`)}</p>`:''}</div>`);
    parts.push(`<div class="schooling-row"><span class="eyebrow">THE HALL</span><p><strong>${e(m.warden)}</strong>, ${e(m.rank==='warden'||m.rank==='guildmaster'?'yourself, warden':'warden')}.${m.sponsor?` <strong>${e(m.sponsor)}</strong>, whose ${m.how==='inherited'?'name':'word'} put you on the rolls.`:''}${m.rival?` <strong>${e(m.rival.name)}</strong> at the next bench: ${m.rival.won} prize${m.rival.won===1?'':'s'} to you, ${m.rival.lost} to them.`:''}${m.apprentice?` <strong>${e(m.apprentice.name)}</strong>, your apprentice, ${m.apprentice.years<1?'new to the bench':m.apprentice.years+' year'+(m.apprentice.years===1?'':'s')+' at it'}.`:''}</p></div>`);
  } else if(v.heir) parts.push(`<div class="schooling-row"><span class="eyebrow">THE OLD BOOK</span><p>${e(`${v.heir.from}’s name is on the rolls of ${v.heir.name}. Take up the trade and the hall will find it.`)}</p></div>`);
  else if(v.family) parts.push(`<div class="schooling-row"><span class="eyebrow">THE FAMILY’S TABLE</span><p>${e(`The family has a name at ${v.family.name}. Take up the trade and it is yours.`)}</p></div>`);
  if(v.past.length) parts.push(`<div class="schooling-row"><span class="eyebrow">STRUCK OUT</span>${v.past.map(p=>`<p>${e(`${p.name[0].toUpperCase()}${p.name.slice(1)}: ${p.rank}, ${p.left==='expelled'?'struck from the rolls':'walked out'}.`)}</p>`).join('')}</div>`);
  const memories=v.threads.flatMap(t=>t.memory).concat(v.history.map(h=>h.text)).slice(-4);
  if(memories.length&&m) parts.push(`<div class="schooling-row"><span class="eyebrow">WHAT THE HALL REMEMBERS</span>${memories.map(x=>`<p>${e(x)}</p>`).join('')}</div>`);
  return parts.length?`<div class="schooling-panel guild-panel">${parts.join('')}</div>`:'';
}

const ACTIVITY_TABS=[['daily','Everyday'],['work','Work & School'],['recovery','Recovery'],['training','Training'],['fun','Social & Fun'],['crime','Crime & Mischief']];
function compactActivityRows(actions,ui,s=null){if(!actions.length)return '';return `<div class="compact-activities interaction-options">${actions.map(a=>interactionChoice(ui,{label:a.label,op:'activity',id:a.id,description:a.description,meta:activityQuote(a,s),costDetails:actionCostDetails(s,a),disabledReason:a.disabledReason})).join('')}</div>`;}
/** The institutions of the capitals and the bond are not a teacher's room: their actions sit here, under Work & School. */
/** The hall's own actions sit under Work & School too: the rolls, the dues, the hall's work, the road, the masterpiece. */
function guildBlock(all,ui,s){
  const rows=all.filter(a=>/^guild_/.test(a.id));
  if(!rows.length)return '';
  return `<div class="capitals-block guild-block"><p class="activity-intro">${ui.e(s.guild?.member?'The hall has you on its rolls.':'The hall keeps its rolls at the capital.')}</p>${compactActivityRows(rows,ui,s)}</div>`;
}
function capitalsBlock(all,ui,s){
  const rows=all.filter(a=>/^school_(sit_|place_|read_|lecture$|degree$|break_bond$)/.test(a.id));
  if(!rows.length)return '';
  return `<div class="capitals-block"><p class="activity-intro">${ui.e(s.education?.schooling?.institution&&!s.education.schooling.institution.degree?'The institution has you on its rolls. The lectures are given in the capital.':s.education?.schooling?.bond&&!s.education.schooling.bond.done&&!s.education.schooling.bond.broken?'The bond has years left in it.':'The institutions of the capitals examine at their doors.')}</p>${compactActivityRows(rows,ui,s)}</div>`;
}
function renderActivities(s,ui,{pane='daily',ongoing=''}={}){
 const {e,button,chapter}=ui;if(!ACTIVITY_TABS.some(t=>t[0]===pane))pane='daily';const all=getActions(s),services=settlementServices(s);
 const tabs=`<nav class="activity-tabs" aria-label="Activities">${ACTIVITY_TABS.map(([id,label])=>button(label,'activities-pane',id,'ghost small',false,pane===id)).join('')}</nav>`;
 const blocked=Boolean(s.event||s.battle||s.conversations?.pending||s.timeline?.journey||s.cartography?.pending||s.cartography?.offsite||s.dungeon||s.maze);
 const nearby=kind=>{
  const matches=r=>r.kind===kind&&(kind!=='school'||r.subjectId===(s.education?.route||'community'));
  const local=services.filter(matches);if(local.length&&!s.cartography?.offsite)return {rows:local,local:true};
  const destinations=Object.keys(s.cartography?.sites||{}).map(siteId=>({siteId,preview:exploreTravelPreview(s,siteId)})).filter(d=>!d.preview.disabledReason).sort((a,b)=>a.preview.days-b.preview.days);
  for(const d of destinations){const rows=settlementServices(s,{siteId:d.siteId}).filter(matches);if(rows.length)return {rows:[rows[0]],local:false,days:d.preview.days};}
  return {rows:[],local:false};
 };
 const shortcuts=kinds=>kinds.map(kind=>{const found=nearby(kind),rows=kind==='school'?found.rows.filter(r=>r.subjectId===(s.education?.route||'community')).slice(0,1):found.rows.slice(0,1);return rows.map(r=>{
  const place=s.world.locations.find(p=>p.id===r.locationId),label=kind==='work'?(s.hero.profession!=='Unemployed'?'Go to Work — '+s.hero.profession:'Visit Local Steward'):kind==='doctor'?'Visit Local Doctor':kind==='inn'?'Visit the Innkeeper':kind==='school'?'Talk to Teacher':r.role;
  return interactionChoice(ui,{label:found.local?label:'Travel to '+label,op:found.local?'activity-visit':'activity-route',id:found.local?r.id:r.locationId,meta:r.name+' · '+place.name+(found.local?'':' · '+found.days+' Days Away'),description:found.local?'':'Review the journey on your map. The visit begins after you arrive.',disabled:found.local&&blocked});
 }).join('')||`<p class="activity-empty">${kind==='school'?'Your teacher is away.':'No '+(kind==='doctor'?'doctor':kind==='work'?'steward':kind==='inn'?'innkeeper':'mentor')+' is within reach on your map.'} ${s.event||s.battle||s.conversations?.pending?'Finish the current moment first.':'Find more inhabited places as you travel.'}</p>`;}).join('');
 const schoolShortcuts=()=>{
  const teacher=services.find(r=>r.kind==='school'&&r.subjectId===(s.education?.route||'community'));
  if(!teacher||!s.education?.enrolled||s.cartography?.offsite)return '';
  const study=all.find(a=>a.id==='grow_read')||all.find(a=>a.id==='study');
  return `<div class="school-shortcuts interaction-options" role="group" aria-label="School Activities">${[['Attend Class','school_attend'],['Study',study?.id]].filter(r=>r[1]).map(([label,id])=>{const a=all.find(a=>a.id===id),reason=a?.disabledReason;return interactionChoice(ui,{label,op:'activity-school',id:teacher.id+'|'+id,meta:activityQuote(a,s),costDetails:actionCostDetails(s,a),disabled:blocked||!a||Boolean(reason&&!/^Visit /.test(reason)),disabledReason:reason&&!/^Visit /.test(reason)?reason:''});}).join('')}</div>`;
 };

 const pairs=renderRunestones(s,ui,all);
 let content='';
 if(pane==='work')content=`<p class="activity-intro">${s.age<18?'Visit a teacher for lessons or a steward for available work.':s.hero.profession==='Unemployed'?'Visit a work steward to find employment.':'Your profession: '+e(s.hero.profession)+(s.hero.profession==='Scholar'&&ownedHomeHere(s)?'. Copy and research at your own home, or visit a steward for commissions.':'. Go to your workplace for shifts and commissions.')}</p>${shortcuts(s.age<18?(s.hero.profession!=='Unemployed'?['school','work']:['school']):s.education?.enrolled?['school','work']:['work'])}${s.age<18||s.education?.enrolled?schoolShortcuts():''}${capitalsBlock(all,ui,s)}${schoolingPanel(s,e)}${guildBlock(all,ui,s)}${guildPanel(s,e)}${s.hero.profession==='Scholar'&&ownedHomeHere(s)&&(s.cartography?.interior?.roomId==='homes')?compactActivityRows(all.filter(a=>a.id==='career_work').map(a=>({...a,label:'Copy and Research at Home'})),ui,s):''}${ongoing}`;
 else if(pane==='recovery'){const v=travelEnergyView(s),homeReason=ownedHomeHere(s)?homeRestReason(s,{visiting:true}):null,home=ownedHomeHere(s)?interactionChoice(ui,{label:'Go Home and Rest',op:'activity-home',meta:activityQuote({days:1,cost:0},s),costDetails:actionCostDetails(s,{days:1,cost:0}),description:'Rest in your own bed to restore all Focus and ease 8 Stress.',disabledReason:homeReason}):'';content=`<p class="activity-intro">Health ${s.hero.hp}/${s.hero.maxHp} · Focus ${v.focus}/${v.max}. Rest at home, visit the doctor, use supplies in Inventory, or make camp on your journey.</p>${renderStatusReference(s,ui,{context:'recovery'})}${home}${shortcuts(['doctor','inn'])}${compactActivityRows(all.filter(a=>a.id==='trail_camp'||/^battlecraft_treat_/.test(a.id)||/^health_(rest|support|routine)$/.test(a.id)),ui,s)}${recoveryPanel(s,ui)}${ongoing}`;}
 else if(pane==='training')content=renderTournamentCard(s,ui,all,{potionReason:consumableReason(s,'potions')})+compactActivityRows(all.filter(a=>a.id==='tournament_invite'),ui,s)+compactActivityRows(all.filter(a=>/^(yard_|train$|life_exercise$|grow_(weapons|defense|arcana|stealth|survival)|rpg_practice_|rpg_train_|battlecraft_learn_|battlecraft_read_bestiary)/.test(a.id)),ui,s)+battlecraftPanel(s,ui.e)+bestiaryPanel(s,ui.e)+shortcuts(s.age>=18?['watch','mentor']:['mentor']);
 else if(pane==='crime'){
  content=`<p class="activity-intro">Choose an act and someone who is here. Your attributes add to a d20; a 1 fails and a 20 succeeds. The watch can investigate reported crimes.</p><div class="crime-choices">${MISDEEDS.map(c=>{const rows=all.filter(a=>a.crime===c.id),check=crimeCheck(s,c),crimeLabel=c.id==='theft'?'Pickpocket':c.label;return `<details class="crime-option" data-disclosure="crime:${c.id}"><summary><strong>${e(crimeLabel)}</strong><span>${s.age<c.age?'Age '+c.age+'+':check.chance+'% · d20 + '+check.bonus+' / '+check.dc}</span></summary>${s.age<c.age?`<p>Available from age ${c.age}.</p>`:rows.length?`<form class="crime-attempt" data-crime-form="${c.id}"><label><span>Someone Here</span><select name="crimeAction" aria-label="${e(crimeLabel)} target">${rows.map(a=>`<option value="${e(a.id)}"${a.disabledReason?' disabled':''}>${e(a.label.split(' — ').slice(1).join(' — '))}</option>`).join('')}</select></label><p>${e(rows[0].description)}</p>${rows.every(a=>a.disabledReason)?`<p class="disabled-reason">${e(rows[0].disabledReason)}</p>`:''}<button type="submit" class="button secondary small"${rows.every(a=>a.disabledReason)?' disabled':''}>${e(crimeLabel)}</button></form>`:'<p>No eligible person is in this area. Walk through a settlement to find people.</p>'}</details>`;}).join('')}</div>`;
  const propertyThefts=all.filter(a=>a.id==='justice_steal'||a.id==='justice_burglary');
  if(propertyThefts.length)content+=`<details class="crime-option property-theft-options" data-disclosure="crime:property"><summary><strong>Stall &amp; Household Property</strong></summary><p class="small-copy">These longer attempts use stealth and agility against the merchant’s existing guards, not the pickpocket d20 above. A stolen weapon remains real equipment with its original owner recorded.</p>${compactActivityRows(propertyThefts,ui,s)}</details>`;
  const plannedJob=all.filter(a=>a.id.startsWith('justice_job_'));
  if(plannedJob.length)content+=`<details class="crime-option property-theft-options" data-disclosure="crime:counting-table"><summary><strong>Planned Counting-Table Job</strong></summary><p class="small-copy">One finite adult opportunity. Its three approaches need different actual information and have separately quoted approach and departure chances, not the pickpocket d20 above. Reading accepts nothing; only a successful final departure gives the exact stolen silver. No instant Gold payout.</p>${compactActivityRows(plannedJob,ui,s)}</details>`;
 }
 else if(pane==='fun'){
  const groups=[['Time for Yourself',all.filter(a=>/^(leisure_(walk|outdoors|sketch|picnic)|pastime_(interest|practice))$/.test(a.id))],['At the Tavern',all.filter(a=>/^leisure_(music|meal|boardgames|drink)$/.test(a.id))],['With Your Circle',all.filter(a=>a.id==='leisure_circle')],['Games',all.filter(a=>/^fun_(pairs$|dice_)/.test(a.id))]];
  content=`<p class="activity-intro">Stress ${s.life.stress}/100 · Take a day for yourself. Every outing shows its time, cost and effect.</p>${renderStatusReference(s,ui,{context:'fun'})}${(s.cartography?.interior?.roomId||'gate')!=='tavern'?shortcuts(['inn']):''}<div class="leisure-groups">${groups.filter(([,rows])=>rows.length).map(([label,rows])=>`<section class="leisure-group"><h3>${e(label)}</h3>${compactActivityRows(rows,ui,s)}</section>`).join('')}</div>${s.socialLife?.game?button("Resume Runestone Pairs","runestone-resume","","secondary"):""}${renderRepertoire(s,all,ui)}${pairs}${s.repertoire?.project?'':ongoing}`;
 }

 else content=compactActivityRows(all.filter(a=>a.id==='rpg_intrigue_open'),ui,s)+compactActivityRows(all.filter(a=>/^leisure_(walk|read|circle)$/.test(a.id)||s.age<12&&/^grow_(play|nursery)$/.test(a.id)||a.id==='pastime_petcare'),ui,s)+personalServicesPanel(s,all,ui)+ongoing;
 if(!content)content='<p class="activity-empty">Other activities open as you grow and explore. Finish any waiting moment first.</p>';
 return chapter('Activities','Make something of your day.','YOUR DAY')+`<div class="activities-simple">${tabs}${renderActionCostHelp(s,ui,'activity-costs')}<section class="activity-category" aria-label="${e(ACTIVITY_TABS.find(t=>t[0]===pane)[1])}" data-activity-category="${pane}">${content}</section></div>`;
}

return {ACTIVITY_TABS,compactActivityRows,guildPanel,renderActivities,schoolingPanel};
})();
const __maze_known_route = (() => {
// Route advice only. No engine, content, action execution, RNG or save effects.
const COUNT=121;
const integer=(v,min=0,max=120)=>Number.isSafeInteger(v)&&v>=min&&v<=max;
const list=v=>Array.isArray(v)&&v.length<=COUNT&&new Set(v).size===v.length&&v.every(id=>integer(id));
const directions=[['north',0,-1],['east',1,0],['south',0,1],['west',-1,0]];
const direction=(a,b)=>directions.find(([,dx,dy])=>a.x+dx===b.x&&a.y+dy===b.y)?.[0];
const dangerous=kind=>['enemy','guardian','trap'].includes(kind);

/** Project only visited nodes. kindAt must use effective v2 overlay kinds.
 * markedRooms comes from the owner's already-validated mapMemory, never fog.
 * firstStepIds comes from currently enabled canonical maze_step actions. */
function projectVisitedMazeGraph(m,layout,{kindAt,firstStepIds,markedRooms=[],paused=false}={}) {
  const SIZE=layout?.size;
  if(!m||![5,7,11].includes(SIZE)||!list(m.visited)||!m.visited.includes(m.position)||!list(m.cleared)
    ||!Array.isArray(layout.cells)||layout.cells.length!==SIZE*SIZE
    ||typeof kindAt!=='function'||!list(firstStepIds)||!list(markedRooms)||typeof paused!=='boolean')return null;
  const visited=new Set(m.visited),cleared=new Set(m.cleared),nodes=[];
  for(const id of [...visited].sort((a,b)=>a-b)){
    const cell=layout.cells[id];
    if(!cell||cell.id!==id||cell.x!==id%SIZE||cell.y!==Math.floor(id/SIZE)||!list(cell.doors))return null;
    const doors=[];
    for(const to of cell.doors){
      if(!visited.has(to))continue;
      const other=layout.cells[to];
      if(!other||!Array.isArray(other.doors)||!other.doors.includes(id)||!direction(cell,other))continue;
      doors.push(to);
    }
    const kind=kindAt(m,id);
    if(typeof kind!=='string'||!['entrance','empty','cache','enemy','guardian','trap','camp','inscription','objective','witness','dilemma'].includes(kind))return null;
    nodes.push({id,x:cell.x,y:cell.y,doors,blocked:!cleared.has(id)&&dangerous(kind)});
  }
  return {size:SIZE,position:m.position,previous:m.previous,paused,nodes,
    firstStepIds:firstStepIds.filter(id=>visited.has(id)),markedRooms:markedRooms.filter(id=>visited.has(id))};
}

function validGraph(graph) {
  const SIZE=graph?.size;
  if(!graph||![5,7,11].includes(SIZE)||!integer(graph.position)||!integer(graph.previous)||typeof graph.paused!=='boolean'
    ||!Array.isArray(graph.nodes)||graph.nodes.length<1||graph.nodes.length>COUNT
    ||!list(graph.firstStepIds)||!list(graph.markedRooms))return false;
  const ids=new Set();
  for(const node of graph.nodes){
    if(!node||!integer(node.id,0,SIZE*SIZE-1)||ids.has(node.id)||node.x!==node.id%SIZE||node.y!==Math.floor(node.id/SIZE)
      ||!list(node.doors)||typeof node.blocked!=='boolean')return false;
    ids.add(node.id);
  }
  return ids.has(graph.position)&&graph.firstStepIds.every(id=>ids.has(id))&&graph.markedRooms.every(id=>ids.has(id));
}

/** Bounded BFS over a visited-only snapshot. There is intentionally no follow. */
function shortestVisitedMazeRoute(graph,target) {
  const result=status=>({status,path:[],directions:[],walks:0});
  if(!validGraph(graph))return result('invalid-graph');
  const nodes=new Map(graph.nodes.map(node=>[node.id,node]));
  if(!integer(target)||!nodes.has(target)||!graph.markedRooms.includes(target))return result('invalid-target');
  if(target===graph.position)return {status:'already-here',path:[target],directions:[],walks:0};
  if(graph.paused)return result('paused');
  if(nodes.get(target).blocked)return result('blocked-danger');
  const queue=[graph.position],parents=new Map([[graph.position,null]]);
  for(let index=0;index<queue.length;index++){
    const at=queue[index],from=nodes.get(at);
    const candidates=from.doors.filter(to=>{
      const next=nodes.get(to);
      return next&&!next.blocked&&next.doors.includes(at)&&direction(from,next)
        &&(at!==graph.position||graph.firstStepIds.includes(to)&&(!from.blocked||to===graph.previous));
    }).sort((a,b)=>directions.findIndex(([name])=>name===direction(from,nodes.get(a)))
      -directions.findIndex(([name])=>name===direction(from,nodes.get(b))));
    for(const to of candidates){
      if(parents.has(to))continue;
      parents.set(to,at);
      if(to===target){
        const path=[to];while(parents.get(path[0])!==null)path.unshift(parents.get(path[0]));
        return {status:'found',path,directions:path.slice(1).map((id,i)=>direction(nodes.get(path[i]),nodes.get(id))),walks:path.length-1};
      }
      queue.push(to);
    }
  }
  return result('no-known-route');
}

return {projectVisitedMazeGraph,shortestVisitedMazeRoute};
})();
const __maze_map_ui = (() => {
const { mazeLayout, mazeRoomCell, mazeMapRuntime } = __maze_v31;
const { mazeMapIdentity, sameMazeMapIdentity, validateMazeMapMemory, MAZE_MAP_LIMITS } = __maze_map_memory;
const { projectVisitedMazeGraph, shortestVisitedMazeRoute } = __maze_known_route;
const MAZE_MARK_LABELS=Object.freeze({danger:'Danger',cache:'Cache',revisit:'Revisit','return-stair':'Return stair'});
const MAZE_MARK_SYMBOLS=Object.freeze({danger:'! ',cache:'◇',revisit:'↺','return-stair':'↟'});
const position=(id,size)=>`column ${id%size+1}, row ${Math.floor(id/size)+1}`;
const entryName=(m,id)=>{const c=mazeRoomCell(m,id);return `${c.title||c.kind+' room'} · ${position(id,mazeLayout(m).size)}`;};

/** Ephemeral controls deliberately reset to Walk on reload or actor/run change. */
function currentMazeMapSession(s,previous){
 const m=s?.maze;if(!m)return null;const {context,rules}=mazeMapRuntime(s),identity=mazeMapIdentity(m,rules);
 if(!identity)return null;
 if(!previous||previous.generation!==context.generation||!sameMazeMapIdentity(previous.identity,m,rules))
  return {identity,generation:context.generation,mode:'walk',selected:m.position,routeTarget:null};
 const selected=m.visited.includes(previous.selected)?previous.selected:m.position;
 return {...previous,mode:previous.mode==='inspect'?'inspect':'walk',selected,
  routeTarget:m.visited.includes(previous.routeTarget)?previous.routeTarget:null};
}

/** Safe read model; no unknown titles/kinds or future exits are exposed. */
function mazeMapView(s,actions,previous){
 const m=s.maze,session=currentMazeMapSession(s,previous);if(!m||!session)return null;
 const runtime=mazeMapRuntime(s),valid=validateMazeMapMemory(m,runtime.context,runtime.rules);
 const entries=valid?(m.mapMemory?.entries||[]).map(row=>({...row})):[],selected=entries.find(row=>row.roomId===session.selected)||null;
 const marked=entries.filter(row=>row.mark),markedRooms=marked.map(row=>row.roomId);
 const graph=projectVisitedMazeGraph(m,mazeLayout(m),{kindAt:runtime.rules.kindAt,
  firstStepIds:actions.filter(a=>a.id.startsWith('maze_step_')&&!a.disabledReason).map(a=>Number(a.id.slice(10))),
  markedRooms,paused:!runtime.context.editingAllowed});
 const route=session.routeTarget===null?null:shortestVisitedMazeRoute(graph,session.routeTarget);
 const selectedCell=mazeRoomCell(m,session.selected);
 return {session,entries,selected,marked:marked.map(row=>({...row,label:entryName(m,row.roomId)})),route,
  selectedLabel:entryName(m,session.selected),editingAllowed:valid&&runtime.context.editingAllowed,
  stair:selectedCell.kind==='entrance'||selectedCell.kind==='objective'&&m.objective===true};
}

function mazeRouteSummary(route){
 if(!route)return '';
 return {found:`${route.walks} walk${route.walks===1?'':'s'} through recorded rooms.`,
  'already-here':'This marked room is your current location.',
  'invalid-target':'Choose a marked, recorded room to show a route.',
  'blocked-danger':'The marked room still has unresolved danger. No route into it is shown.',
  paused:'Resolve the current moment before planning a route.',
  'no-known-route':'No route through recorded rooms without unresolved danger is available.',
  'invalid-graph':'This recorded route cannot be shown.'}[route.status]||'';
}

function renderMazeMapTools(s,v,ui){
 if(!v)return '';const {e,button}=ui,m=s.maze,session=v.session;
 const modes=`<nav class="maze-map-modes" aria-label="Maze map mode">${['walk','inspect'].map(mode=>`<button type="button" class="button ${session.mode===mode?'secondary':'ghost'} small" data-op="maze-map-mode" data-id="${mode}" aria-pressed="${session.mode===mode}">${mode==='walk'?'Walk':'Inspect & mark'}</button>`).join('')}</nav>`;
