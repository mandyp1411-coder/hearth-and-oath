  if (e.gold) s.hero.gold += e.gold;
  if (e.cost && s.hero.gold >= e.cost) s.hero.gold -= e.cost;
  if (e.herbs) s.flags.herbs = (s.flags.herbs || 0) + e.herbs;
  if (e.career) {s.life.career.experience += e.career;addCareerExperience(s,e.career);}
