 if(!link||!actual||actual.alive===false||p.age<18||!ownedHomeHere(s)||s.cartography?.interior?.siteId!==s.locationId||s.cartography.interior.roomId!=='homes'||familyResidence(s,actual)!==s.locationId)return false;
