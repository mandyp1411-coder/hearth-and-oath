const defaults={scale:1,font:'serif',singleKeyShortcuts:true};
function normalizeDisplay(v={}){const n=Number(v.scale);return {scale:Number.isFinite(n)?Math.max(1,Math.min(1.5,n)):1,font:v.font==='plain'?'plain':'serif',singleKeyShortcuts:v.singleKeyShortcuts!==false,...(v.showNumbers===true?{showNumbers:true}:{}),...(v.reducedMotion===true?{reducedMotion:true}:{})};}
