  if(d.claim&&(!site(d.claim.locationId)||d.claim.locationId!==s.locationId||!s.realm.regions.some(r=>r.id===d.claim.regionId)))return false;
  return Array.isArray(d.history)&&d.history.length<=80&&d.history.every(h=>str(h.id)&&site(h.locationId)&&int(h.startDay)&&int(h.endDay)&&int(h.floor,1,6)&&int(h.rooms,0,36)&&validateRadiantHistory(h));
}

return {adventureActions,adventureEncounter,adventureEventIds,adventureView,afterAdventureBattle,applyAdventureAction,applyAdventureChoice,awardLoot,contractArchive,initializeAdventuring,onAdventuringTime,refreshAdventureBoard,validAdventureContext,validateAdventuring};
})();
const __quest_records = (() => {
const { researchDefinition, researchInterpretation } = __research_definitions;
const { originJournalRows, originView } = __family_origins;
const { regionalQuestRows } = __regional_world_v33;
