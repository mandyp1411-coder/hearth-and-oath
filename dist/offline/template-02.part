function here(s,p){const site=s.world?.locations.find(l=>l.id===s.locationId);return !!p&&p.age>=18&&p.available!==false&&p.alive!==false&&p.source?.alive!==false&&!p.retired&&!p.recordedDeath&&!p.commitmentOnly&&!/hostile|enemy/i.test(p.role||'')&&!['withdrawn','refusing','hostile'].includes(p.source?.agency?.status||p.agency?.status)&&s.age>=18&&s.phase==='adult'&&!s.event&&!s.battle&&!s.maze&&!s.dungeon&&!s.rpg?.expedition&&!s.adventuring?.expedition&&!s.justice?.prison&&!s.cartography?.offsite&&!s.cartography?.pending&&!s.timeline?.journey&&p.locationId===s.locationId&&(!p.roomId||p.roomId===(s.cartography?.interior?.roomId||'gate'))&&!!site&&!['destroyed','evacuated'].includes(site.status)&&site.servicesAvailable!==false&&!s.realm?.politics?.holds?.some(h=>h.siteId===s.locationId&&h.status==='held');}
function householdLink(s,personId,at=s.day){
