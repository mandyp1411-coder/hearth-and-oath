 const p={...person,id,role,locationId,regionId,baseAge:age,bornDay:s.day-age*365,age,alive:true,bond:35,memories:[],knownFacts:[],deathAge:75+seededRoll(s.seed,id+':death',18)+agingPolicy(person).elder-65};
