function contractArchive(s){const rows=s.adventuring?.archive||[],seen=new Set(rows.map(row=>row.id));return [...rows,...(s.adventuring?.contracts||[]).filter(c=>closed(c)&&!seen.has(c.id)).map(c=>contractRecord(s,c))].map(row=>structuredClone(row));}
function initializeAdventuring(s){
