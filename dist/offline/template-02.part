 return `<section class="nearby-people"><div class="section-heading"><h3 id="nearby-people-heading" tabindex="-1">In this settlement</h3><span class="badge">${all.length} residents</span></div><form id="nearby-search" class="people-search"><label class="sr-only" for="nearby-query">Find someone in this settlement</label><input id="nearby-query" name="query" value="${e(query)}" placeholder="Name or role here"><button class="button secondary small" type="submit">Find</button></form>${shown.length?`<div class="nearby-people-list">${shown.map(person=>`<button type="button" class="nearby-person" data-op="spatial-contact" data-id="${e(person.id)}">${renderAvatar(person,{size:'small',age:person.age})}<span><strong>${e(person.name)}</strong><small>${e(roleTitle(person.role))} · ${person.age}</small></span><span aria-hidden="true">›</span></button>`).join('')}</div>`:'<p>No present resident matches this search. Searching this list does not introduce a person.</p>'}<p class="small-copy" data-view-results>${people.length} people match · Page ${page+1} of ${pages}.</p>${pages>1?`<nav class="contact-pagination" aria-label="Local residents">${button('Previous','nearby-page',page-1,'ghost small',page===0)}${button('Next','nearby-page',page+1,'ghost small',page+1>=pages)}</nav>`:''}</section>`;
