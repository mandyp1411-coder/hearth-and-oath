    } else if (pick === 'service') begin(s, ctx, 'legal_service', c.id, `${s.hero.profession || 'Practical'} community restitution`, eventId === 'sanctuary_case_capture' ? 8 : 6, 0, { reduction: Math.min(3, evidence(s, c.locationId)) });
