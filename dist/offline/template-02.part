 if(reason==='completed'&&t.results.length===3&&t.results.every(r=>r.outcome==='win')&&!t.prize){t.prize={key:t.id+':purse',amount:TOURNAMENT_PURSE,day};return TOURNAMENT_PURSE;}return 0;
}
