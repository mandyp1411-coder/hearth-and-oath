 if(x){const current=x.rooms.find(r=>r.id===x.roomId),known=x.rooms.filter(r=>r.visited||current.neighbors.includes(r.id));return {kind:'rpg',title:x.title,room:current.title,description:current.description||'Old passages lead away from this chamber.',rooms:known.map(r=>({...r,current:r.id===current.id,label:r.visited?r.title:passageDirection(s.seed,x.id,current,r)})),exits:known.filter(r=>current.neighbors.includes(r.id)).map(r=>({id:r.id,label:r.visited?r.title:passageDirection(s.seed,x.id,current,r),visited:r.visited})),actions:rpgView(s).actions,visited:x.rooms.filter(r=>r.visited).length,goal:x.completed?'Your work here is complete. You can retrace your route or leave the descent.':x.purpose||'Explore the passages, attend to the people you find, and return with what you earn.'};}
 const radiant=radiantView(s);
 if(radiant){const current=radiant.rooms.find(r=>r.id===radiant.current),routes=(s.event?.id==='adventure_room'?s.event.choices:[]).filter(c=>c.id.startsWith('route_'));return {kind:'dungeon',title:'The '+s.adventuring.expedition.theme+' Descent',room:current?.title||'The Current Chamber',description:current?.resolved?'Your earlier work in this room remains. Choose a doorway to continue.':'You stand inside a chamber beneath the surface.',floor:radiant.floor,rooms:radiant.rooms.map(r=>({...r,id:'radiant_'+r.id,current:r.id===radiant.current,neighbors:r.neighbors.map(n=>'radiant_'+n)})),exits:routes.map(c=>{const r=radiant.rooms.find(r=>String(r.id)===c.id.slice(6));return {id:'radiant_'+c.id.slice(6),label:r?.label||c.label,visited:r?.visited,disabledReason:c.disabledReason};}),actions,visited:radiant.rooms.filter(r=>r.visited).length,goal:radiant.goal.description,completed:radiant.completed};}
 const d=dungeonView(s);
 if(d){const current=d.rooms.find(r=>r.current),routes=(s.event?.choices||[]).filter(c=>c.id.startsWith('route_'));const exits=d.rooms.filter(r=>!r.current&&(current?.exits.includes(r.id)||routes.some(c=>c.id==='route_'+r.id)));return {kind:'dungeon',title:d.title,room:d.room.title,description:d.room.description,rooms:d.rooms.map(r=>({...r,x:r.mapIndex%3,y:Math.floor(r.mapIndex/3),neighbors:r.exits,label:r.title,resolved:r.cleared})),exits:exits.map(r=>({id:r.id,label:r.title,visited:r.visited,disabledReason:routes.find(c=>c.id==='route_'+r.id)?.disabledReason})),actions,visited:d.rooms.filter(r=>r.visited).length,goal:d.objective?.description||d.description,completed:d.complete};}
 const old=s.adventuring?.expedition;
 if(old)return {kind:'dungeon',title:'The '+old.theme+' Descent',room:'Chamber '+(old.room+1),description:'The chamber and its unfinished work remain where you left them.',rooms:[],exits:[],actions,visited:old.cleared.length,floor:old.floor,goal:'Continue or withdraw from the saved descent.'};
 return null;
}
function dungeonMap(v,ui){
 const {e}=ui,rooms=v.rooms,ids=new Set(rooms.map(r=>r.id)),point=r=>[54+(r.x||0)*90,48+(r.y||0)*85],width=Math.max(280,...rooms.map(r=>point(r)[0]+100)),height=Math.max(180,...rooms.map(r=>point(r)[1]+58));
 const edges=rooms.flatMap(r=>r.visited?(r.neighbors||[]).filter(id=>ids.has(id)&&(String(r.id)<String(id)||!rooms.find(n=>n.id===id).visited)).map(id=>{const a=point(r),b=point(rooms.find(n=>n.id===id));return `<path d="M${a.join(' ')}L${b.join(' ')}"/>`;}):[]).join('');
 return `<details class="dungeon-pocket-map" data-disclosure="dungeon-pocket-map"><summary>Your Dungeon Map · ${v.visited} Explored</summary><svg viewBox="0 0 ${width} ${height}" role="group" aria-label="Discovered Dungeon Rooms"><g class="dungeon-map-paths">${edges}</g>${rooms.map(r=>{const p=point(r);return `<g role="button" tabindex="0" data-op="dungeon-select" data-id="${e(r.id)}" aria-label="${e(r.label)}" aria-describedby="spatial-map-help" class="${r.current?'current':''}"><circle cx="${p[0]}" cy="${p[1]}" r="15"/><text x="${p[0]}" y="${p[1]+5}" text-anchor="middle">${r.current?'◆':r.resolved?'✓':r.visited?'◇':'?'}</text><text x="${p[0]}" y="${p[1]+32}" text-anchor="middle" class="dungeon-map-caption">${e(r.label.length>25?r.label.slice(0,23)+'…':r.label)}</text></g>`;}).join('')}</svg></details>`;
}
function renderDungeonCrawler(s,ui,{encounter='',selectedId=null}={}){
 const v=dungeonPresentation(s);if(!v)return '';const {e,button,actionCards}=ui,selected=v.rooms.find(r=>r.id===selectedId);
 const doors=v.exits.map((exit,i)=>`<button type="button" class="dungeon-door ${exit.id===selectedId?'selected':''}" data-op="dungeon-select" data-id="${e(exit.id)}" aria-pressed="${exit.id===selectedId}" aria-describedby="spatial-map-help" style="--door-position:${(i+1)/(v.exits.length+1)*100}%"><span class="door-arch" aria-hidden="true"><span>${exit.visited?'◇':'?'}</span></span><strong>${e(exit.label)}</strong><small>${exit.visited?'A Known Passage':'Beyond This Door'}</small></button>`).join('');
 const roomActions=v.actions.filter(a=>v.kind==='rpg'?a.id.startsWith('rpg_room_')||a.id.startsWith('rpg_boss_')||a.id==='rpg_leave':a.id.startsWith('explore_')&&!a.id.startsWith('explore_route_')||['adventure_continue','adventure_withdraw'].includes(a.id));
 const finalControls=encounter||actionCards(roomActions);
 const party=[{name:s.hero.name,hp:s.hero.hp,maxHp:s.hero.maxHp},...s.companions.filter(p=>p.recruited&&p.active).map(p=>({name:p.name,hp:p.hp,maxHp:p.maxHp}))];
 return `<div class="dungeon-crawler" data-dungeon-kind="${v.kind}"><header class="dungeon-heading"><div><span class="eyebrow">${e(v.title)}${v.floor?' · Floor '+v.floor:''}</span><h1>${e(v.room)}</h1></div>${button('Journal','tab','quests','ghost small')}${button('Inventory','tab','inventory','ghost small')}</header><div class="dungeon-room-stage">${renderAreaScene(s,ui,{dungeon:{room:{title:v.room}}})}<svg class="dungeon-perspective" viewBox="0 0 1000 460" preserveAspectRatio="none" aria-hidden="true"><path class="dungeon-left-wall" d="M0 0 205 100V340L0 460Z"/><path class="dungeon-right-wall" d="m1000 0-205 100v240l205 120Z"/><path class="dungeon-floor" d="m0 460 205-120h590l205 120Z"/><path class="dungeon-ceiling" d="m0 0 205 100h590L1000 0Z"/><path class="dungeon-stone-lines" d="M0 90 205 160M0 205 205 235M0 330 205 300M1000 90 795 160M1000 205 795 235M1000 330 795 300M80 0 265 100M920 0 735 100M80 460 265 340M920 460 735 340M0 380h1000"/></svg><div class="dungeon-doors">${doors||`<div class="dungeon-sealed"><span>◆</span><strong>${encounter?'Attend to This Room':'A Moment to Look Around'}</strong></div>`}</div></div><div class="dungeon-travel-strip"><span>${v.visited} Rooms Explored</span><span>${s.hero.potions} Potions</span>${s.adventuring?.expedition?`<span>${s.adventuring.rations} Rations</span>`:''}<span>${v.completed?'Objective Complete':'Exploration in Progress'}</span></div><p id="spatial-map-help" class="small-copy">Inspect a doorway with click, Enter or Space, then choose its separate travel command. Double-click follows an available doorway. Unseen rooms keep their contents hidden.</p>${selectedId?`<section class="dungeon-door-inspection"><h2 id="spatial-selection-title" tabindex="-1" aria-describedby="spatial-selection-details">${e(selected?.label||v.exits.find(r=>r.id===selectedId)?.label||'No Visible Doorway')}</h2>${selected||v.exits.some(r=>r.id===selectedId)?renderSpatialCommit(s,v.kind,selectedId,v.actions,ui):'<p id="spatial-selection-details">That doorway is not visible from this room.</p>'}</section>`:''}<section class="dungeon-room-account"><p>${e(v.description)}</p>${finalControls}</section><footer class="dungeon-party-strip" aria-label="Traveling Party">${party.map(p=>`<div><strong>${e(p.name)}</strong>${Number.isFinite(p.hp)&&Number.isFinite(p.maxHp)?`<span>Health ${p.hp}/${p.maxHp}</span>`:'<span>Traveling With You</span>'}</div>`).join('')}</footer><details class="dungeon-objective" data-disclosure="dungeon-objective"><summary>Your Purpose Here${v.completed?' · Complete':''}</summary><p>${e(v.goal)}</p></details>${dungeonMap(v,ui)}</div>`;
}

return {dungeonPresentation,renderDungeonCrawler};
})();
const __interface_workspaces = (() => {
// Every system has one shelf, and each shelf shows one subject at a time.
const WORKSPACE_SECTIONS = {
 life:[['present','Today'],['plans','Plans & calendar'],['years','Your Years']],
 character:[['overview','Identity'],['training','Skills & training'],['personality','Personality & tastes'],['callings','Callings'],['condition','Supernatural']],

 journal:[['active','Active Quests'],['archive','Archive'],['notes','Notes']],
};
function workspaceSection(route,value) {const rows=WORKSPACE_SECTIONS[route];return rows?.some(([id])=>id===value)?value:rows?.[0]?.[0]||null;}
function selectSection(ui,sections) {
 const entries=Object.entries(sections);if(!ui.section)return entries.map(([,content])=>content).join('');
 return sections[ui.section]??entries[0]?.[1]??'';
}
function renderWorkspaceNavigation(route,selected,ui) {
 const rows=WORKSPACE_SECTIONS[route];if(!rows)return '';
 const active=workspaceSection(route,selected);
 return `<nav class="workspace-sections" aria-label="${ui.e(route==='relationships'?'People':route)} sections">${rows.map(([id,label])=>ui.button(ui.e(label),'workspace-section',route+':'+id,`ghost ${active===id?'active':''}`,false,active===id)).join('')}</nav>`;
}

return {WORKSPACE_SECTIONS,renderWorkspaceNavigation,selectSection,workspaceSection};
})();
const __people_records = (() => {
const { roleTitle } = __interaction_ui_v40;
const { rememberedContacts, getThread } = __conversations;
const { contactPage } = __character_voice;
const { renderAvatar } = __avatar;
const relation=n=>n>=80?'A close bond':n>=65?'Trusted':n>=40?'Familiar':n>=20?'Acquainted':'Distant';
const factLabels={shared_methods:'You shared methods for inspecting household work and making their own choices.'};
const words=m=>typeof m==='string'?m:m?.text||m?.description||'';
function readableFact(s,f){
 const key=typeof f==='string'?f:'';if(factLabels[key])return factLabels[key];
 if(!key)return words(f);
 const match=/^story_(.+)_(\d+)_(care|enterprise|coercion)$/.exec(key),arc=match&&s.stories?.arcs.find(a=>a.id===match[1]),choice=arc?.choices?.[Number(match?.[2])];
 if(choice&&choice.id===match[3])return `Chapter ${Number(match[2])+1}: ${choice.outcome||choice.label}`;
 if(key==='condition_vampire')return 'You told this person about your vampirism.';
 if(key==='condition_lycanthrope')return 'You told this person about your transformation.';
 return /^[a-z0-9_:-]+$/.test(key)?'An earlier shared experience remains recorded in your conversations.':key;
}
const BOND_CATEGORIES=[['close','Close Contacts'],['household','Household'],['party','Party'],['recent','Recently Met'],['family','Family'],['lovers','Lovers'],['friends','Friends'],['acquaintances','Acquaintances'],['rivals','Rivals'],['enemies','Enemies'],['all','Everyone Met']];
function bondCategory(s,p){
 if(s.age>=18&&p.age>=18&&(p.id===s.life?.partnerId||p.id===s.life?.courtshipId))return 'lovers';
 if(/enemy|hostile/i.test(p.role||'')||p.bond<=5)return 'enemies';
 if(p.familyRole||p.id===s.life?.partnerId||(s.life?.children||[]).some(c=>c.id===p.id)||(s.family?.members||[]).some(m=>m.personId===p.id)||p.role==='your child')return 'family';
 if(/rival/i.test(p.role||''))return 'rivals';
 if(p.kind==='companion'||/friend|partner/i.test(p.role||'')||p.bond>=65)return 'friends';
 return 'acquaintances';
}
function peopleRecordPage(s,{scope='family',query='',page=0,selectedId=null,focusId=null}={}) {
 const people=rememberedContacts(s),category=scope==='circle'?'family':scope==='nearby'?'all':scope;
 const household=new Set((s.family?.members||[]).filter(m=>m.availability==='present').map(m=>m.personId)),party=new Set((s.companions||[]).filter(p=>p.recruited).map(p=>p.id));
 const filtered=people.filter(p=>category==='all'||category==='close'&&p.bond>=65||category==='household'&&household.has(p.id)||category==='party'&&party.has(p.id)||category==='recent'&&Number.isSafeInteger(s.conversations?.meetings?.[p.id]?.lastDay)&&s.day-s.conversations.meetings[p.id].lastDay<=30||bondCategory(s,p)===category||category==='family'&&p.id===s.life?.partnerId),v=contactPage(s,filtered,{scope:'all',query,page,focusId});
 return {...v,people,selected:v.contacts.find(p=>p.id===selectedId)||v.contacts[0]||null};
}
function renderPeopleRecords(s,ui,options={}) {
 const {e,button,date,paragraphs}=ui,v=options.view||peopleRecordPage(s,options),p=v.selected;
 const scopes=BOND_CATEGORIES;
 const rows=v.contacts.map(c=>`<button type="button" class="person-record-row ${c.id===p?.id?'active':''}" data-op="contact" data-id="${e(c.id)}" aria-pressed="${c.id===p?.id}">${renderAvatar(c,{size:'small',age:c.age})}<span><strong>${e(c.name)}</strong><small>${e(roleTitle(c.role))} · ${e(relation(c.bond))}</small></span><span>${c.recordedDeath?'Deceased':c.retired?'Retired':c.available===false?'Remembered':e(c.bond)+'/100'}</span></button>`).join('');
 const list=`<aside class="people-register"><h2 id="people-results-heading" tabindex="-1">People You Have Met</h2><nav class="people-scope" aria-label="Contact scope">${scopes.map(([id,label])=>button(label,'people-scope',id,`ghost small ${options.scope===id?'active':''}`,false,(options.scope||'family')===id)).join('')}</nav><form id="people-search" class="people-search"><label class="sr-only" for="people-query">Find a remembered person</label><input id="people-query" name="query" value="${e(options.query||'')}" placeholder="Name or role"><button class="button secondary small" type="submit">Find</button>${options.query?button('Clear Search','people-clear','','ghost small'):''}</form><p class="small-copy">${options.scope==='recent'?'Recorded meetings in the last 30 days.':options.scope==='household'?'People recorded as present in your household.':options.scope==='party'?'Recruited companions, including reserves.':options.scope==='close'?'People with a recorded bond of at least 65.':'Only people already known to this life.'}</p><div class="person-register-list">${rows||'<p>No remembered person matches this view. Meet people in a settlement; opening this record creates no acquaintance.</p>'}</div><p class="small-copy" data-view-results>Showing ${v.total?v.page*12+1:0}–${Math.min(v.total,(v.page+1)*12)} of ${v.total} matching people · ${v.people.length} known overall · Page ${v.page+1} of ${v.pages}.</p><div class="contact-pagination">${button('Previous','people-page',v.page-1,'ghost small',v.page===0)}<small>${v.page+1} / ${v.pages}</small>${button('Next','people-page',v.page+1,'ghost small',v.page+1>=v.pages)}</div></aside>`;
 let record='<section class="person-memory"><h2>A place for the people who matter</h2><p>Your shared experiences, relationship and remembered words belong here. To speak with someone, find them in the world.</p>'+button('Go to Your Surroundings','place-open','','primary')+'</section>';
 if(p){
  const thread=getThread(s,p.id),meeting=s.conversations?.meetings?.[p.id],place=s.world.locations.find(l=>l.id===(meeting?.locationId||p.locationId));
  const repairs=(s.conversations?.repairs||[]).filter(r=>r.personId===p.id);
  const retirement=p.retired?`<section class="remembered-entry" data-person-retirement><h2>${p.recordedDeath?'A recorded public vacancy':'A recorded retirement'}</h2><p>${p.recordedDeath?'Public role ended after their recorded death':'Retired from'} ${e(roleTitle(p.role))}${Number.isSafeInteger(p.retiredDay)?' · '+e(date(p.retiredDay)):''}.${p.successorName?' '+e(p.successorName)+' took over the public role.':''}</p><p>${e(p.availabilityReason||'Their earlier public life remains recorded; later whereabouts are unrecorded.')} ${p.recordedDeath?'The original person and your shared history remain recorded.':'Retirement is not a report of death and does not erase your relationship.'}${p.commitmentOnly?' Your previously accepted return remains available without beginning another public service.':''}</p></section>`:'';
  const memories=(p.memories||[]).map(words).filter(Boolean),childhoodAges=memories.map(m=>/^When you were (\d+):/.exec(m)).filter(Boolean).map(m=>Number(m[1])),facts=[...(p.knownFacts||[]).map(f=>readableFact(s,f)).filter(Boolean),...(p.compatibility?.known||[]).map(k=>k.label+': '+k.value)];
  record=`<section class="person-memory" data-person-memory="${e(p.id)}"><header class="person-memory-heading">${renderAvatar(p,{size:'large',age:p.age})}<div><span class="eyebrow">A PERSON IN YOUR LIFE</span><h1>${e(p.name)}</h1><p>${e(roleTitle(p.role))} · ${p.retired?'Age '+e(p.ageAtRetirement??p.age)+(p.recordedDeath?' when their public role ended':' when they retired'):p.available===false?'Earlier acquaintance':'Age '+e(p.age)}</p><strong>${e(relation(p.bond))} · ${e(p.bond)}/100</strong></div></header><p>${e(p.description)}</p>${retirement}${p.mentorStudy?`<section class="remembered-entry" data-mentor-study><h2>Your study with this person</h2><p>${p.mentorStudy.met?'You met this mentor formally.':'No formal mentor meeting is recorded.'} ${e(p.mentorStudy.lessons)} supervised preparation lessons are recorded with this person. Earned callings and trained skills remain your own.</p></section>`:''}${p.boundary?`<p class="notice" data-person-boundary>${e(p.boundary)}</p>${button('Find Them','person-place',p.id,'secondary small')}`:''}<dl class="memory-facts"><div><dt>${meeting?'Last met':'Recorded home'}</dt><dd>${e(place?.name||'Place unrecorded')}${meeting?' · '+e(date(meeting.lastDay)):''}</dd></div><div><dt>First recorded meeting</dt><dd>${meeting?e(date(meeting.firstDay)):'An exact date was not kept in this earlier record.'}${childhoodAges.length?`<p class="small-copy">Known by age ${Math.min(...childhoodAges)}; earlier shared memories do not establish an exact first-meeting date.</p>`:''}</dd></div></dl>${p.available!==false&&place?button('Find their recorded place','person-place',p.id,'secondary'):''}<section><h2>What you share</h2>${memories.slice(-10).reverse().map(m=>`<p class="remembered-entry">${e(m)}</p>`).join('')||'<p class="muted">No specific shared memory has been recorded yet.</p>'}</section>${facts.length?`<section><h2>What they trusted you with</h2>${facts.map(f=>`<p>${e(f)}</p>`).join('')}</section>`:''}${repairs.length?`<section><h2>Promises attended</h2>${repairs.map(r=>`<p>${e(date(r.day))} · ${r.days} days · ${r.cost} gold · ${r.reviewedDay===null?'Awaiting their answer':'Acknowledged in a meeting'}. The earlier account remains.</p>`).join('')}</section>`:''}${thread.messages.length?`<details class="recorded-words" data-disclosure="remembered-words-${e(p.id)}"><summary>Words kept from earlier meetings &amp; correspondence</summary><ol>${thread.messages.slice(-12).map(m=>`<li><small>${e(date(m.day))} · ${e(m.speakerName)}</small>${paragraphs(m.text)}</li>`).join('')}</ol></details>`:''}</section>`;
 }
 return `<div class="people-records-workspace"><header class="workspace-introduction"><span class="eyebrow">THE PEOPLE YOU KNOW</span><h1>Relationships</h1><p>A record of people you have met. Conversations happen in the world, where someone is actually present.</p></header><div class="people-records-layout">${list}${record}</div></div>`;
}

return {BOND_CATEGORIES,bondCategory,peopleRecordPage,renderPeopleRecords};
})();
const __education_ui = (() => {
const { EDUCATION_LABELS } = __education_progress;
function birthdayEducationRecap(s) {
  const personal=s.timeline?.yearHistory?.at(-1);if(!personal)return null;
  const school=s.education?.history?.findLast(r=>r.day===personal.day&&r.age===personal.age&&r.title==='A school year remembered');
  return {age:personal.age,day:personal.day,title:personal.title,personal:personal.summary,school:school?.text || null};
}
function renderBirthdayRecap(s,ui) {
  const v=birthdayEducationRecap(s);if(!v?.school)return '';
  const {e}=ui;
  return `<details class="panel birthday-recap" data-birthday-recap open><summary>Age ${v.age} · Birthday &amp; school year</summary><h3>${e(v.title)}</h3><p data-birthday-outcome>${e(v.personal)}</p><h3>The school year</h3><p data-school-outcome>${e(v.school)}</p><p class="small-copy">Both accounts remain in your Journal and school records.</p></details>`;
}
function renderCourseRecords(rows,ui) {
  if(!rows?.some(r=>!r.active))return '';
  return `<details class="construction-section" data-disclosure="kept-courses"><summary>Your kept course preparation</summary>${rows.map(r=>`<article class="school-route" data-course-record="${r.route}"><h3>${ui.e(r.label)} · ${r.active?'Current':'Paused'}</h3><p>${r.attendance} attended sessions · ${r.progress} course progress · ${r.performance}/100 performance${r.qualified?' · Qualification earned':''}.</p></article>`).join('')}<p class="small-copy">Returning restores the preparation shown here. A transfer takes its stated day and fee. Lessons, revisions and examinations keep their shared annual limits.</p></details>`;
}
function renderSchoolTransfer(q,ui) {
  if(!q)return '<h2>Review the current learning route</h2>';
  const {e,button}=ui;
  return `<div class="eyebrow">A COURSE TRANSFER</div><h2>Transfer to ${e(q.schoolName)}?</h2><p>From ${e(EDUCATION_LABELS[q.from])} · at ${e(q.siteName)}.</p><p>${e(q.explanation)}</p><p><strong>${q.days} day · ${q.cost} gold</strong>. ${q.annualLessons}/8 lessons and ${q.annualRevisions}/2 revisions already used this year.${q.examinedYear===undefined||q.examinedYear===null?'':` Last completed examination: age ${q.examinedYear}.`}</p>${q.disabledReason?`<p class="disabled-reason">${e(q.disabledReason)}</p>`:''}<div class="modal-buttons">${button(q.returning?'Return to this course':'Confirm transfer','school-transfer-confirm',q.to,'primary',!!q.disabledReason)}${button('Keep my current course','close-modal','','ghost')}</div>`;
}

return {birthdayEducationRecap,renderBirthdayRecap,renderCourseRecords,renderSchoolTransfer};
})();
const __economy_planning = (() => {
const { isSettlement } = __world;
const { MATERIAL_PRICES, materialValue, gearSaleValue } = __economy_values;
const { professionAnnualWage, professionWage } = __careers;
const { householdCostPreview, annualWorkRatio } = __budget;
const { COMMUNITY_CATALOG } = __community;
const { GEAR_CATALOG, ownedGear } = __gear;
const { ARTISAN_PATTERNS } = __workshop;
const ECONOMY_GOALS = [{id:'artisan',name:'A three-piece artisan kit'},...['garden','road','learning','archive'].map(id=>({id,name:COMMUNITY_CATALOG.find(c=>c.id===id).name}))];
const sumMaterials=rows=>{const m={};for(const r of rows)for(const [id,n]of Object.entries(r))if(Object.hasOwn(MATERIAL_PRICES,id))m[id]=(m[id] || 0)+n;return m;};
function economyPlan(s,goalId='road') {
  const goal=ECONOMY_GOALS.find(g=>g.id===goalId) || ECONOMY_GOALS[2],annual=householdCostPreview(s,365),activeLife=s.phase!=='retired'&&s.hero.alive!==false,canEarn=s.age>=18&&activeLife;
  const rate=professionAnnualWage(s)*annualWorkRatio(s),ordinary=canEarn?Math.floor((s.day+365)*rate/365)-Math.floor(s.day*rate/365):0;
  const wage=s.careers?.batch?.kind==='work'?s.careers.batch.wage:professionWage(s);
  const annualLiving=activeLife?annual.additionalCost:0,dedicated=activeLife&&s.age>=16?Math.floor(wage*365/3):0,net=ordinary-annualLiving;
  const m=s.realm?.sites?.[s.locationId]?.merchant,canSell=!!m&&isSettlement(s.world,s.locationId);
  const gear=canSell?ownedGear(s).filter(i=>!i.stolen&&!Object.values(s.equipment.equipped).includes(i.id)):[];
  const sales=gear.reduce((n,i)=>n+gearSaleValue(i,m),0)+(canSell?(s.adventuring?.loot || []).filter(l=>!l.stolen).reduce((n,l)=>n+Math.floor(l.value*.8),0):0);
  let fees=0,days=0,materials={},purpose='',annualMaintenance=0,committedGold=0,actionId=null,siteId=s.locationId;
  if(goal.id==='artisan') {
    const pattern=s.workshop?.patterns?.[0] || 'duelist',learned=s.workshop?.patterns?.includes(pattern),pieces=['leather_gloves','field_helm','iron_ring'].map(id=>GEAR_CATALOG.find(i=>i.id===id));
    const remaining=pieces.filter(piece=>!ownedGear(s).some(i=>i.crafted&&i.baseId===piece.id&&i.affix===pattern));
    fees=(learned?0:120)+remaining.reduce((n,i)=>n+i.recipe.gold+120,0);days=(learned?0:5)+remaining.reduce((n,i)=>n+i.craftDays+2,0);
    materials=sumMaterials(remaining.map(i=>({...i.recipe,crystal:(i.recipe.crystal || 0)+2,cloth:(i.recipe.cloth || 0)+1})));
    const project=s.workshop?.project;
    if(project&&(project.kind==='pattern'&&project.targetId===pattern||project.kind==='fitted'&&project.pattern===pattern&&remaining.some(i=>i.id===project.targetId))){siteId=project.locationId;committedGold=project.cost;fees-=project.cost;days-=project.totalDays-project.remainingDays;for(const [id,n]of Object.entries(project.materials))materials[id]=Math.max(0,(materials[id] || 0)-n);}
    purpose=`${ARTISAN_PATTERNS.find(p=>p.id===pattern).name} gloves, helm and ring: three different slots with sound quality and a chosen pattern. Requires crafting 3 and a tier 2 workbench. Stronger rare equipment remains dungeon loot.`;
  } else {
    const catalog=COMMUNITY_CATALOG.find(c=>c.id===goal.id),p=s.community?.project?.kind===goal.id?s.community.project:null;
    siteId=p?.locationId || s.locationId;
    const standing=s.community?.works?.find(w=>w.kind===goal.id&&w.locationId===siteId&&w.status==='standing');
    if(standing){const full=standing.operatingBalance>=6000;fees=full?0:1500;days=full?0:4;purpose=full?'The protected reserve already holds at least 6000 gold; no further contribution is currently offered. Services follow the actual charter and funded periods.':'This institution already exists. The next optional reserve contribution is 1500 gold; services follow its actual charter and funded periods.';annualMaintenance=standing.annualCost;actionId=full?null:`community_fund_${standing.id}`;}
    else {const stages=p?.stages || catalog.stages;committedGold=p?.paidGold || 0;fees=stages.reduce((n,r)=>n+r.cost,0)-committedGold;days=stages.reduce((n,r)=>n+r.days,0)-(p?.workedDays || 0);const total=sumMaterials(stages.map(r=>r.materials));materials=Object.fromEntries(Object.entries(total).map(([id,n])=>[id,Math.max(0,n-(p?.paidMaterials?.[id] || 0))]).filter(([,n])=>n>0));purpose=catalog.purpose+' The final milestone protects about ten years of operating funds; future maintenance is voluntary.';annualMaintenance=catalog.annualCost;actionId=p?(p.commitment?'community_continue':'community_stage'):`community_begin_${goal.id}`;}
  }
  purpose=`${s.world?.locations?.find(p=>p.id===siteId)?.name || siteId}: ${purpose}`;
  const shortfall=Object.fromEntries(Object.entries(materials).map(([id,n])=>[id,Math.max(0,n-(s.equipment?.materials?.[id] || 0))]).filter(([,n])=>n>0));
  // Cooperative purchases are packs of three. Spare inputs remain in the bag.
  const purchases=Object.fromEntries(Object.entries(shortfall).map(([id,n])=>[id,Math.ceil(n/3)*3]));
  const materialCash=materialValue(purchases),living=activeLife?householdCostPreview(s,days).additionalCost:0,total=fees+materialCash+living;
  const spendable=Math.max(0,s.hero.gold-annual.outstanding),gap=Math.max(0,total-spendable);
  return {goal,siteId,purpose,ordinary,dedicated,annualLiving,net,dedicatedNet:dedicated-annualLiving,outstanding:annual.outstanding,spendable,sales,fees,days,materials,shortfall,purchases,materialCash,living,total,gap,afterSaleGap:Math.max(0,gap-sales),years:net>0?Math.ceil(gap/net):null,annualMaintenance,committedGold,actionId};
}
function renderEconomyPlan(s,ui,{goal='road'}={}) {
  const v=economyPlan(s,goal),{e,button}=ui;
  const inputs=Object.entries(v.purchases).map(([id,n])=>`${n} ${id}`).join(', ') || 'no new material purchases';
  return `<details class="panel economy-plan" data-disclosure="economy-plan" open><summary>Savings, trade &amp; a wanted goal</summary><p class="small-copy">${s.phase==='retired'?'This life is closed; no future wages or living costs are projected. ':''}Ordinary Age up and dedicated work are alternative schedules. Forecasts use current wages, household priorities and upkeep; birthdays and choices can change them.</p><div class="career-stats"><div><span>Ordinary year, net</span><strong>${v.net>=0?'+':''}${v.net}g</strong><small>${v.ordinary} income − ${v.annualLiving} living costs</small></div><div><span>365 dedicated work days, net</span><strong>${v.dedicatedNet>=0?'+':''}${v.dedicatedNet}g</strong><small>${v.dedicated} agreed-rate wages − ${v.annualLiving} living costs</small></div><div><span>Optional local sale quote</span><strong>${v.sales}g</strong><small>Owned, unequipped gear and ordinary loot</small></div></div><nav class="craft-filters" aria-label="Savings goal">${ECONOMY_GOALS.map(g=>`<button type="button" class="button secondary small ${g.id===v.goal.id?'active':''}" data-op="economy-goal" data-id="${g.id}" aria-pressed="${g.id===v.goal.id}">${e(g.name)}</button>`).join('')}</nav><h3>${e(v.goal.name)}</h3><p>${e(v.purpose)}</p><p>${v.fees} gold in remaining fees${v.committedGold?` (${v.committedGold} already committed)`:''} + ${v.materialCash} gold to buy ${e(inputs)} + about ${v.living} living costs over ${v.days} work days = <strong>${v.total} gold remaining</strong>.</p><p class="small-copy">${v.spendable} gold available after ${v.outstanding} already-accrued household costs. Savings gap ${v.gap} gold; selling the quoted belongings would reduce it to ${v.afterSaleGap}.${v.gap&&v.years!==null?` At the present ordinary-year surplus: about ${v.years} more years.`:v.gap?' This living plan has no surplus; extra work, trade or different priorities can fund the gap.':''} Gathering can replace purchases with actual work; travel, gathering days and future changes are outside this purchase forecast. Cooperative packs leave unused materials in your bag.</p>${v.annualMaintenance?`<p class="small-copy">Protected operation uses ${v.annualMaintenance} gold per funded year; this expense belongs to the institution’s reserve and is separate from your home’s upkeep.</p>`:''}<div class="quick-actions">${button('Find the Local Market','economy-merchant','','ghost small')}${button('Find a Craftsperson','place-open','','ghost small')}</div>${v.actionId?`<p class="small-copy">Use the community charter or saved milestone below to commit work. Selecting a savings goal spends nothing.</p>`:''}</details>`;
}

return {ECONOMY_GOALS,economyPlan,renderEconomyPlan};
})();
const __travel_ui = (() => {
const { renderTravelReference } = __status_reference;
const { travelEnergyView, campingActions } = __travel_energy;
const { getActions, getLifeCommitment } = __engine;
const { travelView, travelRouteOptions } = __travel;
const { ROAD_PREFERENCES, roadPreference } = __road_routes;
function renderRoadPlanPanel(s,ui,{destinationId=null}={}){
 if(!s.travel)return '';
 if(s.trail){const v=travelEnergyView(s);return `<section class="travel-energy-summary" data-travel-energy><strong>Focus ${s.hero.mp}/${s.hero.maxMp}</strong><p>${ui.e(v.summary)}</p><small>Travel and spells use the same Focus. Camp to recover; shelter packs have limited nights. No road preparations or departure fee.</small></section>`;}
 const {e}=ui,v=travelView(s),p=v.plan,selected=roadPreference(s.travel.routePreference),commit=getLifeCommitment(s);
 const locked=!!(s.event||s.battle||s.conversations?.pending||s.dungeon||commit||s.workshop?.project||s.careers?.batch||s.life?.plan||s.phase==='retired'||s.cartography?.offsite);
 const options=destinationId?travelRouteOptions(s,destinationId):null,place=id=>s.world.locations.find(p=>p.id===id)?.name||id;
 const routes=options?`<div class="road-route-options" role="group" aria-label="Compare open road routes">${options.map(({id,label,preview:q})=>`<label class="road-route-option ${id===selected?'selected':''}"><input type="radio" name="routePreference" value="${id}" ${id===selected?'checked':''}><span><strong>${e(label)}</strong><span>${q.days} days · ${q.cost}g departure preparations</span><span>${q.risk}% highest leg danger · ${q.exposure} exposure points across ${q.checks} check${q.checks===1?'':'s'}</span><small>${e(q.route.map(place).join(' → ')||'No open road')}</small></span></label>`).join('')}</div><p class="small-copy">Exposure points add the leg danger percentages. Each leg receives its own check; the total is not a whole-journey percentage. Routes can coincide where the roads offer the same best path.</p>`:`<label class="field">Route preference<select name="routePreference">${ROAD_PREFERENCES.map(([id,label])=>`<option value="${id}" ${id===selected?'selected':''}>${e(label)}</option>`).join('')}</select></label>`;
 const quote=options?.find(row=>row.id===selected)?.preview,notes=quote?`${ui.livingCosts?.(quote.days)||''}<details class="spatial-details" data-disclosure="saved-road-details"><summary>Saved route details and safeguards</summary>${quote.legs.map(leg=>`<p class="small-copy">${e(place(leg.from))} → ${e(place(leg.to))} · ${leg.totalDays} days · ${leg.risk}% danger check</p>`).join('')}${quote.precautions.map(copy=>`<p class="small-copy">${e(copy)}</p>`).join('')}</details>`:'';
 return `<section class="panel travel-plan" data-road-plan><div class="eyebrow">BEFORE DEPARTURE</div><h3>${destinationId?`Road preparations for ${e(place(destinationId))}`:'Prepare for the road'}</h3><p class="small-copy">${e(v.summary)}</p><form id="travel-plan-form"><fieldset ${locked?'disabled':''}>${routes}<label class="field">Travel pace<select name="pace">${[['steady','Steady'],['cautious','Cautious · longer, safer'],['fast','Fast · shorter, riskier']].map(([id,label])=>`<option value="${id}" ${p.pace===id?'selected':''}>${label}</option>`).join('')}</select></label><div class="travel-options">${[['supplies','Packed provisions','Paid departure supplies reduce danger; these are separate from dungeon rations.'],['scout','Scout the road','Two gold and one preparation day on the first leg.'],['escort','Hire an escort','Reduces danger; the fee follows the actual number of road legs.'],['night','Travel after dusk','Avoid daylight exposure, with slightly higher road danger.']].map(([key,label,copy])=>`<label><input type="checkbox" name="${key}" ${p[key]?'checked':''}><span><strong>${label}</strong><small>${copy}</small></span></label>`).join('')}</div><p class="small-copy" data-road-draft hidden role="status">Save these changes to refresh the route quotes before departing.</p><button class="button secondary" type="submit">Save preparations and refresh quotes</button></fieldset></form><p class="small-copy">${locked?'Finish the present decision or commitment before changing preparations.':'Saving spends no day or gold. The quotes and departure use your saved preparations.'}</p>${notes}</section>`;
}
function roadJourneyProgress(s){
 const j=s.timeline?.journey;if(!j)return null;
 const legs=j.route.slice(1).map((to,i)=>{const from=j.route[i],road=s.world.roads.find(r=>r.from===from&&r.to===to||r.from===to&&r.to===from);return {from,to,totalDays:j.legs?.[i]?.totalDays??road?.days??1,checked:j.legs?.[i]?.checked===true};});
 const total=legs.reduce((n,l)=>n+l.totalDays,0),completed=legs.reduce((n,l,i)=>n+(i<j.legIndex?l.totalDays:i===j.legIndex?j.legProgress:0),0);
 return {destinationId:j.destinationId,legs,total,completed,remaining:Math.max(0,total-completed),departureCost:j.departureCost??null,responseDays:s.travel?.pending?.stage==='delay'?s.travel.pending.remainingDays:0};
}
function renderRoadJourney(s,ui){
 const v=roadJourneyProgress(s);if(!v)return '';
 const {e,actionCards}=ui,j=s.timeline.journey,name=id=>s.world.locations.find(p=>p.id===id)?.name||id,actions=getActions(s).filter(a=>a.id==='grow_continue_journey'||a.id==='travel_continue_response'||a.id==='trail_camp');
 if(j.energyVersion===1){const energy=travelEnergyView(s);return `<section class="panel journey-panel" data-road-journey><span class="eyebrow">ON THE ROAD</span><h2>${e(name(v.destinationId))}</h2><p>${e(name(j.route[j.legIndex]))} → ${e(name(j.route[j.legIndex+1]))} · ${v.remaining} normal days of distance remain${j.energyStep?` · This stretch: ${j.energyStep.progress}/${j.energyStep.totalDays} days`:''}</p><p><strong>Focus ${energy.focus}/${energy.max}</strong> · ${energy.days} travel days since rest</p><p>${e(energy.summary)}</p>${energy.focus===0?'<p class="disabled-reason">Continuing exhausted can be fatal. Make camp before walking further.</p>':''}${renderTravelReference(s,ui,{legacy:false,days:null,fee:j.departureCost,paid:true,camp:actions.find(a=>a.id==='trail_camp'),key:'today-travel-reference'})}${actions.length?actionCards(actions):'<p>Resolve the current encounter, then continue or camp.</p>'}</section>`;}
 return `<section class="panel journey-panel" data-road-journey><div class="eyebrow">YOUR SAVED ROAD JOURNEY</div><h2>On the road to ${e(name(v.destinationId))}</h2><p>${v.completed}/${v.total} planned road days completed · ${v.remaining} remain.${v.responseDays?` Another ${v.responseDays} attended response day remains.`:''}${v.departureCost!==null?` ${v.departureCost} gold already committed.`:''}</p><div class="saved-road-legs">${v.legs.map((l,i)=>`<p><strong>${e(name(l.from))} → ${e(name(l.to))}</strong><span>${i<j.legIndex?'Complete':i===j.legIndex?`${j.legProgress}/${l.totalDays} days`:`${l.totalDays} days`}${l.checked?' · encounter checked':''}</span></p>`).join('')}</div>${renderTravelReference(s,ui,{legacy:true,days:v.remaining+v.responseDays,fee:j.departureCost,paid:true,camp:actions.find(a=>a.id==='trail_camp'),key:'today-travel-reference'})}<p class="small-copy">Responses and calendar needs keep their own time. Continuing uses the saved route, attended days and departure payment.</p>${actions.length?actionCards(actions):'<p class="small-copy">Finish the present road or calendar decision here, then continue this same journey.</p>'}</section>`;
}

return {renderRoadJourney,renderRoadPlanPanel,roadJourneyProgress};
})();
const __radiant_ui = (() => {
const { radiantView } = __radiant_descent;
const { renderSpatialCommit } = __spatial_controls;
function renderRadiantPanel(s,ui) {
  const {e,selectedDungeonRoom=null}=ui;
  const v=radiantView(s);if(!v)return '';
  const ids=new Set(v.rooms.map(r=>r.id)),position=r=>[60+r.x*145,52+r.y*125];
  const lines=v.rooms.flatMap(r=>r.visited?r.neighbors.filter(id=>ids.has(id)&&(r.id<id||!v.rooms.find(n=>n.id===id).visited)).map(id=>{const a=position(r),b=position(v.rooms.find(n=>n.id===id));return `<path d="M${a.join(' ')}L${b.join(' ')}"/>`;}):[]).join('');
  const selected=v.rooms.find(r=>'radiant_'+r.id===selectedDungeonRoom);
  const label=(text,x,y)=>{const rows=[];for(const word of text.split(/\s+/)){if(rows.length&&rows.at(-1).length+word.length<22)rows[rows.length-1]+=' '+word;else rows.push(word);}return `<text x="${x}" y="${y+31}" text-anchor="middle">${rows.map((row,i)=>`<tspan x="${x}" dy="${i?12:0}">${e(row)}</tspan>`).join('')}</text>`;};
  const nodes=v.rooms.map(r=>{const [x,y]=position(r);return `<g class="radiant-room ${r.id===v.current?'current':''} ${r.resolved?'resolved':''} ${selected?.id===r.id?'selected':''}" data-op="dungeon-select" data-id="radiant_${r.id}" role="button" tabindex="0" aria-pressed="${(selected?.id??v.current)===r.id}" aria-describedby="spatial-map-help" aria-label="${e(r.label+(r.id===v.current?' · current room':''))}"><circle cx="${x}" cy="${y}" r="18"/><text x="${x}" y="${y+5}" text-anchor="middle">${r.id===v.current?'YOU':r.resolved?'✓':r.visited?'◇':'?'}</text>${label(r.label,x,y)}</g>`;}).join('');
  return `<section class="panel radiant-chart" data-radiant-chart><div class="section-heading"><div><span class="eyebrow">A RECORDED DESCENT</span><h2>Floor ${v.floor} · the routes you can see</h2></div><span class="badge">${v.provisions} rations</span></div><div class="radiant-purpose"><strong>${e(v.goal.title)}</strong><p class="small-copy">${e(v.goal.description)} Lead: floor ${v.goal.floor}. ${v.completed?'Completed proof is ready to bring outside.':`Completed proof pays ${v.goal.gold} gold and ${v.goal.exp} field experience on return.`}</p></div><div class="radiant-map-scroll"><svg viewBox="0 0 565 375" role="group" aria-label="Discovered descent routes"><rect width="565" height="375" fill="#b6b0a2"/><image href=__offlineMedia["media-706"] width="565" height="375" opacity=".15"/><g class="radiant-edges">${lines}</g>${nodes}</svg></div><p id="spatial-map-help" class="small-copy">Click, Enter or Space to inspect. Choose Confirm to move, or double click an available neighboring doorway. Unseen rooms keep their contents hidden.</p>${selected?`<h2 id="spatial-selection-title" data-radiant-selection aria-describedby="spatial-selection-details">${e(selected.label)}</h2>${renderSpatialCommit(s,'dungeon',selectedDungeonRoom,[],ui)}`:''}<p class="small-copy">Provisions used: ${v.provisionsUsed}. A new lower floor, camp or peaceful field agreement costs 1 ration and one actual day. Previously provisioned floors cost no second ration; returning outside is free.</p></section>`;
}

return {renderRadiantPanel};
})();
const __quest_journal = (() => {
const { renderResearchArchive } = __research_ui;
const { renderOriginInvitation, renderOriginArchive, renderOriginActive } = __family_origin_ui;
const { campaignView } = __campaign;
const { storyView } = __life_stories;
const { adventureView, contractArchive } = __adventuring;
const { questEntryStatus } = __quest_policy;
const { trackedQuest, questReturnForecast } = __quest_records;
const short=text=>String(text||'').split(/(?<=[.!?])\s+/).slice(0,2).join(' ');
function renderQuestJournal(s,actions,ui,{category='main',invitations='preview',archiveQuery=''}={}) {
  const {e,button,actionCards}=ui,c=campaignView(s),stories=storyView(s),j=s.questLog;
  const status=j?.main||(s.campaign?.completed.length?'active':'offered');
  const categories=[['main','Main quests'],['side','Side quests'],['misc','Miscellaneous quests'],['radiant','Repeatable radiant quests'],['archive','Archive']];
  const nav=`<nav class="quest-categories" aria-label="Quest categories">${categories.map(([id,label])=>button(label,'quest-category',id,`ghost ${category===id?'active':''}`,false,category===id)).join('')}</nav>`;
  const command=(id,label)=>{
    const a=actions.find(a=>a.id===id);if(!a)return '';
    const days=a.durationDays??a.days??0,fee=a.quotedCost??a.cost??0;
    return `<div class="quest-command">${button(label||e(a.label),'activity',id,'secondary small',Boolean(a.disabledReason))}<small class="small-copy" data-quest-cost="${e(id)}">${days?`${days} committed ${days===1?'day':'days'}`:'No time'} · ${fee} gold fee</small>${ui.livingCosts?.(days)||''}${id.startsWith('quest_')?'<small class="small-copy">Road travel and later choices are quoted separately.</small>':''}${a.disabledReason?`<small class="disabled-reason">${e(a.disabledReason)}</small>`:''}</div>`;
  };
  const trail=arc=>`<details class="panel" data-story-record="${e(arc.id)}"><summary>${e(arc.title)} · ${e(arc.status)} · ${arc.chapter}/${arc.totalChapters} chapters</summary><p>${e(arc.personName)} · ${e(s.world.locations.find(p=>p.id===arc.locationId)?.name)} · began at age ${arc.startedAge}</p><ol class="decision-trail">${arc.choices.map((choice,index)=>`<li data-story-decision="${index+1}"><strong>Chapter ${index+1}: ${e(choice.label)}</strong><p>${e(choice.outcome)}</p><small>Day ${choice.day} · ${choice.days} committed days · ${choice.cost} gold fee · ${choice.reward} gold reward</small>${choice.consequences?`<p class="small-copy">Participant trust ${choice.consequences.bond>=0?'+':''}${choice.consequences.bond} · Local standing ${choice.consequences.standing>=0?'+':''}${choice.consequences.standing} · Professional reputation ${choice.consequences.career>=0?'+':''}${choice.consequences.career}</p>`:''}</li>`).join('')||'<li>No completed chapter decision was recorded.</li>'}</ol></details>`;
  const main=c.quests.find(q=>!q.id.startsWith('side_')&&!['completed','locked'].includes(q.status));
  let body='';
  if(category==='main')body=`<article class="panel quest-card"><div class="quest-status"><span class="badge">Main · long quest</span><span>${e(c.ending?'Completed':s.phase==='retired'&&status==='active'?'Left unfinished':status)}</span></div><h2>The Ashfall Covenant</h2><p>Trace the failing village water to an old bargain beneath the region. This optional investigation unfolds across your life.</p>${s.age<16?'<p class="muted">Childhood clues belong in your memories. Investigation opens at sixteen.</p>':c.ending?`<h3>${e(c.ending.title)}</h3><p>${e(c.ending.summary)}</p>`:status==='active'&&main?`<div class="quest-objective"><strong>Next: ${e(main.title)}</strong><p>${e(main.objective)}</p></div>${command('quest_begin_'+main.id,'Continue this objective')}${command('quest_resume_expedition','Resume expedition')}${button('Show destination','quest-location',main.locationId,'ghost small')}${command('journal_main_pause','Pause quest')}${command('journal_track_main','Track')}`:`<p class="small-copy">${status==='offered'?'A lead you may choose to follow. It has not been accepted.':'You have set this investigation aside. No unseen deadline advances it.'}</p>${command('journal_main_accept',status==='offered'?'Accept quest':'Resume quest')}${command('journal_main_decline','Decline for now')}`}${c.completedCount?`<small>${c.completedCount} objectives completed</small>`:''}</article>`;
  else if(category==='side') {
    const sides=c.quests.filter(q=>q.id.startsWith('side_')&&!['locked','completed'].includes(q.status));
    body=[['active','Accepted'],['offered','Nearby offers'],['paused','Set aside'],['declined','Declined']].map(([id,label])=>{
      const list=sides.filter(q=>questEntryStatus(s,q.id)===id);
      return list.length?`<section><h3>${label}</h3><div class="quest-grid">${list.map(q=>`<article class="panel quest-card"><span class="badge">Side quest · ${id}</span><h3>${e(q.title)}</h3><p>${e(short(q.description))}</p>${id==='active'?`<div class="quest-objective">${e(q.objective)}</div>${command('quest_'+q.id,'Continue quest')}${command('journal_pause_'+q.id,'Pause')}${command('journal_track_'+q.id,'Track')}${button('Show destination','quest-location',q.locationId,'ghost small')}`:`${command('journal_accept_'+q.id,id==='offered'?'Accept quest':'Resume quest')}${id==='offered'?command('journal_decline_'+q.id,'Decline'):''}`}</article>`).join('')}</div></section>`:'';
    }).join('');
    const offers=stories?.invitations||[],available=offers.filter(a=>a.status==='offered'),declined=offers.filter(a=>a.status==='declined');
    const shown=invitations==='all'?offers:invitations==='declined'?declined:available.slice(0,2);
    if(offers.length)body+=`<details class="panel" ${invitations!=='preview'?'open':''} data-personal-invitations data-disclosure="quest-personal-invitations"><summary>Personal stories · ${available.length} invitations${declined.length?` · ${declined.length} declined`:''}</summary><p class="small-copy">Short, optional stories. Reading this list accepts nothing. Accepting opens a proposal; you choose the days and fees afterward.</p><nav class="record-tabs" aria-label="Personal invitations">${button(`Browse all ${offers.length}`,'quest-invitations','all','ghost small',false,invitations==='all')}${button('Compact preview','quest-invitations','preview','ghost small',false,invitations==='preview')}${declined.length?button('Declined invitations','quest-invitations','declined','ghost small',false,invitations==='declined'):''}</nav><div class="quest-grid">${shown.map(offer=>`<article class="quest-card" data-invitation="${e(offer.id)}"><h3>${e(offer.title)}</h3><p><strong>${e(offer.personName)}</strong> · ${e(offer.locationName)}</p><p>${e(offer.premise)}</p>${offer.status==='declined'?`<span class="badge">Declined · never accepted</span>${command('stories_reconsider_'+offer.id,'Reconsider invitation')}`:`${command('stories_open_'+offer.id,'Accept first chapter')}${command('stories_decline_'+offer.id,'Decline invitation')}`}</article>`).join('')||'<p>No invitations in this view.</p>'}</div></details>`;
    const accepted=stories?.arcs.filter(a=>['active','paused'].includes(a.status))||[];
    if(accepted.length)body+=`<section class="panel"><h3>Stories you chose</h3>${accepted.map(arc=>`<article class="quest-card"><h3>${e(arc.title)}</h3><p>${e(arc.personName)} · ${arc.chapter}/${arc.totalChapters} chapters · ${arc.status==='paused'?'Paused':s.age<arc.nextAge?'Returns at age '+arc.nextAge:'Next chapter ready'}</p>${command('stories_open_'+arc.id,'Continue story')}${command('journal_'+(arc.status==='paused'?'resume':'pause')+'_story:'+arc.id,arc.status==='paused'?'Resume story':'Pause story')}${command('journal_track_story:'+arc.id,'Track')}${button('Show destination','quest-location',arc.locationId,'ghost small')}${trail(arc)}</article>`).join('')}${actionCards(actions.filter(a=>['stories_continue','stories_cancel'].includes(a.id)))}</section>`;
    body+=renderOriginInvitation(s,actions,ui)+renderOriginActive(s,actions,ui);
