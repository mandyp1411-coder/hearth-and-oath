 let offers=serviceMeetingOffers(r,actions);
 const commissions=r.kind==='work'?offers.filter(a=>a.id.startsWith('career_accept_')&&!a.disabledReason):[];
 offers=offers.filter(a=>!a.id.startsWith('career_accept_'));
