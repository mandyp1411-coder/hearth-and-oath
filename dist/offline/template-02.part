 return `<div class="depth-dungeon exploration-workspace"><section class="depth-dungeon-map"><div class="section-heading"><div><span class="eyebrow">THE DESCENT</span><h2>${e(x.title)}</h2></div><span class="badge">${x.rooms.filter(r=>r.visited).length}/${x.rooms.length} rooms</span></div><svg viewBox="0 0 ${mapWidth} ${mapHeight}" role="group" aria-label="Discovered dungeon rooms"><rect width="${mapWidth}" height="${mapHeight}" fill="#b6b0a2"/><image href=__offlineMedia["media-706"] width="${mapWidth}" height="${mapHeight}" opacity=".16"/><g fill="none" stroke="#55524b" stroke-width="2">${edges}</g><g fill="#d2cabb" stroke="#55524b">${nodes}</g></svg><p id="spatial-map-help" class="small-copy">Click, Enter or Space to inspect. Choose Confirm to move, or double click an available neighboring room. The chart keeps unknown rooms unnamed. Side stores, records and resolved hazards persist when you leave.</p></section><aside class="panel depth-dungeon-actions">${renderAreaScene(s,ui,{dungeon:{room:{title:current.title}}})}${ui.selectedDungeonRoom?`<h2 id="spatial-selection-title" aria-describedby="spatial-selection-details">${e(known.find(r=>r.id===ui.selectedDungeonRoom)?.visited?known.find(r=>r.id===ui.selectedDungeonRoom).title:known.find(r=>r.id===ui.selectedDungeonRoom)?passageDirection(s.seed,x.id,current,known.find(r=>r.id===ui.selectedDungeonRoom)):'No visible doorway')}</h2>${known.some(r=>r.id===ui.selectedDungeonRoom)?renderSpatialCommit(s,'rpg',ui.selectedDungeonRoom,v.actions,ui):''}`:''}<h2>${e(current.title)}</h2>${actionCards(v.actions)}${x.completed?'<p>The completed service remains in the world.</p>':''}</aside></div>`;
}
