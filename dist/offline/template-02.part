const __content_dialogue = (() => {
// Generated by scripts/content/compile.mjs from the content tree (2 dialogues). Do not edit; edit the JSON and compile.
const freeze = v => { if (v && typeof v === 'object') { for (const k of Object.keys(v)) freeze(v[k]); Object.freeze(v); } return v; };
