/** Explore is a carried map and one destination. Local life opens inside a place. */
function renderExplorationWorkspace(state,{selectedKey=null,selectedPlace=null}={},ui){
 const {e,button}=ui,v=cartographyView(state);if(!v)return '';
 const actions=getActions(state),j=exploreJourneyView(state),legacySelected=v.cells.find(c=>c.key===selectedKey)?.siteId;
