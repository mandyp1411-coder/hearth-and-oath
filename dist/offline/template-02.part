const __starting_attributes = (() => {
const STARTING_ATTRIBUTES=['strength','agility','vitality','intellect','willpower','presence'];
const ATTRIBUTE_LABELS={strength:'Strength',agility:'Agility',vitality:'Vitality',intellect:'Intellect',willpower:'Willpower',presence:'Presence'};
function attributePointBudget(age=0){return Math.min(18,Math.floor(Math.max(0,Math.min(80,Number(age)||0))/3));}
function normalizeAttributePoints(value,age=0){
 let remaining=attributePointBudget(age);const points={};
 for(const key of STARTING_ATTRIBUTES){const n=Number(value?.[key]);points[key]=Number.isSafeInteger(n)?Math.max(0,Math.min(6,remaining,n)):0;remaining-=points[key];}
 return points;
}
function attributePointsSpent(points){return STARTING_ATTRIBUTES.reduce((sum,key)=>sum+(points?.[key]||0),0);}
/** Only new lives draw unspent points. Loading a recorded life never rerolls it. */
function completeAttributePoints(value,age,seed){
 const points=normalizeAttributePoints(value,age),remaining=attributePointBudget(age)-attributePointsSpent(points);
 for(let i=0;i<remaining;i++){const eligible=STARTING_ATTRIBUTES.filter(key=>points[key]<6);if(!eligible.length)break;points[eligible[seededRoll(seed,`creation:unspent:${age}:${i}`,eligible.length)]]++;}
 return points;
}
function applyStartingAttributes(state,points,age=state.age){
 if(state.hero.startingAttributes)return false;
 const selected=normalizeAttributePoints(points,age);
 for(const key of STARTING_ATTRIBUTES)state.hero.attributes[key]+=selected[key];
 state.hero.maxHp+=selected.vitality*3;state.hero.hp=Math.min(state.hero.maxHp,state.hero.hp+selected.vitality*3);
 state.hero.maxMp+=selected.intellect*3;state.hero.mp=Math.min(state.hero.maxMp,state.hero.mp+selected.intellect*3);
 state.hero.startingAttributes={version:1,age,points:selected};return true;
}
function validateStartingAttributes(value,state){
 if(value===undefined)return true;
 if(!value||typeof value!=='object'||Array.isArray(value)||value.version!==1||!Number.isInteger(value.age)||value.age<0||value.age>80||value.age>state.age)return false;
 if(!value.points||typeof value.points!=='object'||Array.isArray(value.points)||Object.keys(value.points).length!==6)return false;
 return STARTING_ATTRIBUTES.every(key=>Number.isSafeInteger(value.points[key])&&value.points[key]>=0&&value.points[key]<=6)&&attributePointsSpent(value.points)<=attributePointBudget(value.age);
}
const { seededRoll } = __world;
return {ATTRIBUTE_LABELS,STARTING_ATTRIBUTES,applyStartingAttributes,attributePointBudget,attributePointsSpent,completeAttributePoints,normalizeAttributePoints,validateStartingAttributes};
})();
const __runestone_ui = (() => {
const symbols=['✦','☽','♜','♞','◇','♧'];
const names=['Star','Moon','Tower','Knight','Diamond','Clover'];
/** Only visible faces contribute names. Hidden stones never expose their face. */
function runestoneLabel(game,index){
 const shown=game.matched.includes(index)||game.revealed.includes(index);
 return `Stone ${index+1}${shown?' · '+names[game.faces[index]]:''}${game.matched.includes(index)?' · Matched':''}`;
}
/** Continue after the activated position, wrapping once over enabled stones. */
function nextRunestone(game,after=-1){
 if(!game||game.matched.length===12)return null;
 for(let offset=1;offset<=12;offset++){const i=(after+offset+12)%12;if(!game.matched.includes(i)&&!game.revealed.includes(i))return i;}
 return null;
}
function runestoneStatus(game){
 if(!game)return 'Game finished. Open another game on a later day.';
 if(game.matched.length===12)return 'All six pairs found. Finish the game to spend one day and claim its benefits.';
 const faces=game.revealed.map(i=>`Stone ${i+1}: ${names[game.faces[i]]}`).join('. ');
 return `${game.matched.length/2} of 6 pairs. ${game.moves} turns.${faces?' '+faces+'.':''}${game.revealed.length===2?' No match. The next turn closes these stones.':''}`;
}
function renderRunestones(s,ui,actions){
 const game=s.socialLife?.game;if(!game)return '';
 const {e,button}=ui,finished=game.matched.length===12,finish=actions.find(a=>a.id==='fun_pairs_finish');
 return `<section class="runestone-game" aria-labelledby="runestone-title"><h3 id="runestone-title" tabindex="-1">Runestone Pairs</h3><p id="runestone-status" tabindex="-1" role="status" aria-live="polite">${e(runestoneStatus(game))}</p><p class="small-copy">Turning stones is free. Focus moves to the next available stone, wrapping to the beginning.</p><div class="runestone-board" role="group" aria-label="Twelve runestones">${game.faces.map((face,i)=>{const shown=game.matched.includes(i)||game.revealed.includes(i);return `<button type="button" class="runestone${shown?' revealed':''}" data-op="activity" data-id="fun_pair_${i}" aria-label="${e(runestoneLabel(game,i))}"${shown?' disabled':''}>${shown?symbols[face]:'?'}</button>`;}).join('')}</div>${finished?`<div class="runestone-completion" aria-labelledby="runestone-complete"><h4 id="runestone-complete">Six pairs found</h4><p>1 day · No entry fee · Up to +8 Joy and −6 Stress. Daily living costs and other daily changes still apply.</p>${button('Finish the Game','activity','fun_pairs_finish','primary',!finish||!!finish.disabledReason)}${finish?.disabledReason?`<p>${e(finish.disabledReason)}</p>`:''}<p class="small-copy">Your solved board stays here until you finish. The last flip spends no time.</p></div>`:''}</section>`;
}

return {nextRunestone,renderRunestones,runestoneLabel,runestoneStatus};
})();
const __identity_labels = (() => {
// Interface labels only. Saved values and narrative pronoun grammar stay exact.
const PRONOUN_LABELS = Object.freeze({
  'he/him': 'He/Him',
  'she/her': 'She/Her',
  'they/them': 'They/Them',
});
function pronounDisplayLabel(value) {
  if (Object.hasOwn(PRONOUN_LABELS, value)) return PRONOUN_LABELS[value];
