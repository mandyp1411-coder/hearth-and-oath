const CRAFT_SKILL = Object.freeze({ blacksmith: 'defense', merchant: 'persuasion', miner: 'survival' });
const GUILD_NAME = Object.freeze({ blacksmith: 'the smiths’ guild', merchant: 'the merchants’ guild', miner: 'the miners’ guild' });
