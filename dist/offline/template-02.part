const __dialogue_ui_v22 = (() => {
const { roleTitle } = __interaction_ui_v40;
const { settlementServices } = __world_services;
const { storyInvitations, storyView } = __life_stories;
const { groundedQuest } = __grounded_narrative_content;
const { getContacts, getThread, rememberedContacts } = __conversations;
const { getActions } = __engine;
